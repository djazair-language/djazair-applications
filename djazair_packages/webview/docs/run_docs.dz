# run_docs.dz
# Standalone desktop runner for Djazair WebView Interactive Documentation
# Author: Harizi Riyadh (hariziriyadh@gmail.com)
# Copyright (c) 2026 Djazair Language Project

use webview

let app = webview.createWindow({
    "title": "Djazair WebView - Official Documentation and API Reference",
    "width": 1240,
    "height": 820,
    "minWidth": 800,
    "minHeight": 600,
    "center": True,
    "darkTitleBar": True,
    "debug": True,
    "singleInstance": True,
    "appId": "com.djazair.webview.docs"
})

app.onReady(fn()
    app.window.navigate("index.html")
end)

app.run()
