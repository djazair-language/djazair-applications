import "../bridge/bridge.dz" as *
import "../window/window.dz" as *
import "../utils/utils.dz" as *

use json as *

let _native = __native("_webview")

# =============================================================================
# Class: App
# =============================================================================
# Coordinates the desktop application process, manages single-instance mutexes,
# handles the primary and secondary window lifecycle, bridges JavaScript IPC,
# and controls the native platform message loop.
class App

    # Initializes the application instance and creates the default primary window.
    #
    # @param  options {Map} Configuration dictionary:
    #                       - "title":          {String}  Window title (default: "Djazair App")
    #                       - "width":          {Number}  Initial width in pixels (default: 1024)
    #                       - "height":         {Number}  Initial height in pixels (default: 768)
    #                       - "x":              {Number}  Horizontal coordinate or -1 for OS default (default: -1)
    #                       - "y":              {Number}  Vertical coordinate or -1 for OS default (default: -1)
    #                       - "resizable":      {Bool}    Allow user resizing (default: True)
    #                       - "frameless":      {Bool}    Borderless/custom chrome (default: False)
    #                       - "minWidth":       {Number}  Minimum width limit (default: 400)
    #                       - "minHeight":      {Number}  Minimum height limit (default: 300)
    #                       - "maxWidth":       {Number}  Maximum width limit; 0 for unconstrained (default: 0)
    #                       - "maxHeight":      {Number}  Maximum height limit; 0 for unconstrained (default: 0)
    #                       - "closable":       {Bool}    Enable standard close button (default: True)
    #                       - "virtualHostDir": {String}  Virtual host directory for web assets (default: "")
    #                       - "debug":          {Bool}    Enable DevTools & console logs (default: False)
    #                       - "singleInstance": {Bool}    Enforce single app instance (default: False)
    #                       - "appId":          {String}  Unique identifier mutex key; falls back to title (default: "")
    init(options = {})
        let defaults = {
            "title": "Djazair App",
            "width": 1024,
            "height": 768,
            "x": -1, "y": -1,
            "resizable": True,
            "frameless": False,
            "minWidth": 400,
            "minHeight": 300,
            "maxWidth": 0,
            "maxHeight": 0,
            "closable": True,
            "virtualHostDir": "",
            "debug": False,
            "singleInstance": False,
            "appId": ""
        }

        for key in defaults.keys()
            if options.has(key)
                defaults[key] = options[key]
            end
        end

        self._onReady = Null
        self._onQuit = Null
        self._errorCallback = Null
        self._quitting = False
        self._debug = defaults["debug"]
        self._windows = []

        if self._debug
            setLogLevel("debug")
        else
            setLogLevel("warn")
        end

        # Handle Single Instance Lock
        let singleInstance = defaults["singleInstance"]
        let appId = defaults["appId"]
        if appId == ""
            appId = defaults["title"]
        end

        if singleInstance
            let hasLock = _native.appRequestSingleInstanceLock(appId)
            if !hasLock
                sysLog("App", "Another instance of '${appId}' is already running. Restoring focus and quitting.", "warn")
                _native.appFocusExistingInstance(defaults["title"])
                self._quitting = True
                self.window = Null
                return
            end
        end

        sysLog("App", "Initializing primary window...")
        let win = new Window(self, defaults)
        self.window = win
        self._windows.append(win)

        sysLog("App", "Attaching IPC bridge to primary window...")
        self.bridge = new Bridge(self, win)
        win.bridge = self.bridge

        # Built-in handler for frameless window dragging from frontend
        self.bridge.on("__djazair_start_drag", fn(_)
            win.startDragging()
            return True
        end)

        # Built-in handler for closing the window from frontend
        self.bridge.on("win_close", fn(_)
            win.close()
            return True
        end)

        if self._debug
            sysLog("App", "Debug mode enabled, configuring DevTools and console logger...")
            win.initJs(readWebviewAsset("debug_console.js"))
            # In debug mode: capture all JS console levels (log, info, warn, error)
            self.bridge.on("__console", fn(args)
                let typeStr = args[0]
                let msg = args[1]
                let lvl = "info"
                if typeStr == "error"
                    lvl = "error"
                elif typeStr == "warn"
                    lvl = "warn"
                elif typeStr == "log"
                    lvl = "debug"
                elif typeStr == "info"
                    lvl = "info"
                end
                sysLog("Webview", msg, lvl)
            end)
            win.openDevTools()
        else
            # Fix #11: In production mode, still inject debug_console.js so that
            # console.error() and console.warn() calls from bridge_client.js
            # (unhandled rejections, listener errors, uncaught exceptions) are
            # forwarded to the Djazair terminal at error/warn level.
            win.initJs(readWebviewAsset("debug_console.js"))
            self.bridge.on("__console", fn(args)
                let typeStr = args[0]
                let msg = args[1]
                # In production: only surface error and warn — suppress log/info noise
                if typeStr == "error"
                    sysLog("Webview", msg, "error")
                elif typeStr == "warn"
                    sysLog("Webview", msg, "warn")
                end
            end)
        end

        sysLog("App", "Application initialized successfully.")
    end

    # Creates and registers a new additional window managed by this application.
    # Automatically attaches an IPC Bridge and forwards console diagnostics.
    #
    # @param  options {Map} Window configuration options using the same recognized keys as init (default: {})
    # @return {Window} The newly created additional window instance with .bridge attached
    createWindow(options = {})
        sysLog("App", "Spawning new window...")
        let win = new Window(self, options)
        self._windows.append(win)

        sysLog("App", "Attaching IPC bridge to window...")
        let bridge = new Bridge(self, win)
        win.bridge = bridge

        # Built-in handler for frameless window dragging from frontend
        bridge.on("__djazair_start_drag", fn(_)
            win.startDragging()
            return True
        end)

        # Built-in handler for closing the window from its own frontend
        bridge.on("win_close", fn(_)
            win.close()
            return True
        end)

        if win._debug
            win.initJs(readWebviewAsset("debug_console.js"))
            bridge.on("__console", fn(args)
                let typeStr = args[0]
                let msg = args[1]
                let lvl = "info"
                if typeStr == "error"
                    lvl = "error"
                elif typeStr == "warn"
                    lvl = "warn"
                elif typeStr == "log"
                    lvl = "debug"
                elif typeStr == "info"
                    lvl = "info"
                end
                sysLog("Webview", msg, lvl)
            end)
            win.openDevTools()
        else
            win.initJs(readWebviewAsset("debug_console.js"))
            bridge.on("__console", fn(args)
                let typeStr = args[0]
                let msg = args[1]
                if typeStr == "error"
                    sysLog("Webview", msg, "error")
                elif typeStr == "warn"
                    sysLog("Webview", msg, "warn")
                end
            end)
        end

        return win
    end

    # Internal hook invoked when an individual window is closed.
    #
    # @param  win {Window} The window instance that was closed
    _onWindowClosed(win)
        let idx = -1
        for i in 0..self._windows.length()
            if self._windows[i] == win
                idx = i
                break
            end
        end

        if idx != -1
            self._windows.pop(idx)
        end

        sysLog("App", "Window closed. Remaining active windows: ${self._windows.length()}", "debug")

        # Automatically terminate application when last window closes
        if self._windows.length() == 0 and !self._quitting
            self.quit()
        end
    end

    # Starts the application event loop.
    run()
        if self._quitting return end
        sysLog("App", "Running application event loop.")
        if !isNull(self._onReady)
            # Fix #7: guard onReady just like onQuit — an uncaught error here
            # previously crashed the entire app before the event loop started
            try
                self._onReady()
            catch err
                sysLog("App", "Error in onReady handler: ${err}", "error")
            end
        end
        _native.appRun()
    end

    # Gracefully terminates the application and closes all windows.
    quit()
        if self._quitting return end
        sysLog("App", "Quitting application...")
        self._quitting = True

        if !isNull(self._onQuit)
            try
                self._onQuit()
            catch err
                sysLog("App", "Error in onQuit handler: ${err}", "error")
            end
        end

        _native.appQuit()
    end

    # Closes the primary window.
    close()
        sysLog("App", "Closing primary application window...")
        if !isNull(self.window)
            self.window.close()
        end
    end

    # Checks if the primary window is valid and open.
    #
    # @return {Bool} True if the primary window is valid and open
    isValid()
        return !isNull(self.window) and self.window.isValid()
    end

    # Registers a callback to execute right before the event loop starts.
    #
    # @param  cb {Function} Callback invoked right before the event loop starts
    onReady(cb)
        self._onReady = cb
    end

    # Registers a callback to execute before application termination.
    #
    # @param  cb {Function} Callback invoked before application termination
    onQuit(cb)
        self._onQuit = cb
    end

    # Registers a global error callback.
    #
    # @param  cb {Function} Callback invoked with framework error messages
    onError(cb)
        self._errorCallback = cb
    end

    # Enables or disables runtime debug mode.
    #
    # @param  enable {Bool} True to enable debug mode and DevTools, False to disable
    setDebug(enable)
        self._debug = enable
        if enable
            setLogLevel("debug")
            sysLog("App", "Debug mode set to: True")
            if !isNull(self.window)
                self.window.openDevTools()
            end
        else
            setLogLevel("warn")
            sysLog("App", "Debug mode set to: False")
        end
    end

    # Requests a single-instance application lock via named mutex.
    #
    # @param  appId {String} Unique application identifier used as the mutex key
    # @return {Bool} True if this process successfully acquired the lock
    requestSingleInstanceLock(appId)
        return _native.appRequestSingleInstanceLock(appId)
    end

    # Finds and brings to foreground an existing instance of the application window.
    #
    # @param  title {String} Window title or identifier of the existing instance
    # @return {Bool} True if an existing instance was found and focused
    focusExistingInstance(title)
        return _native.appFocusExistingInstance(title)
    end
end
