let _native = __native("_webview")

# =============================================================================
# Class: Menu
# =============================================================================
# Encapsulates a native Win32/macOS/Linux context or popup menu.
# Supports hierarchical submenus, click handlers, and cursor popup placement.
class Menu
    # Constructs a new popup menu instance.
    #
    # @param label {String} Optional root label for submenus (default: "")
    init(label = "")
        self.label = label
        self._handle = _native.menuCreate(label)
        self._items = []
    end

    # Appends an interactive menu item with an optional action callback.
    #
    # @param label    {String}   Text label displayed on the menu item
    # @param callback {Function} Action callback executed upon user click
    # @return         {Void}
    addItem(label, callback = Null)
        _native.menuAddItem(self._handle, label, callback)
        self._items.append(label)
    end

    # Appends a visual horizontal divider line to the menu.
    #
    # @return {Void}
    addSeparator()
        _native.menuAddSeparator(self._handle)
        self._items.append("---")
    end

    # Creates and attaches a nested submenu to this menu.
    #
    # @param  label {String} Submenu display text
    # @return       {Menu}   The newly created child submenu instance
    addSubmenu(label)
        let subHandle = _native.menuCreateSubmenu(self._handle, label)
        let subMenu = new Menu(label)
        subMenu._handle = subHandle
        return subMenu
    end

    # Displays the popup menu at current mouse cursor coordinates over a window.
    #
    # @param  win {Window|Integer} Parent window instance or native handle
    # @return     {Void}
    popup(win)
        let winId = win
        if type(win) == "Instance" and !isNull(win._handle)
            winId = win._handle
        end
        _native.menuPopup(winId, self._handle)
    end
end

# -----------------------------------------------------------------------------
# Backward-Compatible Procedural Menu API
# -----------------------------------------------------------------------------


fn menuCreate(label = "")
    return _native.menuCreate(label)
end

fn menuAddItem(menu, label, callback)
    let menuId = menu
    if type(menu) == "Instance" and !isNull(menu._handle)
        menuId = menu._handle
    end
    _native.menuAddItem(menuId, label, callback)
end

fn menuAddSeparator(menu)
    let menuId = menu
    if type(menu) == "Instance" and !isNull(menu._handle)
        menuId = menu._handle
    end
    _native.menuAddSeparator(menuId)
end

fn menuCreateSubmenu(menu, label)
    let menuId = menu
    if type(menu) == "Instance" and !isNull(menu._handle)
        menuId = menu._handle
    end
    return _native.menuCreateSubmenu(menuId, label)
end

fn menuSetCallback(menu, index, callback)
    let menuId = menu
    if type(menu) == "Instance" and !isNull(menu._handle)
        menuId = menu._handle
    end
    _native.menuSetCallback(menuId, index, callback)
end

fn menuPopup(handle, menu)
    let winId = handle
    if type(handle) == "Instance" and !isNull(handle._handle)
        winId = handle._handle
    end
    let menuId = menu
    if type(menu) == "Instance" and !isNull(menu._handle)
        menuId = menu._handle
    end
    _native.menuPopup(winId, menuId)
end
