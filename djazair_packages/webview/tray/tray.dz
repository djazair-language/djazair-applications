let _native = __native("_webview")

# =============================================================================
# Class: Tray
# =============================================================================
# Manages an interactive application icon inside the operating system's taskbar
# notification area (system tray). Supports context menus, tooltip changes,
# dynamic icon swapping, and notification balloons.
class Tray
    # Creates and registers a new system tray icon.
    #
    # @param tooltip  {String} Hover tooltip text displayed to user (default: "")
    # @param iconPath {String} Path to the .ico/.png image file (default: "")
    init(tooltip = "", iconPath = "")
        self.tooltip = tooltip
        self.iconPath = iconPath
        self._handle = _native.trayCreate(tooltip, iconPath)
    end

    # Updates the icon image displayed in the system tray.
    #
    # @param  iconPath {String} Absolute or relative path to the new icon image
    # @return          {Void}
    setIcon(iconPath)
        self.iconPath = iconPath
        if !isNull(self._handle)
            _native.traySetIcon(self._handle, iconPath)
        end
    end

    # Attaches a popup context menu to be triggered upon right-clicking the tray icon.
    #
    # @param  menu {Menu|Integer} Menu class instance or native menu handle
    # @return      {Void}
    setMenu(menu)
        let menuHandle = menu
        if type(menu) == "Instance" and !isNull(menu._handle)
            menuHandle = menu._handle
        end
        if !isNull(self._handle)
            _native.traySetMenu(self._handle, menuHandle)
        end
    end

    # Updates the hover tooltip text displayed when mouse pointer hovers over tray icon.
    #
    # @param  tooltip {String} The new tooltip text string
    # @return         {Void}
    setTooltip(tooltip)
        self.tooltip = tooltip
        if !isNull(self._handle)
            _native.traySetTooltip(self._handle, tooltip)
        end
    end

    # Displays a native balloon notification popup anchored to the tray icon.
    #
    # @param  title   {String} Header title of the notification
    # @param  message {String} Body content message
    # @param  timeout {Number} Visibility duration in seconds (default: 5)
    # @return         {Void}
    showBalloon(title, message, timeout = 5)
        if !isNull(self._handle)
            _native.trayShowBalloon(self._handle, title, message, timeout)
        end
    end

    # Removes the tray icon from the notification area and frees all associated OS resources.
    #
    # @return {Void}
    destroy()
        if !isNull(self._handle)
            _native.trayDestroy(self._handle)
            self._handle = Null
        end
    end
end

# -----------------------------------------------------------------------------
# Backward-Compatible Procedural Tray API
# -----------------------------------------------------------------------------


fn trayCreate(label, iconPath)
    return _native.trayCreate(label, iconPath)
end

fn traySetIcon(handle, iconPath)
    _native.traySetIcon(handle, iconPath)
end

fn traySetMenu(handle, menuHandle)
    if type(menuHandle) == "Instance" and !isNull(menuHandle._handle)
        menuHandle = menuHandle._handle
    end
    _native.traySetMenu(handle, menuHandle)
end

fn traySetTooltip(handle, tooltip)
    _native.traySetTooltip(handle, tooltip)
end

fn trayDestroy(handle)
    _native.trayDestroy(handle)
end

fn trayShowBalloon(handle, title, message, timeout = 5)
    _native.trayShowBalloon(handle, title, message, timeout)
end
