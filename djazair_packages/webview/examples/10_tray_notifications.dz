use webview

# 1. System Tray Icon Lifecycle
let tray = webview.trayCreate("Djazair App", "icon.ico")
if !isNull(tray)
    webview.traySetTooltip(tray, "Djazair Application v1.0")
    webview.trayShowBalloon(tray, "Title", "Message text", 5)
    webview.trayDestroy(tray)
end

# Toast Notification
webview.notificationShow(
    "Djazair App",
    "Hello from Djazair!",
    "Notification Subtitle",
    True,
    "",
    5
)
