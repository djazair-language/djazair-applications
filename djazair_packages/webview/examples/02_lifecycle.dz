use webview

# Create window with debug mode enabled for console monitoring
let app = webview.createWindow({"title": "My App", "debug": True})

app.onReady(fn()
    print("App is ready!")
end)

app.onQuit(fn()
    print("Goodbye!")
end)

app.onError(fn(err)
    print("Error: ${err}")
end)

app.run()
