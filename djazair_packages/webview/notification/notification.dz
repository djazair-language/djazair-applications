let _native = __native("_webview")

# =============================================================================
# Class: Notification
# =============================================================================
# Provides utilities for dispatching native platform desktop notifications,
# action center toasts, and tray balloons.
class Notification
    # Displays a native desktop notification toast or balloon.
    #
    # @param  title    {String}  Notification header title
    # @param  message  {String}  Main notification body text
    # @param  subtitle {String}  Optional secondary subtitle text (default: "")
    # @param  sound    {Bool}    Whether to play standard system notification audio chime (default: False)
    # @param  icon     {String}  Path to custom icon image or empty for app icon (default: "")
    # @param  timeout  {Number}  Display duration in seconds before auto-dismiss (default: 5)
    # @return          {Void}
    show(title, message, subtitle = "", sound = False, icon = "", timeout = 5)
        _native.notificationShow(title, message, subtitle, sound, icon, timeout)
    end
end

# -----------------------------------------------------------------------------
# Procedural Notification Helper API
# -----------------------------------------------------------------------------

# Convenience procedural wrapper for triggering native notifications without class instantiation.
#
# @param  title    {String}  Notification header title
# @param  message  {String}  Main notification body text
# @param  subtitle {String}  Optional secondary subtitle text (default: "")
# @param  sound    {Bool}    Whether to play standard system notification audio chime (default: False)
# @param  icon     {String}  Path to custom icon image or empty for app icon (default: "")
# @param  timeout  {Number}  Display duration in seconds before auto-dismiss (default: 5)
# @return          {Void}
fn notificationShow(title, message, subtitle = "", sound = False, icon = "", timeout = 5)
    _native.notificationShow(title, message, subtitle, sound, icon, timeout)
end

