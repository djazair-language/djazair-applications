# run_docs.dz
# Standalone desktop runner for Djazair Qalam Interactive Documentation
# Author: Harizi Riyadh (hariziriyadh@gmail.com)
# Copyright (c) 2026 Djazair Language Project

use webview

let app = webview.createWindow({
    "title": "Djazair Qalam — Official Documentation & Template Playground",
    "width": 1260,
    "height": 840,
    "minWidth": 800,
    "minHeight": 600,
    "center": True,
    "darkTitleBar": True,
    "debug": True,
    "singleInstance": True,
    "appId": "com.djazair.qalam.docs"
})

app.onReady(fn()
    app.window.navigate("index.html")
end)

app.run()
