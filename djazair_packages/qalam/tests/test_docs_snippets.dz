# Snippets 6 & 12 & 13: Layout Inheritance (views/layout.html & views/dashboard.html)
let layoutDir = "${os.tmpDir()}/qalam_doc_layout_full"
if not file.exists(layoutDir) dir.createAll(layoutDir) end

file.write("${layoutDir}/layout.html", `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{% block title %}Djazair Enterprise Portal{% end %}</title>
  {% block styles %}<link rel="stylesheet" href="/style.css" />{% end %}
</head>
<body>
  <header>
    {% block header %}<nav>Default Application Navigation</nav>{% end %}
  </header>

  <main class="main-content">
    {% block content %}{% end %}
  </main>

  <footer>
    {% block footer %}<p>&copy; 2026 Djazair Language Project</p>{% end %}
  </footer>
</body>
</html>`)

file.write("${layoutDir}/dashboard.html", `{% extends "layout" %}

{% block title %}Trading Dashboard • Djazair Portal{% end %}

{% block content %}
  <h1>Live Portfolios</h1>
  <p>Welcome back, {{ user.name }}!</p>
  <ul>
    {% for trade in trades %}
      <li>{{ trade.symbol }}: \${{ trade.value | round(2) }}</li>
    {% end %}
  </ul>
{% end %}`)

let vDashboard = new qalam.view({
    "views": layoutDir,
    "cache": True
})

let htmlDashboard = vDashboard.render("dashboard", {
    "siteTitle": "Algerian Trading Portal",
    "user": {"name": "Riad", "role": "admin"},
    "trades": [
        {"symbol": "DZ-ENERGY", "value": 1450.50},
        {"symbol": "ALG-TECH", "value": 820.75}
    ]
})

testContains("DOC HTML Snippets 6+12+13: title block", htmlDashboard, "<title>Trading Dashboard • Djazair Portal</title>")
testContains("DOC HTML Snippets 6+12+13: user greeting", htmlDashboard, "Welcome back, Riad!")
testContains("DOC HTML Snippets 6+12+13: trade DZ-ENERGY", htmlDashboard, "DZ-ENERGY: $1450.5")
testContains("DOC HTML Snippets 6+12+13: trade ALG-TECH", htmlDashboard, "ALG-TECH: $820.75")
testContains("DOC HTML Snippets 6+12+13: footer copy", htmlDashboard, "&copy; 2026 Djazair Language Project")

# Snippet 14: Partials & Sub-Views Inclusion (include)
let partialsDir = "${os.tmpDir()}/qalam_doc_partials_full"
if not file.exists(partialsDir) dir.createAll(partialsDir) end
if not file.exists("${partialsDir}/partials") dir.createAll("${partialsDir}/partials") end
if not file.exists("${partialsDir}/components") dir.createAll("${partialsDir}/components") end

file.write("${partialsDir}/partials/navbar.html", "<nav class='brand-nav'>Navbar Content</nav>")
file.write("${partialsDir}/components/metrics_card.html", "<div class='card'>Daily Trades: 142</div>")
file.write("${partialsDir}/partials/footer.html", "<footer>Company Footer</footer>")

file.write("${partialsDir}/dashboard.html", `<header>
  <!-- Injects views/partials/navbar.html into the view -->
  {% include "partials/navbar" %}
</header>

<div class="container">
  {% include "components/metrics_card" %}
</div>

<footer>
  {% include "partials/footer" %}
</footer>`)

