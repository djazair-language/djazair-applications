testContains("DOC HTML Snippet 9: tag 2", outSnippet9, "<span class=\"tag\">web</span>")
testContains("DOC HTML Snippet 9: tag 3", outSnippet9, "<span class=\"tag\">templates</span>")

# Snippet 10: Multi-Branch Conditionals (if / elif / else / end)
let tplSnippet10 = `{% if user.role == "admin" %}
  <span class="badge badge-admin">Administrator</span>
{% elif user.role == "editor" %}
  <span class="badge badge-editor">Editor</span>
{% elif user.role == "moderator" %}
  <span class="badge badge-mod">Moderator</span>
{% else %}
  <span class="badge badge-guest">Standard Guest</span>
{% end %}`

