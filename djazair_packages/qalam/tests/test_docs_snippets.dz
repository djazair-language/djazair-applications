testContains("DOC HTML Snippet 14: include footer", htmlPartials, "<footer>Company Footer</footer>")

# Snippet 7: Variables & Auto-Escaping (dot-path navigation and array indexing)
let tplSnippet7 = `
<!-- Auto-sanitized against script injection -->
<h1>User: {{ user.name }}</h1>

<!-- Deep dot-path navigation -->
<p>Location: {{ user.profile.address.city }}</p>

<!-- Array index resolution -->
<p>Primary Phone: {{ user.phones[0] }}</p>
`
let outSnippet7 = qalam.renderString(tplSnippet7, {
    "user": {
        "name": "<script>alert('xss')</script>",
        "profile": {"address": {"city": "Algiers"}},
        "phones": ["+213 555 123 456", "+213 555 789 012"]
    }
})
testContains("DOC HTML Snippet 7: sanitized name", outSnippet7, "&lt;script&gt;alert(&#039;xss&#039;)&lt;/script&gt;")
testContains("DOC HTML Snippet 7: dot-path city", outSnippet7, "Location: Algiers")
testContains("DOC HTML Snippet 7: array index phone", outSnippet7, "Primary Phone: +213 555 123 456")

# Snippet 8: Raw HTML Output ({{{ ... }}})
let tplSnippet8 = `
<div class="article-body">
  <!-- Trusted HTML passes through verbatim without escaping -->
  {{{ article.sanitizedHtmlContent }}}
</div>
`
let outSnippet8 = qalam.renderString(tplSnippet8, {
    "article": {"sanitizedHtmlContent": "<p class='lead'>Djazair <strong>pure AST</strong> engine.</p>"}
})
testContains("DOC HTML Snippet 8: unescaped html", outSnippet8, "<p class='lead'>Djazair <strong>pure AST</strong> engine.</p>")

# Snippet 9: Comments and Whitespace Trimming
let tplSnippet9 = `{# This comment is completely stripped during lexing: zero runtime cost #}

<div>
  <!-- Hyphen trims leading and trailing whitespace -->
  {{- user.name -}}
</div>

<!-- Trimming inside control tags -->
{%- for tag in tags -%}
  <span class="tag">{{ tag }}</span>
{%- end -%}`

