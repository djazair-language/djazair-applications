testContains("DOC HTML Snippet 10: guest", qalam.renderString(tplSnippet10, {"user": {"role": "unknown"}}), "badge-guest")

# Snippet 11: Loops and Metadata Table (loop.first, loop.last, loop.index of loop.length)
let tplSnippet11 = `<table>
  <tr><th>#</th><th>Product</th><th>Price</th></tr>
  {% for product in products %}
  <tr class="{% if loop.first %}first-row{% elif loop.last %}last-row{% end %}">
    <td>{{ loop.index }} of {{ loop.length }}</td>
    <td>{{ product.title | capitalize }}</td>
    <td>\${{ product.price | round(2) }}</td>
  </tr>
  {% end %}
</table>`

let outSnippet11 = qalam.renderString(tplSnippet11, {
    "products": [
        {"title": "mechanical keyboard", "price": 129.99},
        {"title": "ergonomic mouse", "price": 49.50}
    ]
})
testContains("DOC HTML Snippet 11: loop.first class", outSnippet11, "<tr class=\"first-row\">")
testContains("DOC HTML Snippet 11: loop.last class", outSnippet11, "<tr class=\"last-row\">")
testContains("DOC HTML Snippet 11: 1 of 2", outSnippet11, "<td>1 of 2</td>")
testContains("DOC HTML Snippet 11: 2 of 2", outSnippet11, "<td>2 of 2</td>")
testContains("DOC HTML Snippet 11: capitalize title", outSnippet11, "Mechanical keyboard")
testContains("DOC HTML Snippet 11: rounded price", outSnippet11, "$129.99")

# Snippet 15: Direct Context Functions
let tplFnDoc = `
<p>Greeting: {{ greet(user.name) }}</p>
<p>Total Amount: {{ calculateTax(order.subtotal, 0.19) }} DZD</p>
`
let outFnDoc = qalam.renderString(tplFnDoc, {
    "user": {"name": "Riad"},
    "order": {"subtotal": 10000},
    "greet": fn(name) return "Marhaba, ${name}!" end,
    "calculateTax": fn(amount, rate) return amount * (1 + rate) end
})
testContains("DOC HTML Snippet 15: Direct function greet", outFnDoc, "<p>Greeting: Marhaba, Riad!</p>")
testContains("DOC HTML Snippet 15: Direct function calculateTax", outFnDoc, "<p>Total Amount: 11900 DZD</p>")

# Snippet 16: Filter Pipelines and Default Fallbacks
let tplSnippet16 = `
<!-- Multiple sequential pipes: trim whitespace, then capitalize -->
<h2>{{ "   algerian developer   " | trim | capitalize }}</h2>

<!-- Pipe with argument: join array with custom delimiter, then uppercase -->
<p>Tags: {{ post.tags | join(" • ") | upper }}</p>

<!-- Fallback default if value is null or empty -->
<p>Bio: {{ user.biography | default("No biography available.") }}</p>
`
let outSnippet16 = qalam.renderString(tplSnippet16, {
    "post": {"tags": ["system", "ast", "compiler"]},
    "user": {"biography": ""}
})
testContains("DOC HTML Snippet 16: chained trim|capitalize", outSnippet16, "<h2>Algerian developer</h2>")
testContains("DOC HTML Snippet 16: join with upper", outSnippet16, "SYSTEM • AST • COMPILER")
testContains("DOC HTML Snippet 16: default fallback", outSnippet16, "No biography available.")

# Snippet 17: Custom Algerian Dinar and HTML Status Badge Filters
let vDzd = new qalam.view({})
vDzd.registerFilter("dzd", fn(val, args = [])
    return "${val} DZD"
end)
vDzd.registerFilter("statusBadge", fn(status, args = [])
    if status == "paid"
        return "<span class='badge bg-success'>PAID</span>"
    elif status == "pending"
        return "<span class='badge bg-warning'>PENDING</span>"
    end
    return "<span class='badge bg-danger'>CANCELLED</span>"
end)
let htmlDzd = vDzd.renderString(
    "<p>Total: {{ amount | dzd }}</p><div>{{{ status | statusBadge }}}</div>",
    {"amount": 8500, "status": "paid"}
)
testContains("DOC HTML Snippet 17: Custom dzd filter", htmlDzd, "<p>Total: 8500 DZD</p>")
testContains("DOC HTML Snippet 17: Custom statusBadge paid", htmlDzd, "<span class='badge bg-success'>PAID</span>")

# Snippet 18: Kasbah Web Application Integration Simulation
let kasbahViewsDir = "${os.tmpDir()}/qalam_kasbah_views"
if not file.exists(kasbahViewsDir) dir.createAll(kasbahViewsDir) end
file.write("${kasbahViewsDir}/profile.html", `<!DOCTYPE html>
<html>
<head><title>{{ title }}</title></head>
<body>
  <h1>{{ user.name }} ({{ user.email }})</h1>
  <p>Orders: {{ stats.orders }} | Credits: \${{ stats.credits | round(2) }}</p>
</body>
</html>`)

let kasbahViewEngine = new qalam.view({
    "views": kasbahViewsDir,
    "cache": True
})

let renderedProfile = kasbahViewEngine.render("profile", {
    "title": "User Profile",
    "user": {"name": "Riad Harizi", "email": "riad@example.com"},
    "stats": {"orders": 14, "credits": 520.00}
})
testContains("DOC HTML Snippet 18: Kasbah view rendering title", renderedProfile, "<title>User Profile</title>")
testContains("DOC HTML Snippet 18: Kasbah user info", renderedProfile, "Riad Harizi (riad@example.com)")
testContains("DOC HTML Snippet 18: Kasbah stats", renderedProfile, "Orders: 14 | Credits: $520")

# Snippet 19: AST Cache Configuration and Invalidation
let prodView = new qalam.view({"views": layoutDir, "cache": True})
let devView = new qalam.view({"views": layoutDir, "cache": False})
test("DOC HTML Snippet 19: prodView cache enabled", prodView.loader.cacheEnabled, True)
test("DOC HTML Snippet 19: devView cache disabled", devView.loader.cacheEnabled, False)
prodView.clearCache()
test("DOC HTML Snippet 19: prodView clearCache cleans map", prodView.loader.astCache.length(), 0)

# Operators Table Verification (membership, identity, ternary)
let tplOpsDoc = `
{% if "admin" in user.roles %}Superuser{% end %}
{% if user.deletedAt is Null %}Active User{% end %}
{{ isVip ? 'VIP Customer' : 'Standard Customer' }}
`
let outOpsDoc = qalam.renderString(tplOpsDoc, {
    "user": {"roles": ["admin", "editor"], "deletedAt": Null},
    "isVip": True
})
testContains("DOC HTML Operators: Membership operator 'in'", outOpsDoc, "Superuser")
testContains("DOC HTML Operators: Identity operator 'is Null'", outOpsDoc, "Active User")
testContains("DOC HTML Operators: Ternary operator", outOpsDoc, "VIP Customer")

# ── 13. Interactive Simulator Presets Verification ────────────────────────────
# Preset 1: User Profile Card & Badges
let presetUserTpl = `<div class="user-card">
  <h2>{{ user.name | title }}</h2>
  <p>Email: {{ user.email | lower }}</p>
  <p>Status: {% if user.isActive %}<span class="sim-badge active">Active</span>{% else %}<span class="sim-badge">Inactive</span>{% end %}</p>
  <p>Roles: {{ user.roles | join(" • ") | upper }}</p>
</div>`
let presetUserData = {
  "user": {
    "name": "riad harizi",
    "email": "RIAD@EXAMPLE.COM",
    "isActive": True,
    "roles": ["architect", "developer"]
  }
}
let outPresetUser = qalam.renderString(presetUserTpl, presetUserData)
testContains("SIM PRESET 1: title filter", outPresetUser, "<h2>Riad Harizi</h2>")
testContains("SIM PRESET 1: lower filter", outPresetUser, "Email: riad@example.com")
testContains("SIM PRESET 1: active badge", outPresetUser, "<span class=\"sim-badge active\">Active</span>")
testContains("SIM PRESET 1: upper join", outPresetUser, "ARCHITECT • DEVELOPER")

# Preset 2: E-Commerce Invoice Table & Math
let presetTableTpl = `<h3>Invoice #{{ invoice.id }}</h3>
<p>Customer: {{ invoice.customer | capitalize }}</p>
<table>
  <tr><th>Item</th><th>Price</th><th>Stock</th></tr>
  {% for item in items %}
  <tr>
    <td>{{ item.name }}</td>
    <td>\${{ item.price | round(2) }}</td>
    <td>{% if item.stock > 0 %}{{ item.stock }} in stock{% else %}Out of Stock{% end %}</td>
  </tr>
  {% end %}
</table>
<p><strong>Total Items: {{ items | length }}</strong></p>`
let presetTableData = {
  "invoice": { "id": "INV-2026-09", "customer": "riad" },
  "items": [
    { "name": "Kasbah Cloud", "price": 149.5, "stock": 8 },
    { "name": "Qalam Book", "price": 29.99, "stock": 0 },
    { "name": "Enterprise Support", "price": 499.0, "stock": 3 }
  ]
}
let outPresetTable = qalam.renderString(presetTableTpl, presetTableData)
testContains("SIM PRESET 2: invoice customer", outPresetTable, "<p>Customer: Riad</p>")
testContains("SIM PRESET 2: in stock row", outPresetTable, "8 in stock")
testContains("SIM PRESET 2: out of stock row", outPresetTable, "Out of Stock")
testContains("SIM PRESET 2: total items length", outPresetTable, "<strong>Total Items: 3</strong>")

# Preset 3: Loop Metadata & Alternating Rows
let presetLoopsTpl = `<ul>
{% for fruit in fruits %}
  <li>
    {{ loop.index }}. {{ fruit | upper }}
    {% if loop.first %}(First item!){% elif loop.last %}(Last item!){% end %}
  </li>
{% end %}
</ul>
<p>Total Fruits: {{ fruits | length }}</p>`
let presetLoopsData = {
  "fruits": ["apple", "orange", "pomegranate", "fig"]
}
let outPresetLoops = qalam.renderString(presetLoopsTpl, presetLoopsData)
testContains("SIM PRESET 3: first item note", outPresetLoops, "1. APPLE\n    (First item!)")
testContains("SIM PRESET 3: last item note", outPresetLoops, "4. FIG\n    (Last item!)")
testContains("SIM PRESET 3: fruits count", outPresetLoops, "<p>Total Fruits: 4</p>")

# Preset 4: Filter Pipeline & Default Fallbacks
let presetFiltersTpl = `<p>Original: "{{ rawText }}"</p>
<p>Cleaned: "{{ rawText | trim | upper }}"</p>
<p>Reversed: "{{ "qalam" | reverse }}"</p>
<p>Fallback Bio: "{{ userBio | default("No biography provided.") }}"</p>
<p>Abs Value: {{ numVal | abs }}</p>`
let presetFiltersData = {
  "rawText": "   welcome to qalam template engine   ",
  "userBio": "",
  "numVal": -99
}
let outPresetFilters = qalam.renderString(presetFiltersTpl, presetFiltersData)
testContains("SIM PRESET 4: chained trim and upper", outPresetFilters, 'Cleaned: "WELCOME TO QALAM TEMPLATE ENGINE"')
testContains("SIM PRESET 4: reversed string literal", outPresetFilters, 'Reversed: "malaq"')
testContains("SIM PRESET 4: default fallback", outPresetFilters, 'Fallback Bio: "No biography provided."')
testContains("SIM PRESET 4: abs filter", outPresetFilters, "Abs Value: 99")

# ── Report ────────────────────────────────────────────────────────────────────
print("\n═══════════════════════════════════════════════════════════════")
print("Documentation Snippets Tests")
print("  Passed : ${passed}")
print("  Failed : ${failed}")
if failed == 0
    print("  Result : ALL DOCUMENTATION SNIPPETS VERIFIED 100% ✅")
end
print("═══════════════════════════════════════════════════════════════")
