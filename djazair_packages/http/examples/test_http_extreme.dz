# ══════════════════════════════════════════════════════════════════════════════
# TEST 18: HTTP Parser Security — رفض الـ headers المسمومة
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 18: Security — CRLF Injection & Parser Validation ---")

let crlf_rejected = False
try
    let b = new http.httpResponseBuilder()
    b.setHeader("X-Injected" + chr(13) + chr(10) + "X-Evil", "pwned")
catch e
    crlf_rejected = True
end
test("CRLF header injection rejected", crlf_rejected)

let bad_request_rejected = False
try
    let p = new http.httpParser()
    p.parseRequest("GET / HTTP/1.1 EXTRA_FIELD\r\nHost: local\r\n\r\n")
catch e
    bad_request_rejected = True
end
test("Parser rejects 4-part request line", bad_request_rejected)

let whitespace_header_rejected = False
try
    let p2 = new http.httpParser()
    p2.parseRequest("GET / HTTP/1.1\r\nBad Header Name: value\r\n\r\n")
catch e
    whitespace_header_rejected = True
end
test("Parser rejects whitespace in header names", whitespace_header_rejected)

let invalid_status_rejected = False
try
    let p3 = new http.httpParser()
    p3.parseResponse("HTTP/1.1 99 TooLow\r\n\r\n")
catch e
    invalid_status_rejected = True
end
test("Parser rejects status < 100", invalid_status_rejected)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 19: httpRequest Unit — تحليل طلبات HTTP كاملة
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 19: httpRequest Unit Tests ---")

let rawGet = "GET /api/v1/users?role=admin&page=2&limit=50 HTTP/1.1\r\nHost: api.djazair.dz\r\nAuthorization: Bearer tok_abc\r\nX-Request-ID: req-9999\r\nAccept: application/json\r\n\r\n"
let parsedReq = new http.httpRequest(rawGet)

test("Parsed method GET", parsedReq.method == "GET")
test("Parsed pathname", parsedReq.pathname == "/api/v1/users")
test("Parsed query role", parsedReq.query.get("role") == "admin")
test("Parsed query page", parsedReq.query.get("page") == "2")
test("Parsed query limit", parsedReq.query.get("limit") == "50")
test("Parsed header Authorization", parsedReq.header("Authorization") == "Bearer tok_abc")
test("Parsed header case-insensitive", parsedReq.header("authorization") == "Bearer tok_abc")
test("Parsed header X-Request-ID", parsedReq.header("X-Request-ID") == "req-9999")
test("isMethod GET", parsedReq.isMethod("GET"))
test("isMethod post false", !parsedReq.isMethod("POST"))
test("toString contains GET", parsedReq.toString().contains("GET"))

let rawPost = "POST /api/v1/login HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 35\r\n\r\n{\"username\":\"ali\",\"password\":\"s3cr3t\"}"
let parsedPost = new http.httpRequest(rawPost)
test("POST parsed method", parsedPost.method == "POST")
test("POST body has username", parsedPost.body.contains("ali"))
test("POST body has password", parsedPost.body.contains("s3cr3t"))


# ══════════════════════════════════════════════════════════════════════════════
# TEST 20: httpResponseBuilder — بناء ردود معقدة
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 20: httpResponseBuilder Full Pipeline ---")

let builder = new http.httpResponseBuilder()
builder.status(201)
builder.setHeader("X-Request-ID", "abc-123")
builder.setHeader("X-API-Version", "2.0")
builder.setHeader("Cache-Control", "no-cache, no-store")
let builtRes = builder.build({"created": True, "id": 42, "name": "djazair"})

test("Builder 201 Created", builtRes.contains("201 Created"))
test("Builder X-Request-ID present", builtRes.contains("abc-123"))
test("Builder X-API-Version present", builtRes.contains("2.0"))
test("Builder Cache-Control present", builtRes.contains("no-cache"))
test("Builder JSON body created=true", builtRes.contains("true"))
test("Builder JSON body id=42", builtRes.contains("42"))
test("Builder auto Content-Length", builtRes.contains("Content-Length:"))
test("Builder auto Connection keep-alive", builtRes.contains("Connection: keep-alive"))

let b2 = new http.httpResponseBuilder().status(204).build(Null)
test("Builder 204 No Content", b2.contains("204"))

let b3 = new http.httpResponseBuilder().status(200)
b3.setHeader("X-Remove", "val")
b3.removeHeader("X-Remove")
test("Builder removeHeader — header absent", !b3.build().contains("X-Remove"))

let b4 = new http.httpResponseBuilder().status(200)
let arrOut = b4.build([10, 20, 30, 40, 50])
test("Builder array JSON body", arrOut.contains("[10,20,30,40,50]"))

let b5 = new http.httpResponseBuilder().status(200)
b5.status(400, "Custom Bad Request")
test("Builder custom status text", b5.build().contains("400 Custom Bad Request"))


