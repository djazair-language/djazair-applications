# test_http_security.dz — Local regression checks for HTTP input validation.

use http

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed += 1
    else
        print("  FAIL: ${name}")
        failed += 1
    end
end

let headerInjectionRejected = False
try
    let builder = new http.httpResponseBuilder()
    builder.setHeader("X" + chr(13) + "Injected", "value")
catch err
    headerInjectionRejected = True
end
test("response builder rejects CRLF header injection", headerInjectionRejected)

let invalidRequestLineRejected = False
try
    let parser = new http.httpParser()
    parser.parseRequest("GET / HTTP/1.1 extra\r\nHost: local\r\n\r\n")
catch err
    invalidRequestLineRejected = True
end
test("parser rejects four-part request line", invalidRequestLineRejected)

let invalidHeaderRejected = False
try
    let parser = new http.httpParser()
    parser.parseRequest("GET / HTTP/1.1\r\nBad Header: value\r\n\r\n")
catch err
    invalidHeaderRejected = True
end
test("parser rejects whitespace in header names", invalidHeaderRejected)

let invalidStatusRejected = False
try
    let parser = new http.httpParser()
    parser.parseResponse("HTTP/1.1 99 Invalid\r\n\r\n")
catch err
    invalidStatusRejected = True
end
test("parser rejects invalid response status", invalidStatusRejected)

print("Total: ${passed + failed} | Passed: ${passed} | Failed: ${failed}")
if failed > 0
    throw "${failed} HTTP security tests failed"
end
