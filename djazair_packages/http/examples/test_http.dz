# PART 6: Status Codes
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 6: Status Codes ---")

# 6.1 Each status code gets its own server to avoid handler issues
let t10a = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('OK')
end)
srv.listen(${P25})
")
let t10b = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(201).send('Created')
end)
srv.listen(${P26})
")
let t10c = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(204).send('')
end)
srv.listen(${P27})
")
let t10d = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(301).setHeader('Location', 'http://example.com/new').send('')
end)
srv.listen(${P28})
")
let t10e = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(404).send('Not Found')
end)
srv.listen(${P29})
")
let t10f = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(418).send('I am a teapot')
end)
srv.listen(${P30})
")
let t10g = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(500).send('Server Error')
end)
srv.listen(${P31})
")
process.sleep(2)

let rc200 = http.get("http://127.0.0.1:${P25}/")
test("200 OK", rc200 != Null and rc200.statusCode == 200)

let rc201 = http.get("http://127.0.0.1:${P26}/")
test("201 Created", rc201 != Null and rc201.statusCode == 201)

let rc204 = http.get("http://127.0.0.1:${P27}/")
test("204 No Content", rc204 != Null and rc204.statusCode == 204)

let rc301 = http.get("http://127.0.0.1:${P28}/", Null, Null, False)
test("301 Redirect", rc301 != Null and rc301.statusCode == 301)
test("301 Location", rc301 != Null and rc301.headers.has("location") and rc301.headers["location"] == "http://example.com/new")

let rc404 = http.get("http://127.0.0.1:${P29}/")
test("404 Not Found", rc404 != Null and rc404.statusCode == 404)

let rc418 = http.get("http://127.0.0.1:${P30}/")
test("418 Teapot", rc418 != Null and rc418.statusCode == 418)

let rc500 = http.get("http://127.0.0.1:${P31}/")
test("500 Server Error", rc500 != Null and rc500.statusCode == 500)

