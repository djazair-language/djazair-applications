# PART 11: Auto-detection & Guards
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 11: Auto-detection & Guards ---")

let t22 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send({'auto': 'json'})
end)
srv.listen(${P21})
")
process.sleep(1)

let r22 = http.get("http://127.0.0.1:${P21}/")
test("JSON auto Content-Type", r22 != Null and r22.headers["content-type"].contains("application/json"))

let t23 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).setHeader('Content-Type', 'text/html').send('<p>Hello</p>')
end)
srv.listen(${P22})
")
process.sleep(1)

let r23 = http.get("http://127.0.0.1:${P22}/")
test("custom CT text/html", r23 != Null and r23.headers["content-type"] == "text/html")
test("custom CT body", r23 != Null and r23.body.contains("<p>Hello</p>"))

let t24 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('First')
    res.status(400).send('Second')
end)
srv.listen(${P23})
")
process.sleep(1)

let r24 = http.get("http://127.0.0.1:${P23}/")
test("isSent guard first wins", r24 != Null and r24.body == "First")

let t25 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send(req.pathname)
end)
srv.listen(${P24})
")
process.sleep(1)

let r25 = http.get("http://127.0.0.1:${P24}/api/v2/items")
test("pathname preserved", r25 != Null and r25.body == "/api/v2/items")

# ══════════════════════════════════════════════════════════════════════════════
# PART 12: HTTP/1.1 Keep-Alive Connection Pooling
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 12: Keep-Alive Connection Pooling ---")

let t26 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('KA_' + req.pathname)
end, {'maxKeepAliveRequests': 50, 'keepAliveTimeout': 5, 'keepAlive': True})
srv.listen(${P36})
")
process.sleep(1)

let ka1 = http.get("http://127.0.0.1:${P36}/req1", Null, True)
let ka2 = http.get("http://127.0.0.1:${P36}/req2", Null, True)
let ka3 = http.get("http://127.0.0.1:${P36}/req3", Null, True)

test("Keep-Alive req1 body", ka1 != Null and ka1.body == "KA_/req1")
test("Keep-Alive req2 body", ka2 != Null and ka2.body == "KA_/req2")
test("Keep-Alive req3 body", ka3 != Null and ka3.body == "KA_/req3")
test("Keep-Alive header present", ka3 != Null and ka3.headers.has("connection") and ka3.headers["connection"] == "keep-alive")

http.clearPool()
test("http.clearPool executed", True)

# ══════════════════════════════════════════════════════════════════════════════
# PART 13: HTTPS Support & Options Method
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 13: HTTPS Support & Options ---")

let httpsOk = False
try
    let secureRes = http.get("https://example.com/")
    if secureRes != Null and secureRes.statusCode == 200
        httpsOk = True
    end
catch err
    print("HTTPS Error: " + str(err))
end
if httpsOk
    test("HTTPS GET example.com", True)
else
    print("  SKIP: HTTPS GET example.com (external network unavailable)")
end

closeWorkers([t1, t2, t3, t4, t5, t6, t7, t8, t9, t10a, t10b, t10c, t10d, t10e, t10f, t10g, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26])

let t27 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    if req.isMethod('OPTIONS')
        res.status(200).setHeader('Allow', 'GET, POST, OPTIONS').send('')
    else
        res.status(200).send('OK')
    end
end)
srv.listen(${P37})
")
process.sleep(1)

let rOpt = http.options("http://127.0.0.1:${P37}/api")
test("options method status 200", rOpt != Null and rOpt.statusCode == 200)
test("options Allow header", rOpt != Null and rOpt.headers.has("allow") and rOpt.headers["allow"].contains("GET"))

# ══════════════════════════════════════════════════════════════════════════════
# PART 14: Client IP Tracking & Binary sendBytes
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 14: Client IP & Binary Response ---")

let t28 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    if req.pathname == '/ip'
        res.status(200).send('ip=' + req.remoteAddr)
    elif req.pathname == '/bytes'
        res.status(200).sendBytes([72, 73]) # 'HI'
    end
end)
srv.listen(${P38})
")
process.sleep(1)

let rIp = http.get("http://127.0.0.1:${P38}/ip")
test("remoteAddr IP present", rIp != Null and rIp.body.contains("127.0.0.1"))

let rBytes = http.get("http://127.0.0.1:${P38}/bytes")
test("sendBytes binary response", rBytes != Null and rBytes.body == "HI")

# ══════════════════════════════════════════════════════════════════════════════
# PART 15: Streaming — sendStream / endStream
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 15: Streaming ---")

let t29 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200)
    res.writeChunk('Hello ')
    res.writeChunk('World')
    res.endChunk('!')
end)
srv.listen(${P39})
")
process.sleep(1)

let rStream = http.get("http://127.0.0.1:${P39}/stream")
test("streaming — body assembled", rStream != Null and rStream.body == "Hello World!")

let t30 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200)
    res.endChunk('only')
end)
srv.listen(${P40})
")
process.sleep(1)

let rEndOnly = http.get("http://127.0.0.1:${P40}/end")
test("streaming — endChunk alone", rEndOnly != Null and rEndOnly.body == "only")

closeWorkers([t27, t28, t29, t30])

# ══════════════════════════════════════════════════════════════════════════════
# PART 23: CONFIG, PATCH & UTILITY MODULES
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 23: Config, Patch & Low-level Modules ---")

let clientCfgOk = True
try
    http.setClientConfig({"timeout": 5.0})
catch e
    clientCfgOk = False
end
test("setClientConfig executes successfully", clientCfgOk)

let serverCfgOk = True
try
    http.setServerConfig({"maxBodySize": 1048576})
catch e
    serverCfgOk = False
end
test("setServerConfig executes successfully", serverCfgOk)

test("reader and utils modules exist", !isNull(http.reader) and !isNull(http.utils))
test("patch function is defined", !isNull(http.patch))

# ══════════════════════════════════════════════════════════════════════════════
# SUMMARY
# ══════════════════════════════════════════════════════════════════════════════
print("")
print("Total: ${passed + failed} | Passed: ${passed} | Failed: ${failed}")
print("")

if failed > 0
    throw "${failed} tests failed"
end
print("=== All HTTP Tests Passed ===")
