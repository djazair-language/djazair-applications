# PART 7: Error Handling
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 7: Error Handling ---")

let t11 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    throw 'Intentional error'
end)
srv.listen(${P10})
")
process.sleep(1)

let rErr = http.get("http://127.0.0.1:${P10}/crash")
test("handler error 500", rErr != Null and rErr.statusCode == 500)

let t12 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200)
        .setHeader('X-Request-ID', 'abc-123')
        .setHeader('X-Custom', 'test-value')
        .send('OK')
end)
srv.listen(${P11})
")
process.sleep(1)

let r12 = http.get("http://127.0.0.1:${P11}/")
test("custom headers ID", r12 != Null and r12.headers["x-request-id"] == "abc-123")
test("custom headers custom", r12 != Null and r12.headers["x-custom"] == "test-value")

