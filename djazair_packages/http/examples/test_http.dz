# test_http.dz — Comprehensive HTTP Library Tests
# Covers: helpers, client methods, server, request/response, edge cases

use http
use net
use thread
use process
use json

print("=== HTTP Library — Comprehensive Tests ===\n")

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed += 1
    else
        print("  FAIL: ${name}")
        failed += 1
    end
end

# HTTP test servers run in worker threads. Shut each batch down explicitly so
# the suite validates server lifecycle instead of accumulating live listeners.
fn closeWorkers(workers)
    for worker in workers
        worker.close(2)
    end
end

let P0 = 19500
let P1 = 19501
let P2 = 19502
let P3 = 19503
let P4 = 19504
let P5 = 19505
let P6 = 19506
let P7 = 19507
let P8 = 19508
let P9 = 19509
