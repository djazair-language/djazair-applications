# PART 5: POST, PUT, DELETE, HEAD, OPTIONS
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 5: POST/PUT/DELETE/HEAD/OPTIONS ---")

let t4 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(201).send('Created: ' + req.body)
end)
srv.listen(${P3})
")
process.sleep(1)

let r4 = http.post("http://127.0.0.1:${P3}/items", "new item", {"Content-Type": "text/plain"})
test("POST text 201", r4 != Null and r4.statusCode == 201)
test("POST text body", r4 != Null and r4.body.contains("new item"))

let t5 = thread.spawnCode("
use http
use json
let srv = http.createServer(fn(req, res)
    let data = json.decode(req.body)
    res.status(200).setHeader('Content-Type', 'application/json').send(data)
end)
srv.listen(${P4})
")
process.sleep(1)

let r5 = http.post("http://127.0.0.1:${P4}/api", {"user": "ali", "age": 25})
test("POST JSON 200", r5 != Null and r5.statusCode == 200)
test("POST JSON has user", r5 != Null and r5.body.contains("ali"))
test("POST JSON has age", r5 != Null and r5.body.contains("25"))

let t6 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('Updated: ' + req.body)
end)
srv.listen(${P5})
")
process.sleep(1)

let r6 = http.put("http://127.0.0.1:${P5}/items/1", "updated data")
test("PUT 200", r6 != Null and r6.statusCode == 200)
test("PUT body", r6 != Null and r6.body.contains("Updated"))

let t7 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(204).send('')
end)
srv.listen(${P6})
")
process.sleep(1)

let r7 = http.del("http://127.0.0.1:${P6}/items/1")
test("DELETE 204", r7 != Null and r7.statusCode == 204)

let t8 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).setHeader('X-Custom', 'head-value').send('')
end)
srv.listen(${P7})
")
process.sleep(1)

let r8 = http.head("http://127.0.0.1:${P7}/resource")
test("HEAD 200", r8 != Null and r8.statusCode == 200)
test("HEAD header", r8 != Null and r8.headers["x-custom"] == "head-value")

let t9 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).setHeader('Allow', 'GET, POST, OPTIONS').send('')
end)
srv.listen(${P8})
")
process.sleep(1)

let r9 = http.options("http://127.0.0.1:${P8}/resource")
test("OPTIONS 200", r9 != Null and r9.statusCode == 200)
test("OPTIONS Allow", r9 != Null and r9.headers["allow"].contains("GET"))

