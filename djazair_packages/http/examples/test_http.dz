# ══════════════════════════════════════════════════════════════════════════════
# PART 1: HTTP Helpers (unit tests, no server)
# ══════════════════════════════════════════════════════════════════════════════
print("--- PART 1: HTTP Helpers ---")

test("statusText 200", http.statusText(200) == "OK")
test("statusText 201", http.statusText(201) == "Created")
test("statusText 204", http.statusText(204) == "No Content")
test("statusText 301", http.statusText(301) == "Moved Permanently")
test("statusText 400", http.statusText(400) == "Bad Request")
test("statusText 404", http.statusText(404) == "Not Found")
test("statusText 413", http.statusText(413) == "Content Too Large")
test("statusText 418", http.statusText(418) == "I'm a Teapot")
test("statusText 500", http.statusText(500) == "Internal Server Error")
test("statusText 502", http.statusText(502) == "Bad Gateway")
test("statusText 503", http.statusText(503) == "Service Unavailable")
test("statusText unknown", http.statusText(999) == "Unknown")
test("STATUS_TEXTS is map", isMap(http.STATUS_TEXTS))
test("STATUS_TEXTS has 200", http.STATUS_TEXTS.has(200))

# ══════════════════════════════════════════════════════════════════════════════
# PART 2: httpRequest (unit tests)
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 2: httpRequest ---")

let reqStr = "GET /search?q=djazair&page=1 HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\n\r\n"
let req = new http.httpRequest(reqStr)
test("req method", req.method == "GET")
test("req pathname", req.pathname == "/search")
test("req query exists", !isNull(req.query))
test("req query.q", req.query.get("q") == "djazair")
test("req query.page", req.query.get("page") == "1")
test("req header ACCEPT", req.header("ACCEPT") == "*/*")
test("req header case-insensitive", req.header("accept") == "*/*")
test("req toString", req.toString().contains("GET"))
test("req isMethod GET", req.isMethod("GET"))
test("req isMethod lowercase", req.isMethod("get"))
test("req isMethod wrong", !req.isMethod("POST"))

let postReq = new http.httpRequest("POST /submit HTTP/1.1\r\nContent-Type: application/x-www-form-urlencoded\r\n\r\nname=djazair")
test("req POST body", postReq.body.contains("name=djazair"))

let noQueryReq = new http.httpRequest("GET /api HTTP/1.1\r\nHost: x.com\r\n\r\n")
test("req no query", isNull(noQueryReq.query) or !noQueryReq.query.has("q"))

# ══════════════════════════════════════════════════════════════════════════════
# PART 3: httpResponseBuilder (unit tests)
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 3: httpResponseBuilder ---")

let b1 = new http.httpResponseBuilder()
test("builder default 200", b1.build().contains("200 OK"))

b1.status(201)
test("builder status 201", b1.build().contains("201 Created"))

b1.status(404, "Custom Not Found")
test("builder custom text", b1.build().contains("404 Custom Not Found"))

b1.setHeader("X-Test", "value1")
test("builder setHeader", b1.getHeader("X-Test") == "value1")
test("builder case-insensitive", b1.getHeader("x-test") == "value1")

b1.removeHeader("X-Test")
test("builder removeHeader", b1.getHeader("X-Test") == "")

let b2 = new http.httpResponseBuilder().status(200).build("Hello World")
test("builder body", b2.contains("Hello World"))
test("builder auto Content-Length", b2.contains("Content-Length:"))
test("builder auto Connection", b2.contains("Connection: keep-alive"))

let b3 = new http.httpResponseBuilder()
b3.status(200)
let jsonResp = b3.build({"key": "value"})
test("builder JSON body", jsonResp.contains('"key":"value"'))

let b4 = new http.httpResponseBuilder().status(204).build(Null)
test("builder null body", b4.contains("204"))

let b5 = new http.httpResponseBuilder().status(200)
b5.setHeader("X-A", "1")
b5.setHeader("X-B", "2")
let b5out = b5.build()
test("builder multiple headers", b5out.contains("x-a: 1") and b5out.contains("x-b: 2"))

let b6 = new http.httpResponseBuilder().status(200)
b6.setHeader("X-R", "val")
b6.removeHeader("X-R")
test("builder removed absent", !b6.build().contains("X-R"))

let b7 = new http.httpResponseBuilder().status(200)
let arrBody = b7.build([1, 2, 3])
test("builder array JSON", arrBody.contains("[1,2,3]"))

# ══════════════════════════════════════════════════════════════════════════════
# PART 4: GET Client/Server
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 4: GET Client/Server ---")

let t1 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).setHeader('Content-Type', 'text/plain').send('Hello from GET')
end)
srv.listen(${P0})
")
process.sleep(1)

let r1 = http.get("http://127.0.0.1:${P0}/")
test("GET 200", r1 != Null and r1.statusCode == 200)
test("GET body", r1 != Null and r1.body == "Hello from GET")
test("GET content-type", r1 != Null and r1.headers.has("content-type") and r1.headers["content-type"].contains("text/plain"))

let t2 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    let q = req.query
    if !isNull(q) and q.has('name')
        res.status(200).send('Hello ' + q.get('name'))
    else
        res.status(200).send('No name')
    end
end)
srv.listen(${P1})
")
process.sleep(1)

let r2 = http.get("http://127.0.0.1:${P1}/greet?name=Djazair")
test("GET query 200", r2 != Null and r2.statusCode == 200)
test("GET query body", r2 != Null and r2.body == "Hello Djazair")

let t3 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    let q = req.query
    if isNull(q)
        res.status(200).send('no query')
    else
        let qVal = q.get('q')
        let pVal = q.get('page')
        let lVal = q.get('limit')
        if isNull(qVal) qVal = 'null' end
        if isNull(pVal) pVal = 'null' end
        if isNull(lVal) lVal = 'null' end
        res.status(200).send(qVal + '|' + pVal + '|' + lVal)
    end
end)
srv.listen(${P2})
")
process.sleep(1)

let r3 = http.get("http://127.0.0.1:${P2}/search?q=djazair&page=2&limit=5")
test("GET multi-query — first param", r3 != Null and r3.body.contains("djazair"))
test("GET multi-query — second param", r3 != Null and r3.body.contains("2"))
test("GET multi-query — third param", r3 != Null and r3.body.contains("5"))

