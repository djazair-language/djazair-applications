# PART 9: Passthrough & Method Echo
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 9: Passthrough ---")

let t17 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send(req.body)
end)
srv.listen(${P16})
")
process.sleep(1)

let r17 = http.post("http://127.0.0.1:${P16}/echo", "test echo data", {"Content-Type": "text/plain"})
test("echo body match", r17 != Null and r17.body == "test echo data")

let t18 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send(req.method)
end)
srv.listen(${P17})
")
process.sleep(1)

let b18 = "http://127.0.0.1:${P17}"
let rg = http.get(b18 + "/")
test("method GET", rg != Null and rg.body == "GET")
let rp = http.post(b18 + "/", "data")
test("method POST", rp != Null and rp.body == "POST")
let ru = http.put(b18 + "/", "data")
test("method PUT", ru != Null and ru.body == "PUT")

let t19 = thread.spawnCode("
use http
let count = 0
let srv = http.createServer(fn(req, res)
    count += 1
    res.status(200).send('Request ' + str(count))
end)
srv.listen(${P18})
")
process.sleep(1)

let b19 = "http://127.0.0.1:${P18}"
let rm1 = http.get(b19 + "/a")
let rm2 = http.get(b19 + "/b")
let rm3 = http.get(b19 + "/c")
test("multi req 1", rm1 != Null and rm1.body == "Request 1")
test("multi req 2", rm2 != Null and rm2.body == "Request 2")
test("multi req 3", rm3 != Null and rm3.body == "Request 3")

