# PART 8: Body Handling
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- PART 8: Body Handling ---")

let t13 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('')
end)
srv.listen(${P12})
")
process.sleep(1)

let r13 = http.get("http://127.0.0.1:${P12}/")
test("empty body 200", r13 != Null and r13.statusCode == 200)
test("empty body empty", r13 != Null and (r13.body == "" or r13.body.length() == 0))

let t14 = thread.spawnCode("
use http
let big = ''
for i in 0..1000
    big = big + 'ABCDEFGHIJ'
end
let srv = http.createServer(fn(req, res)
    res.status(200).setHeader('Content-Type', 'text/plain').send(big)
end)
srv.listen(${P13})
")
process.sleep(1)

let r14 = http.get("http://127.0.0.1:${P13}/")
test("large body 200", r14 != Null and r14.statusCode == 200)
test("large body length", r14 != Null and r14.body.length() > 5000)

let t15 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send({'users': ['ali', 'omar', 'sara'], 'count': 3})
end)
srv.listen(${P14})
")
process.sleep(1)

let r15 = http.get("http://127.0.0.1:${P14}/users")
test("JSON response 200", r15 != Null and r15.statusCode == 200)
test("JSON has users", r15 != Null and r15.body.contains("ali"))
test("JSON has count", r15 != Null and r15.body.contains("3"))

let t16 = thread.spawnCode("
use http
let srv = http.createServer(fn(req, res)
    res.status(200).send('Body length: ' + str(req.body.length()))
end)
srv.listen(${P15})
")
process.sleep(1)

let bigPost = ''
for i in 0..200
    bigPost = bigPost + 'Line ' + str(i) + ': ABCDEFGHIJ\n'
end
let r16 = http.post("http://127.0.0.1:${P15}/upload", bigPost, {"Content-Type": "text/plain"})
test("POST large 200", r16 != Null and r16.statusCode == 200)
test("POST large received", r16 != Null and r16.body.contains("Body length:"))

