# =============================================================================
# request.dz — HTTP Request (Server-Side)
# =============================================================================
# Wraps a raw HTTP request string into a structured object for use inside
# server handler callbacks.
#
# Parsing is delegated to parser.dz. URL decomposition (pathname, query)
# is performed by the net::url module.
#
# Exposed properties (set in init):
#   method      — HTTP method in uppercase  (e.g. "GET", "POST")
#   path        — Full request-target       (e.g. "/search?q=foo")
#   pathname    — Path component only       (e.g. "/search")
#   query       — Map of query parameters, or Null when there is no query string
#   httpVersion — Protocol version string   (e.g. "HTTP/1.1")
#   headers     — Map of lowercase header names to values
#   body        — Request body string (may be empty for GET/HEAD/DELETE)
#   remoteAddr  — Client IP address (set externally by the server after init)
# =============================================================================

import "parser.dz" as p
use assert
use net::url as url_mod

class request

    # Parses `raw` into structured request fields.
    # Throws on malformed input so the server can respond with 400 Bad Request.
    init(raw)
        if !isString(raw) or raw == ""
            throw "http.request.init(): raw request must be a non-empty string"
        end

        let parsed = new p.parser().parseRequest(raw)

        self.method      = parsed.method
        self.path        = parsed.path
        self.httpVersion = parsed.httpVersion
        self.headers     = parsed.headers
        self.body        = parsed.body

        # Defaults — overridden below if URL parsing succeeds.
        self.pathname  = self.path
        self.query     = Null
        self.remoteAddr = ""   # Populated by the server after construction.

        # Decompose the request-target into pathname and query parameters.
        # A synthetic "http://host" prefix makes `net::url` accept a path-only target.
        try
            let u         = new url_mod.url("http://host${self.path}")
            self.pathname = u.pathname
            self.query    = u.searchParams
        catch err
            # URL parsing failed (e.g. unusual path encoding) — pathname stays as-is.
        end
    end

    # ── Header Lookup ──────────────────────────────────────────────────────────

    # Returns the value of the named request header (case-insensitive).
    # Returns "" when the header is absent.
    header(name)
        assert.string(name, "name")
        if name == ""
            throw "http.request.header(): header name must not be empty"
        end
        return self.headers.get(name.lower(), "")
    end

    # ── Method Check ───────────────────────────────────────────────────────────

    # Returns True if the request method matches `method` (case-insensitive).
    # Useful for routing: req.isMethod("GET"), req.isMethod("post"), etc.
    isMethod(method)
        assert.string(method, "method")
        if isNull(self.method) or self.method == ""
            return False
        end
        return self.method.upper() == method.upper()
    end

    # ── Debugging ─────────────────────────────────────────────────────────────

    # Returns a concise one-line summary of the request line.
    toString()
        return "${self.method} ${self.path} ${self.httpVersion}"
    end
end
