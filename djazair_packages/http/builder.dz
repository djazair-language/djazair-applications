# =============================================================================
# builder.dz — HTTP/1.1 Response Serialiser
# =============================================================================
# Builds raw HTTP/1.1 response strings from status codes, headers, and a body.
# Designed for use without a live network connection (e.g., tests, proxies).
#
# Features:
#   - Fluent API — status(), setHeader(), removeHeader() all return self.
#   - Automatic JSON serialisation for Map and Array bodies.
#   - Auto Content-Type: application/json when body is a Map or Array.
#   - Auto Content-Length based on actual UTF-8 byte count.
#   - Auto Connection: keep-alive unless the caller overrides it.
#   - HEAD support via includeBody=False (Content-Length still reported).
#   - Strict header validation — rejects injection attempts at write time.
#
# Note: For responses sent over a live TCP connection use response.dz instead.
# =============================================================================

use assert
use json
import "utils.dz" as utils

# =============================================================================
# builder
# =============================================================================

class builder

    # Initialises a builder with default 200 OK status and no headers.
    init()
        self.statusCode = 200
        self.statusText = "OK"
        self.headers    = {}
    end

    # ── Internal Helpers ───────────────────────────────────────────────────────

    # Serialises `body` to a wire-ready string.
    # Maps and Arrays are JSON-encoded; everything else is coerced via str().
    # Null body is treated as an empty response body.
    _serializeBody(body)
        if isNull(body)
            return ""
        end
        if isMap(body) or isArray(body)
            return json.encode(body)
        end
        return str(body)
    end

    # ── Status ─────────────────────────────────────────────────────────────────

    # Sets the response status code and optional reason phrase.
    # `code` must be an integer in the range 100–599.
    # When `text` is omitted, the standard reason phrase is used.
    # Returns self for chaining.
    status(code, text = Null)
        if !isInt(code) or code < 100 or code > 599
            throw "http.builder.status(): code must be an Int between 100 and 599"
        end
        self.statusCode = code
        self.statusText = if !isNull(text) ? str(text) else utils.statusText(code)
        return self
    end

    # ── Header Access ──────────────────────────────────────────────────────────

    # Returns the current value of a header (case-insensitive lookup).
    # Returns "" when the header is not set.
    getHeader(name)
        assert.string(name, "name")
        return self.headers.get(name.lower(), "")
    end

    # Sets a response header.
    # Both name and value are validated to prevent header injection attacks.
    # Names are stored in lowercase; duplicate names overwrite the previous value.
    # Returns self for chaining.
    setHeader(name, value)
        utils.assertHeaderName(name)
        utils.assertHeaderValue(value)
        self.headers[name.lower()] = value
        return self
    end

    # Removes a header by name (case-insensitive). No-op if the header is absent.
    # Returns self for chaining.
    removeHeader(name)
        assert.string(name, "name")
        self.headers.pop(name.lower(), Null)
        return self
    end

    # ── Response Building ──────────────────────────────────────────────────────

    # Builds and returns a complete raw HTTP/1.1 response string.
    #
    # Parameters:
    #   body                — Response body. Maps/Arrays are JSON-serialised.
    #   includeBody         — When False, the body is omitted from the wire bytes
    #                         (used for HEAD responses per RFC 9110 §9.3.2).
    #   includeContentLength — When False, no Content-Length header is added
    #                          (used for status-only responses such as 204/304).
    #
    # Automatic behaviour:
    #   - Content-Type: application/json is added when body is a Map or Array
    #     and no Content-Type header has been set explicitly.
    #   - Content-Length is computed from the actual UTF-8 byte count.
    #   - Connection: keep-alive is added when no Connection header is set.
    #   - Transfer-Encoding conflicts with Content-Length are rejected.
    build(body = "", includeBody = True, includeContentLength = True)
        let bodyStr = self._serializeBody(body)

        # Auto-set Content-Type for structured bodies when not already present.
        if (isMap(body) or isArray(body)) and self.getHeader("content-type") == ""
            self.setHeader("Content-Type", "application/json")
        end

        # Reject conflicting framing headers (CL + TE is a request-smuggling vector).
        let transferEncoding = self.getHeader("transfer-encoding")
        if transferEncoding != ""
            if self.getHeader("content-length") != ""
                throw "http.builder.build(): Content-Length conflicts with Transfer-Encoding"
            end
            throw "http.builder.build(): use response.writeChunk() for chunked responses"
        end

        # Build the status line.
        let raw = "HTTP/1.1 ${self.statusCode} ${utils.sanitize(self.statusText)}\r\n"

        # Append all user-set headers.
        raw += utils.buildHeaders(self.headers)

        # Add Connection header if not already set by the caller.
        if self.getHeader("connection") == ""
            raw += "Connection: keep-alive\r\n"
        end

        # Add Content-Length based on UTF-8 byte count of the serialised body.
        if includeContentLength and self.getHeader("content-length") == ""
            raw += "Content-Length: ${utils.byteLen(bodyStr)}\r\n"
        end

        # End of headers.
        raw += "\r\n"

        if includeBody
            raw += bodyStr
        end

        return raw
    end
end
