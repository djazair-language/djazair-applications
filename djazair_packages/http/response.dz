# =============================================================================
# response.dz — Server-Side HTTP Response
# =============================================================================
# Manages sending an HTTP response over a live TCP connection.
#
# Key guarantees:
#   - Double-send protection: once a response is sent, further send calls are
#     silently ignored (self.sent flag). This prevents corrupt wire data when
#     handler code calls send() more than once.
#   - Body suppression: bodies are never sent for HEAD requests or for status
#     codes that forbid them (1xx, 204, 304) per RFC 9110 §9.3 and §15.
#   - Chunked streaming: writeChunk() / endChunk() implement RFC 9112 §7.1
#     chunked transfer encoding. Headers are flushed automatically on the
#     first writeChunk() call.
#   - Connection management: the Connection header is set to keep-alive or
#     close based on the keepAlive flag and the client's own Connection header.
#
# Public API:
#   status(code, text)        — set status code (chainable)
#   setHeader(name, value)    — set a response header (chainable)
#   getHeader(name)           — read a header value
#   removeHeader(name)        — remove a header (chainable)
#   send(body)                — serialise and send the complete response
#   sendBytes(data)           — send a raw byte array (binary-safe)
#   writeChunk(chunk)         — send one chunk (chunked TE)
#   endChunk(chunk)           — send final chunk and terminate the stream
#   isSent()                  — True after any send method completes
#   isCloseConnection()       — True when the connection will close after reply
# =============================================================================

import "builder.dz" as b
import "utils.dz"   as utils
use assert

class response

    # ── Initialisation ─────────────────────────────────────────────────────────

    # `conn`        — TCP connection object for writing to the client.
    # `keepAlive`   — Whether the server intends to keep the connection open.
    # `headRequest` — True when the incoming request used the HEAD method;
    #                 causes the body to be suppressed on all send paths.
    init(conn, keepAlive = True, headRequest = False)
        self.conn        = conn
        self.builder     = new b.builder()
        self.sent        = False        # True after the complete response is sent.
        self.headersSent = False        # True after headers are flushed (chunked mode).
        self.keepAlive   = keepAlive
        self.headRequest = headRequest

        # Pre-set the Connection header so it is present in the header block even
        # before applyConnectionHeader() is called (e.g. if an error occurs early).
        if !keepAlive
            self.builder.setHeader("Connection", "close")
        end
    end

    # ── State Queries ──────────────────────────────────────────────────────────

    # Returns True if a complete response (or chunked terminator) has been sent.
    isSent()
        return self.sent
    end

    # Marks the response as fully sent. Called internally after each send path.
    markSent()
        self.sent = True
    end

    # Returns True if this response body must be suppressed by protocol rules:
    #   - 1xx informational, 204 No Content, 304 Not Modified (RFC 9110 §15)
    isBodyForbidden()
        let code = self.builder.statusCode
        return (code >= 100 and code < 200) or code == 204 or code == 304
    end

    # Returns True when the body should not be written to the wire — either
    # because it is a HEAD request or because the status forbids a body.
    suppressBody()
        return self.headRequest or self.isBodyForbidden()
    end

    # Returns True when the TCP connection should be closed after the response.
    isCloseConnection()
        if !self.keepAlive
            return True
        end
        return self.getHeader("connection").lower() == "close"
    end

    # ── Status & Headers ───────────────────────────────────────────────────────

    # Sets the HTTP status code (and optional reason phrase). Returns self.
    status(code, text = Null)
        self.builder.status(code, text)
        return self
    end

    # Sets a response header. Returns self for chaining.
    setHeader(name, value)
        self.builder.setHeader(name, value)
        return self
    end

    # Returns the current value of a header (case-insensitive). Returns "".
    getHeader(name)
        return self.builder.getHeader(name)
    end

    # Removes a response header. Returns self for chaining.
    removeHeader(name)
        self.builder.removeHeader(name)
        return self
    end

    # ── Internal Transport Helpers ─────────────────────────────────────────────

    # Writes the Connection header based on the keepAlive policy and any
    # explicit "Connection: close" set by the handler.
    applyConnectionHeader()
        if self.isCloseConnection()
            self.builder.setHeader("Connection", "close")
        else
            self.builder.setHeader("Connection", "keep-alive")
        end
    end

    # Sends `text` to the client and verifies every byte was written.
    # Throws on incomplete write so callers can detect socket errors.
    sendTextOrThrow(text)
        let sent = self.conn.send(text)
        if sent != utils.byteLen(text)
            throw "http.response: incomplete socket write (sent ${sent} of ${utils.byteLen(text)} bytes)"
        end
    end

    # Flushes the header block to the client for chunked streaming.
    # No-op after the first call to prevent duplicate header writes.
    sendHeaders()
        if self.headersSent or isNull(self.conn)
            return
        end
        self.headersSent = True
        let raw = "HTTP/1.1 ${self.builder.statusCode} ${utils.sanitize(self.builder.statusText)}\r\n"
        raw += utils.buildHeaders(self.builder.headers)
        raw += "\r\n"
        self.sendTextOrThrow(raw)
    end

    # Closes the connection when `failed` is True or when keep-alive is disabled.
    # Errors during close are silently ignored — the socket may already be dead.
    closeOnFailure(failed)
        if failed or self.isCloseConnection()
            try
                self.conn.close()
            catch err
                # Socket may already be closed; nothing to do.
            end
        end
    end

    # ── Core Send Paths ────────────────────────────────────────────────────────

    # Sends a pre-built raw response string to the client.
    # Idempotent: ignored after the first successful or failed send.
    sendRaw(raw)
        if self.sent or isNull(self.conn)
            return self
        end

        let failed = False
        try
            self.sendTextOrThrow(raw)
        catch err
            failed = True
        end

        self.markSent()
        self.closeOnFailure(failed)
        return self
    end

    # Sends a text header block followed by a raw byte array (binary body).
    # Used by sendBytes() to avoid converting binary data through string encoding.
    sendWithBytes(headerStr, data)
        if self.sent or isNull(self.conn)
            return self
        end

        let failed = False
        try
            self.sendTextOrThrow(headerStr)
            # Write the binary payload in a loop to handle partial socket writes.
            let offset = 0
            while offset < data.length()
                let sent = self.conn.sendBytes(data.slice(offset, data.length()))
                if isNull(sent) or sent <= 0
                    throw "http.response: incomplete binary socket write"
                end
                offset += sent
            end
        catch err
            failed = True
        end

        self.markSent()
        self.closeOnFailure(failed)
        return self
    end

    # ── Public Send Methods ────────────────────────────────────────────────────

    # Serialises `body` and sends the complete response.
    # Maps and Arrays are auto-serialised to JSON.
    # Body is suppressed for HEAD requests and body-forbidden status codes.
    send(body = "")
        self.applyConnectionHeader()

        if self.isBodyForbidden()
            # RFC 9110: no body allowed; strip framing headers and send headers only.
            self.builder.removeHeader("Content-Length")
            self.builder.removeHeader("Transfer-Encoding")
            return self.sendRaw(self.builder.build("", False, False))
        end

        if self.headRequest
            # HEAD: send headers with correct Content-Length but no body bytes.
            self.builder.removeHeader("Transfer-Encoding")
            return self.sendRaw(self.builder.build(body, False, True))
        end

        return self.sendRaw(self.builder.build(body, True, True))
    end

    # Sends `data` (a byte array) as the response body.
    # Content-Length is set to the exact byte count of the array.
    # Body is suppressed for HEAD requests and body-forbidden status codes.
    sendBytes(data)
        assert.array(data, "data")
        if self.sent or isNull(self.conn)
            return self
        end

        self.applyConnectionHeader()

        if self.isBodyForbidden()
            self.builder.removeHeader("Content-Length")
            self.builder.removeHeader("Transfer-Encoding")
            return self.sendRaw(self.builder.build("", False, False))
        end

        # Use exact byte array length for Content-Length (not byteLen of a string).
        self.builder.removeHeader("Transfer-Encoding")
        self.builder.setHeader("Content-Length", str(data.length()))

        let statusLine = "HTTP/1.1 ${self.builder.statusCode} ${utils.sanitize(self.builder.statusText)}\r\n"
        let headerStr  = statusLine + utils.buildHeaders(self.builder.headers) + "\r\n"

        if self.headRequest
            # HEAD: headers only, no body bytes on the wire.
            return self.sendRaw(headerStr)
        end

        return self.sendWithBytes(headerStr, data)
    end

    # ── Chunked Streaming ──────────────────────────────────────────────────────

    # Sends one chunk of data via HTTP/1.1 chunked transfer encoding (RFC 9112 §7.1).
    # Headers are flushed automatically on the first writeChunk() call.
    # Empty chunks (Null or "") are silently skipped — per the spec, an empty
    # chunk would signal the end of the stream, which is endChunk()'s job.
    writeChunk(chunk)
        if self.sent or isNull(self.conn)
            return self
        end
        if self.suppressBody()
            throw "http.response.writeChunk(): body is not allowed for this status code or request method"
        end

        if !self.headersSent
            # First write — flush headers with Transfer-Encoding: chunked.
            self.applyConnectionHeader()
            self.builder.removeHeader("Content-Length")
            self.builder.setHeader("Transfer-Encoding", "chunked")
            self.sendHeaders()
        end

        let text = if isNull(chunk) ? "" else str(chunk)
        if text == ""
            # Never send a zero-size chunk mid-stream; that would terminate early.
            return self
        end

        try
            # Format: <hex-size>\r\n<data>\r\n
            self.sendTextOrThrow("${utils.toHex(utils.byteLen(text))}\r\n${text}\r\n")
        catch err
            # Socket error — mark as sent to prevent further write attempts.
            self.markSent()
            self.closeOnFailure(True)
        end

        return self
    end

    # Terminates a chunked response stream.
    # Optionally sends a final data chunk before the terminal zero-size chunk.
    # Always flushes headers first (even if writeChunk() was never called),
    # so endChunk() alone is sufficient for single-chunk chunked responses.
    endChunk(chunk = "")
        if self.sent or isNull(self.conn)
            return self
        end
        if self.suppressBody()
            throw "http.response.endChunk(): body is not allowed for this status code or request method"
        end

        if !self.headersSent
            # Flush headers now if no writeChunk() was called before endChunk().
            self.applyConnectionHeader()
            self.builder.removeHeader("Content-Length")
            self.builder.setHeader("Transfer-Encoding", "chunked")
            self.sendHeaders()
        end

        # Send the optional final data chunk (will also check self.sent internally).
        if !isNull(chunk) and chunk != ""
            self.writeChunk(chunk)
        end

        # Bail out if writeChunk() already closed the connection on error.
        if self.sent
            return self
        end

        # Send the chunked terminator: "0\r\n\r\n"
        let failed = False
        try
            self.sendTextOrThrow("0\r\n\r\n")
        catch err
            failed = True
        end

        self.markSent()
        self.closeOnFailure(failed)
        return self
    end
end
