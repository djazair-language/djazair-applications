# =============================================================================
# server.dz — HTTP/1.1 Server
# =============================================================================
# Listens on a TCP port, accepts client connections, and dispatches each
# HTTP request to a user-supplied handler function.
#
# Features:
#   - HTTP/1.1 keep-alive: multiple requests per TCP connection.
#   - Configurable limits: max body size, keep-alive timeout, max requests.
#   - Graceful error handling: malformed requests → 400, oversized → 413,
#     unhandled handler exceptions → 500.
#   - HEAD request support: body is suppressed automatically.
#   - Safe close: server.close() is idempotent and never throws.
#
# Configuration (per-server via options map, or globally via setServerConfig):
#   maxBody             — Maximum request body in bytes    (default: 10 MB)
#   keepAlive           — Enable persistent connections    (default: False)
#   keepAliveTimeout    — Idle timeout in seconds          (default: 30)
#   maxRequests / maxKeepAliveRequests
#                       — Max requests per connection      (default: 100)
# =============================================================================

use net::tcpServer as tcp
import "request.dz"  as req
import "response.dz" as res
import "reader.dz"   as rd
import "utils.dz"    as utils

# ── Global Server Defaults ─────────────────────────────────────────────────────
#
# These values apply to every server created by createServer() unless the caller
# passes an options map with overrides, or calls setServerConfig() first.

let SERVER_CONFIG = {
    "maxBody":          10 * 1024 * 1024,   # 10 MB
    "keepAliveTimeout": 30,                  # seconds
    "maxRequests":      100,                 # requests per connection
    "keepAlive":        False
}

# Updates one or more global server defaults. Keys not present in `options`
# retain their current values.
fn setServerConfig(options)
    if isMap(options)
        for k, v in options
            SERVER_CONFIG[k] = v
        end
    end
end

# ── server ────────────────────────────────────────────────────────────────────

class server

    # ── Initialisation ─────────────────────────────────────────────────────────

    # Creates a new server instance with the given handler and options.
    # `handler` — fn(request, response) called for each incoming request.
    # `options`  — per-server overrides (see module header for keys).
    #
    # Note: `maxKeepAliveRequests` is accepted as an alias for `maxRequests`
    # to match the options key used in the test suite and documentation.
    init(handler, options = {})
        self.handler = handler

        # Body size limit (checked before reading the body to reject early).
        self.maxBody = options.get("maxBody", SERVER_CONFIG.get("maxBody", 10485760))

        # Keep-alive idle timeout — how long to wait for the next request.
        let timeout = options.get("keepAliveTimeout", Null)
        if isNull(timeout)
            timeout = SERVER_CONFIG.get("keepAliveTimeout", 30)
        end
        self.keepAliveTimeout = timeout

        # Maximum requests per persistent connection before forcing close.
        # Accept both `maxRequests` and `maxKeepAliveRequests` (alias).
        let maxReq = options.get("maxRequests", Null)
        if isNull(maxReq)
            maxReq = options.get("maxKeepAliveRequests", Null)
        end
        if isNull(maxReq)
            maxReq = SERVER_CONFIG.get("maxRequests", 100)
        end
        self.maxRequests = maxReq

        # Whether to enable HTTP/1.1 persistent connections.
        self.keepAlive = options.get("keepAlive", SERVER_CONFIG.get("keepAlive", False))

        self.tcpServer = Null
    end

    # ── Request Reading ────────────────────────────────────────────────────────

    # Reads one complete HTTP request from `client`, using `initial` as any
    # bytes already buffered from a previous receive call.
    # Enforces self.maxBody and returns { raw, remainder } on success.
    # Throws a tagged string on protocol errors so handleClient can map to HTTP codes:
    #   "[400] ..." — Bad Request
    #   "[413] ..." — Content Too Large
    readRequest(client, initial = "")
        let r    = new rd.reader()
        let head = r.readRequestHeaders(client, initial, self.maxBody)

        if isNull(head)
            throw "[400] could not read request headers"
        end

        let info = head["info"]
        if !isNull(info) and info["invalid"]
            throw "[400] invalid HTTP message framing"
        end

        # When there is no body framing info, the body is absent — return as-is.
        if isNull(info)
            return {"raw": head["raw"], "remainder": ""}
        end

        # Reject oversized Content-Length before attempting to read the body.
        if !isNull(info["contentLength"]) and info["contentLength"] > self.maxBody
            throw "[413] payload too large"
        end

        let message = r.readRequestMessage(client, head["raw"], self.maxBody)
        if isNull(message)
            throw "[400] could not read request body"
        end

        return message
    end

    # ── Error Responses ────────────────────────────────────────────────────────

    # Sends a minimal error response and closes the connection.
    # Used when the request cannot be parsed or the body is too large.
    sendError(client, code, message)
        let statusTxt = utils.statusText(code)
        let body      = message
        let raw       = "HTTP/1.1 ${code} ${statusTxt}\r\n"
        raw += "Content-Length: ${utils.byteLen(body)}\r\n"
        raw += "Connection: close\r\n"
        raw += "\r\n${body}"

        try
            client.send(raw)
        catch err
            # Socket may be broken; the error response is best-effort.
        end

        try
            client.close()
        catch err
            # Socket may already be closed.
        end
    end

    # ── Connection Handler ─────────────────────────────────────────────────────

    # Handles one accepted TCP connection, looping over requests when keep-alive
    # is enabled. Each iteration:
    #   1. Reads and parses the HTTP request.
    #   2. Constructs the response object.
    #   3. Calls the user handler.
    #   4. Checks for unsent response (500 fallback).
    #   5. Decides whether to keep the connection open.
    handleClient(client, ip, port)
        let reqCount = 0
        let pending  = ""   # Leftover bytes from previous receive (pipelining).

        while client.isOpen() and reqCount < self.maxRequests
            # Apply the keep-alive idle timeout for this iteration.
            try
                client.setTimeout(self.keepAliveTimeout)
            catch err
                # setTimeout may not be supported on all platforms; non-fatal.
            end

            # ── Step 1: Read the request ────────────────────────────────────────
            let raw = Null
            try
                let message = self.readRequest(client, pending)
                raw     = message["raw"]
                pending = message["remainder"]
            catch errStr
                let errMsg = str(errStr)
                if errMsg.contains("[413]")
                    self.sendError(client, 413, "Payload Too Large")
                else
                    self.sendError(client, 400, "Bad Request")
                end
                break
            end

            if isNull(raw) or raw == ""
                break
            end

            # ── Step 2: Parse the request ───────────────────────────────────────
            let httpReq = Null
            try
                httpReq             = new req.request(raw)
                httpReq.remoteAddr  = ip
            catch err
                self.sendError(client, 400, "Bad Request")
                break
            end

            reqCount += 1

            # ── Step 3: Determine connection policy ─────────────────────────────
            # Force close when: client asked for it, max requests reached, or
            # keep-alive is disabled globally for this server.
            let connHdr    = httpReq.headers.get("connection", "").lower()
            let forceClose = (connHdr == "close") or
                             (reqCount >= self.maxRequests) or
                             (!self.keepAlive)

            # Construct the response — aware of HEAD suppression.
            let httpRes = new res.response(client, !forceClose, httpReq.isMethod("HEAD"))

            if forceClose
                httpRes.setHeader("Connection", "close")
            else
                httpRes.setHeader("Connection", "keep-alive")
                httpRes.setHeader("Keep-Alive", "timeout=${self.keepAliveTimeout}, max=${self.maxRequests}")
            end

            # ── Step 4: Invoke the user handler ────────────────────────────────
            try
                self.handler(httpReq, httpRes)
            catch err
                # Handler threw — if nothing was sent yet, return 500 and close.
                if !httpRes.isSent()
                    httpRes.setHeader("Connection", "close")
                    httpRes.status(500).send("")
                end
                break
            end

            # ── Step 5: Fallback for handlers that never send a response ────────
            # Without this guard the client would hang indefinitely waiting for
            # a response that never arrives.
            if !httpRes.isSent()
                httpRes.setHeader("Connection", "close")
                httpRes.status(500).send("")
                break
            end

            # ── Step 6: Decide keep-alive ───────────────────────────────────────
            if forceClose or httpRes.isCloseConnection()
                try
                    client.close()
                catch err
                    # Socket may already be closed.
                end
                break
            end
        end

        # Ensure the socket is always closed when the loop exits.
        if client.isOpen()
            try
                client.close()
            catch err
                # Socket may already be closed.
            end
        end
    end

    # ── Public Methods ─────────────────────────────────────────────────────────

    # Starts listening for HTTP connections on `port`.
    # Each accepted connection is handled in a new TCP callback.
    listen(port)
        self.tcpServer = new tcp.tcpServer(fn(client, ip, port)
            self.handleClient(client, ip, port)
        end, {"deferAccept": True})
        self.tcpServer.listen(port)
    end

    # Stops accepting new connections and shuts down the underlying TCP server.
    # Safe to call even if listen() was never called or has already returned.
    close()
        if !isNull(self.tcpServer)
            try
                self.tcpServer.close()
            catch err
                # TCP server may have already stopped; nothing to do.
            end
            self.tcpServer = Null
        end
    end
end

# ── Factory Function ───────────────────────────────────────────────────────────

# Creates and returns a new server instance.
# `handler` — fn(request, response) called for each request.
# `options`  — optional configuration map (see module header).
fn createServer(handler, options = {})
    return new server(handler, options)
end
