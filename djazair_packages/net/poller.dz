# poller.dz — I/O Multiplexing Wrapper
# Provides an efficient way to monitor multiple sockets for read/write readiness.

use assert

let native = __dynamic("net")

class poller
    init()
        self.readSockets = []
        self.writeSockets = []
        self.exceptSockets = []
    end
    
    # Register a socket for monitoring.
    # @param sock The net.socket to monitor.
    # @param mode "r" (read), "w" (write), "e" (except), or a combination (e.g., "rw").
    register(sock, mode)
        assert.string(mode, "mode")
        
        # We store the raw Resource handle internally to prevent GC issues 
        # and to match what the native layer expects.
        let handle = sock.handle
        
        if mode.contains("r") and !self.readSockets.contains(handle)
            self.readSockets.append(handle)
        end
        if mode.contains("w") and !self.writeSockets.contains(handle)
            self.writeSockets.append(handle)
        end
        if mode.contains("e") and !self.exceptSockets.contains(handle)
            self.exceptSockets.append(handle)
        end
    end
    
    # Unregister a socket from monitoring.
    # @param sock The net.socket to remove.
    unregister(sock)
        let handle = sock.handle
        
        let newRead = []
        for h in self.readSockets
            if h != handle
                newRead.append(h)
            end
        end
        self.readSockets = newRead
        
        let newWrite = []
        for h in self.writeSockets
            if h != handle
                newWrite.append(h)
            end
        end
        self.writeSockets = newWrite
        
        let newExcept = []
        for h in self.exceptSockets
            if h != handle
                newExcept.append(h)
            end
        end
        self.exceptSockets = newExcept
    end
    
    # Block until one or more monitored sockets become ready.
    # @param timeout Timeout in seconds (0 = return immediately, Null = block forever).
    # @return A map with "read", "write", "except" containing arrays of ready socket handles.
    poll(timeout = Null)
        let res = native.socket_select(self.readSockets, self.writeSockets, self.exceptSockets, timeout)
        if isNull(res)
            return {"read": [], "write": [], "except": []}
        end
        return res
    end
end
