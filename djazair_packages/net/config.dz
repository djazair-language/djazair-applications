# config.dz — Global Networking Configuration
# Defines default settings for all networking operations to avoid hardcoding
# limits and timeouts throughout the application.

use assert

# ── Global Configuration State ───────────────────────────────────────────────

# Global client configuration defaults.
# - maxSend: Maximum bytes per send/receive operation (10 MB).
# - defaultTimeout: Connection/operation timeout in seconds (0 = block forever).
# - defaultBuffer: Default read buffer size in bytes (4 KB).
let CLIENT_CONFIG = {
    "maxSend": 10 * 1024 * 1024,
    "defaultTimeout": 30,
    "defaultBuffer": 4096
}

# Global server configuration defaults.
# - defaultHost: Default interface to bind ("0.0.0.0" = all interfaces).
# - defaultPort: Default listening port.
# - defaultBacklog: Maximum length of the queue of pending connections.
# - defaultTimeout: Default timeout for accepted client sockets.
# - defaultBuffer: Default UDP server receive buffer size.
# - minBufferSize / maxBufferSize: Buffer boundaries for safety.
let SERVER_CONFIG = {
    "maxSend": 10 * 1024 * 1024,
    "defaultHost": "0.0.0.0",
    "defaultPort": 3000,
    "defaultBacklog": 128,
    "defaultTimeout": 30,
    "defaultBuffer": 4096,
    "minBufferSize": 512,
    "maxBufferSize": 65535
}

# ── Validation Helpers ───────────────────────────────────────────────────────

fn validateClientOption(key, value)
    if key == "maxSend" or key == "defaultBuffer"
        assert.number(value, "net.config: " + key)
        if value <= 0 throw "net.config: " + key + " must be a positive integer" end
    elif key == "defaultTimeout"
        assert.number(value, "net.config: defaultTimeout")
        if value < 0 throw "net.config: defaultTimeout cannot be negative" end
    end
end

fn validateServerOption(key, value)
    if key == "maxSend" or key == "defaultBuffer" or key == "minBufferSize" or key == "maxBufferSize" or key == "defaultBacklog"
        assert.number(value, "net.config: " + key)
        if value <= 0 throw "net.config: " + key + " must be a positive integer" end
    elif key == "defaultTimeout"
        assert.number(value, "net.config: defaultTimeout")
        if value < 0 throw "net.config: defaultTimeout cannot be negative" end
    elif key == "defaultPort"
        assert.number(value, "net.config: defaultPort")
        if value < 0 or value > 65535 throw "net.config: defaultPort must be between 0 and 65535" end
    elif key == "defaultHost"
        assert.string(value, "net.config: defaultHost")
    end
end

# ── Public APIs ──────────────────────────────────────────────────────────────

# Updates the global client configuration.
# Accepts a Map of options. Keys that are not recognized are ignored.
fn setClientConfig(options)
    if isMap(options)
        for key, val in options
            validateClientOption(key, val)
            if CLIENT_CONFIG.has(key)
                CLIENT_CONFIG[key] = val
            end
        end
    end
end

# Updates the global server configuration.
# Accepts a Map of options. Keys that are not recognized are ignored.
fn setServerConfig(options)
    if isMap(options)
        for key, val in options
            validateServerOption(key, val)
            if SERVER_CONFIG.has(key)
                SERVER_CONFIG[key] = val
            end
        end
    end
end
