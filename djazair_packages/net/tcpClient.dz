# tcpClient.dz — High-level TCP Client
# Provides a stream-oriented, connection-based client for IPv4 and IPv6 networks.

use assert
import "socket.dz" as sock
import "dns.dz" as dns
use net::config as conf

# A TCP client that manages its own socket lifecycle and timeouts.
class tcpClient
    
    # Initializes the TCP client. 
    # @param existingSocket (Optional) A pre-connected raw socket, usually from accept().
    init(existingSocket = Null)
        self.closed = False
        self.timeout = conf.CLIENT_CONFIG.get("defaultTimeout", 0)

        if !isNull(existingSocket)
            self.sock = existingSocket
            self.family = Null
        else
            self.family = sock.AF_INET
            self.sock = new sock.socket(self.family, sock.SOCK_STREAM, 0)
            self._applyTimeout()
        end
    end

    # Internal helper to verify the client is connected and active.
    ensureOpen(caller)
        if self.closed
            throw "net.tcpClient.${caller}(): socket is closed"
        end
    end

    # Internal helper to apply the currently configured timeout to the socket.
    _applyTimeout()
        if isNumber(self.timeout) and self.timeout > 0
            self.sock.setTimeout(self.timeout)
        end
    end

    # A failed connect can leave a platform socket unusable. This builds one fresh
    # socket for each address candidate so IPv4/IPv6 fallback is reliable.
    _recreateSocket(family)
        if !isNull(self.sock) and self.sock.isOpen()
            self.sock.close()
        end
        self.family = family
        self.sock = new sock.socket(family, sock.SOCK_STREAM, 0)
        self._applyTimeout()
    end

    # Sets the receive and send timeout for the connection.
    # @param seconds The timeout in seconds (0 = blocking).
    # @return Bool True on success.
    setTimeout(seconds)
        assert.number(seconds, "seconds")
        if seconds < 0
            throw "net.tcpClient.setTimeout(): seconds must not be negative"
        end
        self.ensureOpen("setTimeout")
        self.timeout = seconds
        self.sock.setTimeout(seconds)
        return True
    end

    # Connects to the given host and port.
    # Automatically resolves the hostname and tries IPv4/IPv6 fallbacks.
    # @param host Domain name or IP address string.
    # @param port Port number (0-65535).
    # @return Bool True if connected successfully, False otherwise.
    connect(host, port)
        assert.string(host, "host")
        sock.assertPort(port, "port")
        self.ensureOpen("connect")

        try
            # Resolve allowing any family, trying them in the order returned by the OS
            let addresses = dns.resolve(host, sock.AF_UNSPEC)
            for address in addresses
                self._recreateSocket(sock.familyForAddress(address))
                try
                    self.sock.connect(address, port)
                    return True
                catch err
                    # Connection failed for this specific IP, try the next one in the list.
                end
            end
        catch err
            return False
        end
        return False
    end

    # Sends data as a UTF-8 string over the TCP connection.
    # @param data The string (or auto-serializable structure) to send.
    # @return Number The number of bytes sent.
    send(data)
        self.ensureOpen("send")
        return self.sock.send(data)
    end

    # Receives up to `length` bytes of UTF-8 data.
    # Returns Null if the connection was closed or timed out (no exception thrown),
    # consistent with Python's sock.recv() → b"" and Node.js socket 'end' event.
    # @param length (Optional) Max bytes to read. Defaults to config buffer size.
    # @return String | Null  The received data, or Null on close / timeout.
    receive(length = Null)
        if isNull(length)
            length = conf.CLIENT_CONFIG.get("defaultBuffer", 4096)
        end
        self.ensureOpen("receive")
        return self.sock.receive(length)
    end

    # Reads from the connection until the peer closes or maxLength is reached.
    # @param maxLength (Optional) Hard limit on bytes to read.
    # @return String The accumulated data.
    receiveAll(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
        end
        self.ensureOpen("receiveAll")
        return self.sock.receiveAll(maxLength)
    end

    # Sends a raw byte array over the TCP connection.
    # @param data An array of integers (0-255).
    # @return Number The number of bytes sent.
    sendBytes(data)
        self.ensureOpen("sendBytes")
        return self.sock.sendBytes(data)
    end

    # Receives up to `length` bytes as a raw byte array.
    # Returns Null if the connection was closed or timed out (no exception thrown).
    # @param length (Optional) Max bytes to read.
    # @return Array | Null  An array of integers (0-255), or Null on close / timeout.
    receiveBytes(length = Null)
        if isNull(length)
            length = conf.CLIENT_CONFIG.get("defaultBuffer", 4096)
        end
        self.ensureOpen("receiveBytes")
        return self.sock.receiveBytes(length)
    end

    # Reads byte array chunks until the peer closes or maxLength is reached.
    # @param maxLength (Optional) Hard limit on bytes to read.
    # @return Array The accumulated byte array.
    receiveAllBytes(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
        end
        self.ensureOpen("receiveAllBytes")
        return self.sock.receiveAllBytes(maxLength)
    end

    # Checks if the client socket is active and connected.
    # @return Bool True if open.
    isOpen()
        return !self.closed and !isNull(self.sock) and self.sock.isOpen()
    end

    # Performs a graceful half-close of the connection.
    # @param how net.SD_RECEIVE, net.SD_SEND, or net.SD_BOTH.
    # @return Bool True on success.
    shutdown(how = sock.SD_BOTH)
        if self.closed
            return False
        end
        return self.sock.shutdown(how)
    end

    # Closes the connection and releases OS resources.
    close()
        if !self.closed
            self.closed = True
            self.sock.close()
        end
    end
end
