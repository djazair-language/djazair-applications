# tlsClient.dz — TLS Client
# Wraps the tcpClient class and upgrades the connection to TLS/SSL.
# Provides connect, send, receive, timeout, and close operations.

use assert
use bytes
import "socket.dz" as sock
import "tcpClient.dz" as tcp
use net::config as conf

let _net = __dynamic("net")

# A secure client for encrypted TLS (HTTPS/SSL) communication.
# Inherits the lifecycle and fallback characteristics of tcpClient.
class tlsClient
    
    # Initializes the TLS client.
    # @param existingSocket (Optional) A pre-connected raw socket to upgrade.
    init(existingSocket = Null)
        self.tcp = new tcp.tcpClient(existingSocket)
        self.tlsContext = Null
        self.closed = False
    end

    # Internal helper to verify the TLS connection is active.
    ensureOpen(caller)
        if self.closed
            throw "net.tlsClient.${caller}(): TLS connection is closed"
        end
    end

    # Sets the receive and send timeout for the connection.
    # @param seconds The timeout in seconds (0 = block forever).
    # @return Bool True on success.
    setTimeout(seconds)
        return self.tcp.setTimeout(seconds)
    end

    # Connects to the given host and port, then performs the TLS handshake.
    # @param host Domain name or IP address string.
    # @param port Port number (usually 443).
    # @return Bool True if connected and securely negotiated, False otherwise.
    connect(host, port)
        assert.string(host, "host")
        sock.assertPort(port, "port")
        self.ensureOpen("connect")
        
        # 1. Connect the underlying TCP socket first
        if !self.tcp.connect(host, port)
            return False
        end
        
        # 2. Upgrade the raw OS socket to TLS
        let rawSocket = self.tcp.sock.handle
        self.tlsContext = _net.ssl_connect(rawSocket, host)
        
        if isNull(self.tlsContext)
            self.tcp.close()
            return False
        end
        
        return True
    end

    # Sends data as a UTF-8 string over the encrypted TLS connection.
    # @param data The string (or auto-serializable structure) to send.
    # @return Number The number of bytes sent.
    send(data)
        self.ensureOpen("send")
        let encoded = sock.serializeForSend(data)
        let sent = _net.ssl_send(self.tlsContext, encoded)
        let expected = bytes.fromString(encoded).length()
        
        if sent != expected
            throw "net.tlsClient.send(): Failed to send ${expected} bytes"
        end
        return sent
    end

    # Receives up to `length` bytes of decrypted UTF-8 data.
    # Returns Null if the connection was closed or timed out (no exception thrown),
    # consistent with Python's sock.recv() → b"" and Node.js socket 'end' event.
    # @param length (Optional) Max bytes to read. Defaults to config buffer size.
    # @return String | Null  The received data, or Null on close / timeout.
    receive(length = Null)
        if isNull(length)
            length = conf.CLIENT_CONFIG.get("defaultBuffer", 4096)
        end
        assert.number(length, "length")
        self.ensureOpen("receive")
        
        let data = _net.ssl_recv(self.tlsContext, length)
        # Null or "" → peer closed / timeout — return Null, do NOT throw
        if isNull(data) or data == ""
            return Null
        end
        return data
    end

    # Reads from the connection until the peer closes or maxLength is reached.
    # @param maxLength (Optional) Hard limit on bytes to read.
    # @return String The accumulated data.
    receiveAll(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
        end
        assert.number(maxLength, "maxLength")
        self.ensureOpen("receiveAll")
        
        let parts = []
        let bytesSoFar = 0
        
        while bytesSoFar < maxLength
            let configured = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
            let chunkLimit = if (maxLength - bytesSoFar) < configured ? (maxLength - bytesSoFar) else configured
            
            let chunk = _net.ssl_recv(self.tlsContext, chunkLimit)
            if isNull(chunk) or chunk == ""
                break
            end
            parts.append(chunk)
            bytesSoFar += bytes.fromString(chunk).length()
        end
        return parts.join("")
    end

    # Sends a raw byte array over the encrypted TLS connection.
    # @param data An array of integers (0-255).
    # @return Number The number of bytes sent.
    sendBytes(data)
        bytes.assertByteArray(data, "data")
        self.ensureOpen("sendBytes")
        
        let sent = _net.ssl_send_bytes(self.tlsContext, data)
        if sent != data.length()
            throw "net.tlsClient.sendBytes(): Failed to send ${data.length()} bytes"
        end
        return sent
    end

    # Receives up to `length` bytes as a decrypted raw byte array.
    # Returns Null if the connection was closed or timed out (no exception thrown).
    # @param length (Optional) Max bytes to read.
    # @return Array | Null  An array of integers (0-255), or Null on close / timeout.
    receiveBytes(length = Null)
        if isNull(length)
            length = conf.CLIENT_CONFIG.get("defaultBuffer", 4096)
        end
        assert.number(length, "length")
        self.ensureOpen("receiveBytes")
        
        let data = _net.ssl_recv_bytes(self.tlsContext, length)
        # Null or empty array → peer closed / timeout — return Null, do NOT throw
        if isNull(data) or (isArray(data) and data.length() == 0)
            return Null
        end
        return data
    end

    # Reads byte array chunks until the peer closes or maxLength is reached.
    # @param maxLength (Optional) Hard limit on bytes to read.
    # @return Array The accumulated byte array.
    receiveAllBytes(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
        end
        assert.number(maxLength, "maxLength")
        self.ensureOpen("receiveAllBytes")
        
        let result = []
        let remaining = maxLength
        
        while remaining > 0
            let configured = conf.CLIENT_CONFIG.get("maxSend", sock.MAX_SEND)
            let chunkLimit = if remaining < configured ? remaining else configured
            
            let chunk = _net.ssl_recv_bytes(self.tlsContext, chunkLimit)
            if isNull(chunk) or chunk.length() == 0
                break
            end
            result.extend(chunk)
            remaining -= chunk.length()
        end
        
        return result
    end

    # Checks if the TLS connection is fully established and active.
    # @return Bool True if open.
    isOpen()
        return !self.closed and !isNull(self.tlsContext)
    end

    # Performs a graceful half-close of the connection.
    # @param how net.SD_RECEIVE, net.SD_SEND, or net.SD_BOTH.
    # @return Bool True on success.
    shutdown(how = sock.SD_BOTH)
        return self.tcp.shutdown(how)
    end

    # Shuts down the TLS session and closes the underlying OS socket.
    close()
        self.closed = True
        if !isNull(self.tlsContext)
            _net.ssl_close(self.tlsContext)
            self.tlsContext = Null
        end
        self.tcp.close()
    end
end
