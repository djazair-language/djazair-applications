# tcp_server.dz — TCP Server
# Accepts incoming TCP connections and dispatches them to a handler function.

use assert
use thread
import "socket.dz" as sock
import "tcpClient.dz" as tcpCli
use net::config as conf
use net::poller as pollerMod

# A non-blocking TCP server that accepts connections and spawns clients.
class tcpServer
    
    # Initializes the TCP server.
    # @param handler A callback function `fn(client, ip, port)` called for each new connection.
    #                `client` is a `net.tcpClient` instance.
    # @param options (Optional) Map of configurations like `{"timeout": 15, "deferAccept": True}`.
    init(handler, options = {})
        assert.function(handler, "handler")
        self.handler = handler
        self.running = False
        self.timeout = options.get("timeout", options.get("defaultTimeout", conf.SERVER_CONFIG["defaultTimeout"]))
        # Defer dispatching to handler until the client sends data
        self.deferAccept = options.get("deferAccept", False)
        self.sock = Null
    end

    # Sets the connection timeout in seconds for newly accepted clients.
    # @param seconds The timeout in seconds (0 = block forever).
    setTimeout(seconds)
        assert.number(seconds, "seconds")
        self.timeout = seconds
    end

    # Binds to the specified port and host, and starts accepting connections.
    # This method blocks the calling thread indefinitely until closed,
    # but uses an I/O Poller so it doesn't hard-block the CPU.
    # It also monitors accepted clients and only dispatches them to the handler
    # when they have data ready to read, solving the browser pre-connect issue.
    #
    # @param port (Optional) Port to listen on. Defaults to config.defaultPort.
    # @param host (Optional) Host interface to bind to. Defaults to config.defaultHost.
    listen(port = Null, host = Null)
        if isNull(port) port = conf.SERVER_CONFIG["defaultPort"] end
        if isNull(host) host = conf.SERVER_CONFIG["defaultHost"] end
        
        assert.number(port, "port")
        assert.string(host, "host")
        
        # Literal IPv6 bind addresses require an IPv6 socket.
        let family = sock.familyForAddress(host)
        
        self.sock = new sock.socket(family, sock.SOCK_STREAM, 0)
        self.sock.bind(host, port)
        self.sock.listen(conf.SERVER_CONFIG["defaultBacklog"])
        
        # Make the listening socket non-blocking so accept() doesn't hang.
        self.sock.setBlocking(False)
        
        let poller = new pollerMod.poller()
        poller.register(self.sock, "r")
        
        self.running = True
        
        # Track pending clients waiting for their first byte of data
        # Mapping: client.sock.handle -> {"client": tcpClient, "ip": ip, "port": port}
        let pendingClients = {}
        
        while self.running and !thread.stopRequested()
            # Poll for readiness with a small timeout
            let ready = poller.poll(0.5)
            
            # 1. Handle New Connections
            if ready["read"].contains(self.sock.handle)
                let clientData = Null
                let acceptOk = True
                
                try
                    clientData = self.sock.accept()
                catch e
                    let errStr = str(e)
                    if errStr.contains("Socket is closed") or !self.running
                        acceptOk = False
                    else
                        print("[net.tcpServer] accept error: ${errStr}")
                    end
                end
                
                if !acceptOk
                    break
                end
                
                if !isNull(clientData)
                    let client = new tcpCli.tcpClient(clientData["socket"])
                    
                    if self.deferAccept
                        # Keep it non-blocking while waiting for data
                        client.sock.setBlocking(False)
                        
                        # Register the new client in the Poller for reading
                        poller.register(client.sock, "r")
                        
                        # Store client data in the pending map
                        pendingClients[client.sock.handle] = {
                            "client": client,
                            "ip": clientData["ip"],
                            "port": clientData["port"]
                        }
                    else
                        # Dispatch immediately
                        client.sock.setBlocking(True)
                        try
                            if self.timeout > 0
                                client.setTimeout(self.timeout)
                            end
                            self.handler(client, clientData["ip"], clientData["port"])
                        catch e
                            let errStr = str(e)
                            if !errStr.contains("socket is closed") and !errStr.contains("Socket is closed")
                                print("[net.tcpServer] handler error: ${errStr}")
                            end
                        finally
                            if client.isOpen()
                                client.close()
                            end
                        end
                    end
                end
            end
            
            # 2. Handle Pending Clients that are ready to read
            for handle in ready["read"]
                if handle != self.sock.handle and pendingClients.has(handle)
                    let pClient = pendingClients[handle]
                    let client = pClient["client"]
                    
                    # Unregister from Poller and remove from pending map
                    poller.unregister(client.sock)
                    pendingClients.pop(handle)
                    
                    # Revert to blocking mode for the handler
                    client.sock.setBlocking(True)
                    
                    # Dispatch to handler
                    try
                        if self.timeout > 0
                            client.setTimeout(self.timeout)
                        end
                        self.handler(client, pClient["ip"], pClient["port"])
                    catch e
                        let errStr = str(e)
                        if !errStr.contains("socket is closed") and !errStr.contains("Socket is closed")
                            print("[net.tcpServer] handler error: ${errStr}")
                        end
                    finally
                        if client.isOpen()
                            client.close()
                        end
                    end
                end
            end
        end
        
        # Cleanup pending clients on shutdown.
        self.running = False
        for handle, pClient in pendingClients
            try
                if pClient["client"].isOpen()
                    pClient["client"].close()
                end
            catch e
            end
        end
        if !isNull(self.sock) and self.sock.isOpen()
            self.sock.close()
        end
    end

    # Stops the server and closes the listening socket.
    close()
        self.running = False
        if !isNull(self.sock)
            self.sock.close()
        end
    end
end
