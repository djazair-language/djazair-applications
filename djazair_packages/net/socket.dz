# socket.dz — Low-level BSD socket wrapper.
# String APIs use UTF-8 strings; use the *Bytes variants for arbitrary data.

use assert
use bytes
use json
use net::config as conf

let _net = __dynamic("net")

# ── Protocol Constants ───────────────────────────────────────────────────────

# Address families
let AF_INET   = 2
let AF_INET6  = _net.get_af_inet6()
let AF_UNSPEC = 0

# Socket types
let SOCK_STREAM = 1
let SOCK_DGRAM  = 2

# Protocols
let IPPROTO_TCP = 6
let IPPROTO_UDP = 17

# Shutdown options
let SD_RECEIVE = 0
let SD_SEND    = 1
let SD_BOTH    = 2

# Snapshot constants are retained for backwards compatibility.
# Runtime methods consult config directly so configuration changes apply instantly.
let MAX_SEND        = conf.CLIENT_CONFIG["maxSend"]
let DEFAULT_HOST    = conf.SERVER_CONFIG["defaultHost"]
let DEFAULT_PORT    = conf.SERVER_CONFIG["defaultPort"]
let DEFAULT_BACKLOG = conf.SERVER_CONFIG["defaultBacklog"]
let DEFAULT_TIMEOUT = conf.SERVER_CONFIG["defaultTimeout"]
let DEFAULT_BUFFER  = conf.SERVER_CONFIG["defaultBuffer"]
let MIN_BUFFER_SIZE = conf.SERVER_CONFIG["minBufferSize"]
let MAX_BUFFER_SIZE = conf.SERVER_CONFIG["maxBufferSize"]

# ── Shared Helpers ───────────────────────────────────────────────────────────

# Asserts that the given value is a valid TCP/UDP port (0-65535).
fn assertPort(port, name)
    if !isInt(port) or port < 0 or port > 65535
        throw "net.socket(): ${name} must be an Int between 0 and 65535, got ${port}"
    end
end

# Asserts that the length is a positive integer.
fn assertLength(length, name)
    if !isInt(length) or length <= 0
        throw "net.socket(): ${name} must be a positive Int"
    end
end

# Formats an IP and port for error messages.
fn formatAddr(host, port) => "${host}:${port}"

# Returns the correct address family for a given IP string.
fn familyForAddress(address)
    return if ":" in address ? AF_INET6 else AF_INET
end

# Serializes data for sending over the socket.
# Maps and Arrays are automatically converted to JSON strings.
# Other types are converted to strings via `str()`.
fn serializeForSend(data)
    if isNull(data) return "" end
    if isMap(data) or isArray(data)
        return json.encode(data)
    end
    return str(data)
end

# ── Raw Socket Class ─────────────────────────────────────────────────────────

# A direct wrapper over a native OS socket descriptor.
class socket
    # Initializes a new socket.
    # Passing all Null creates an empty wrapper used internally by accept().
    init(domain, type, proto)
        if isNull(domain) and isNull(type) and isNull(proto)
            self.handle = Null
            return
        end
        if isNull(domain) or isNull(type) or isNull(proto)
            throw "net.socket(): domain, type, and protocol are all required"
        end
        assert.number(domain, "domain")
        assert.number(type, "type")
        assert.number(proto, "protocol")

        self.handle = _net.socket_create(domain, type, proto)
        if isNull(self.handle)
            throw "net.socket(): failed to create socket"
        end
    end

    # Checks if the underlying OS socket handle is present.
    isOpen()
        return !isNull(self.handle)
    end

    # Throws an exception if the socket is closed.
    ensureOpen(caller)
        if !self.isOpen()
            throw "net.socket.${caller}(): socket is closed"
        end
    end

    # Connects the socket to a remote host and port.
    connect(host, port)
        assert.string(host, "host")
        assertPort(port, "port")
        self.ensureOpen("connect")
        if !_net.socket_connect(self.handle, host, port)
            throw "net.socket.connect(): failed to connect to ${formatAddr(host, port)}"
        end
        return True
    end

    # Binds the socket to a local host and port.
    bind(host, port)
        assert.string(host, "host")
        assertPort(port, "port")
        self.ensureOpen("bind")
        if !_net.socket_bind(self.handle, host, port)
            throw "net.socket.bind(): failed to bind to ${formatAddr(host, port)}"
        end
        return True
    end

    # Marks the socket as a server that listens for incoming connections.
    listen(backlog)
        if !isInt(backlog) or backlog < 0
            throw "net.socket.listen(): backlog must be a non-negative Int"
        end
        self.ensureOpen("listen")
        if !_net.socket_listen(self.handle, backlog)
            throw "net.socket.listen(): failed to listen (backlog=${backlog})"
        end
        return True
    end

    # Accepts the next incoming connection.
    # Returns a Map: {"socket": net.socket, "ip": String, "port": Number}
    accept()
        self.ensureOpen("accept")
        let info = _net.socket_accept(self.handle)
        if isNull(info)
            return Null
        end

        let client = new socket(Null, Null, Null)
        client.handle = info["socket"]
        return {"socket": client, "ip": info["ip"], "port": info["port"]}
    end

    # Sends data over the socket (UTF-8 encoded).
    # Re-tries internally until all bytes are sent.
    send(data)
        self.ensureOpen("send")
        let encoded = serializeForSend(data)
        let sent = _net.socket_send(self.handle, encoded)
        let expected = bytes.fromString(encoded).length()
        if sent != expected
            throw "net.socket.send(): failed to send ${expected} bytes"
        end
        return sent
    end

    # Receives up to `length` bytes from the socket as a string.
    # Returns Null if the connection was closed or timed out (no exception),
    # matching the behaviour of Python's sock.recv() → b"" and Node.js 'end' event.
    receive(length)
        assertLength(length, "length")
        self.ensureOpen("receive")
        let data = _net.socket_recv(self.handle, length)
        # Null  → peer closed / timeout  (return Null, do NOT throw)
        # ""    → zero-length read        (treat as closed as well)
        if isNull(data) or data == ""
            return Null
        end
        return data
    end

    # Reads from the socket repeatedly until the peer closes or `maxLength` is reached.
    receiveAll(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", MAX_SEND)
        end
        assertLength(maxLength, "maxLength")
        self.ensureOpen("receiveAll")

        let parts = []
        let received = 0
        while received < maxLength
            # Respect config limit for the max read chunk
            let configured = conf.CLIENT_CONFIG.get("maxSend", MAX_SEND)
            if !isNumber(configured) or configured <= 0
                throw "net.socket.receiveAll(): config.maxSend must be positive"
            end
            
            let chunkLimit = if (maxLength - received) < configured ? (maxLength - received) else configured
            let chunk = _net.socket_recv(self.handle, chunkLimit)
            
            if isNull(chunk) or chunk == ""
                break
            end
            parts.append(chunk)
            received += bytes.fromString(chunk).length()
        end
        return parts.join("")
    end

    # Sends an array of bytes (integers 0-255).
    sendBytes(data)
        bytes.assertByteArray(data, "data")
        self.ensureOpen("sendBytes")
        let sent = _net.socket_send_bytes(self.handle, data)
        if sent != data.length()
            throw "net.socket.sendBytes(): failed to send ${data.length()} bytes"
        end
        return sent
    end

    # Receives up to `length` bytes from the socket as a byte array.
    # Returns Null if the connection was closed or timed out (no exception).
    receiveBytes(length)
        assertLength(length, "length")
        self.ensureOpen("receiveBytes")
        let data = _net.socket_recv_bytes(self.handle, length)
        if isNull(data) or (isArray(data) and data.length() == 0)
            return Null
        end
        return data
    end

    # Reads byte array chunks repeatedly until the peer closes or `maxLength` is reached.
    receiveAllBytes(maxLength = Null)
        if isNull(maxLength)
            maxLength = conf.CLIENT_CONFIG.get("maxSend", MAX_SEND)
        end
        assertLength(maxLength, "maxLength")
        self.ensureOpen("receiveAllBytes")

        let result = []
        let remaining = maxLength
        while remaining > 0
            let configured = conf.CLIENT_CONFIG.get("maxSend", MAX_SEND)
            if !isNumber(configured) or configured <= 0
                throw "net.socket.receiveAllBytes(): config.maxSend must be positive"
            end
            let chunkLimit = if remaining < configured ? remaining else configured
            
            let chunk = _net.socket_recv_bytes(self.handle, chunkLimit)
            if isNull(chunk) or chunk.length() == 0
                break
            end
            result.extend(chunk)
            remaining -= chunk.length()
        end
        return result
    end

    # Sends a datagram (UDP) to a specific destination.
    sendto(data, host, port)
        assert.string(host, "host")
        assertPort(port, "port")
        self.ensureOpen("sendto")

        let encoded = serializeForSend(data)
        let sent = _net.socket_sendto(self.handle, encoded, host, port)
        let expected = bytes.fromString(encoded).length()
        if sent != expected
            throw "net.socket.sendto(): failed to send to ${formatAddr(host, port)}"
        end
        return sent
    end

    # Receives a datagram (UDP). Returns a Map {"data": String, "ip": String, "port": Number}.
    receiveFrom(length)
        assertLength(length, "length")
        self.ensureOpen("receiveFrom")
        let data = _net.socket_recvfrom(self.handle, length)
        # Null → timeout or no data — not an error for UDP, return Null
        return data
    end

    # Sends a byte array datagram (UDP) to a specific destination.
    sendBytesTo(data, host, port)
        bytes.assertByteArray(data, "data")
        assert.string(host, "host")
        assertPort(port, "port")
        self.ensureOpen("sendBytesTo")

        let sent = _net.socket_sendto_bytes(self.handle, data, host, port)
        if sent != data.length()
            throw "net.socket.sendBytesTo(): failed to send to ${formatAddr(host, port)}"
        end
        return sent
    end

    # Receives a byte array datagram (UDP).
    # Returns Null on timeout or no data — not an error for UDP.
    receiveBytesFrom(length)
        assertLength(length, "length")
        self.ensureOpen("receiveBytesFrom")
        let data = _net.socket_recvfrom_bytes(self.handle, length)
        return data
    end

    # Performs a graceful half-close of the connection.
    shutdown(how = SD_BOTH)
        if !isInt(how) or how < SD_RECEIVE or how > SD_BOTH
            throw "net.socket.shutdown(): how must be an Int: SD_RECEIVE, SD_SEND, or SD_BOTH"
        end
        if isNull(self.handle)
            return False
        end
        return _net.socket_shutdown(self.handle, how)
    end

    # Closes the OS socket completely.
    close()
        if !isNull(self.handle)
            _net.socket_close(self.handle)
            self.handle = Null
        end
    end

    # Sets the receive and send timeout for the socket.
    setTimeout(seconds)
        assert.number(seconds, "seconds")
        if seconds < 0
            throw "net.socket.setTimeout(): seconds must not be negative"
        end
        self.ensureOpen("setTimeout")
        if !_net.socket_set_timeout(self.handle, seconds)
            throw "net.socket.setTimeout(): failed to set timeout to ${seconds}s"
        end
        return True
    end
    
    # Sets the socket blocking mode.
    # @param blocking Boolean flag to enable or disable blocking
    setBlocking(blocking)
        assert.boolean(blocking, "blocking")
        self.ensureOpen("setBlocking")
        if !_net.socket_set_blocking(self.handle, blocking)
            throw "net.socket.setBlocking(): failed to set blocking mode to ${blocking}"
        end
        return True
    end
end
