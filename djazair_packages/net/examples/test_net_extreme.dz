# test_net_extreme.dz — أمثلة قاسية لمكتبة net
# تغطي: TCP/UDP تحت ضغط، TLS/HTTPS، Poller، DNS، URLSearchParams، Raw Socket، Large Data

use net
use thread
use process
use bytes
use json

print("=== Net Extreme Tests ===\n")

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed += 1
    else
        print("  FAIL: ${name}")
        failed += 1
    end
end

fn closeWorkers(workers)
    for w in workers
        w.close(2)
    end
end

# ═══════════════════════════════════════════════════════════════
# PORT RANGE: 19700 – 19799
# ═══════════════════════════════════════════════════════════════
let P0  = 19700
let P1  = 19701
let P2  = 19702
let P3  = 19703
let P4  = 19704
let P5  = 19705
let P6  = 19706
let P7  = 19707
let P8  = 19708
let P9  = 19709
let P10 = 19710
let P11 = 19711
let P12 = 19712
let P13 = 19713
let P14 = 19714
let P15 = 19715
let P16 = 19716
let P17 = 19717
let P18 = 19718
let P19 = 19719
let P20 = 19720


# ══════════════════════════════════════════════════════════════════════════════
# TEST 1: URL Parsing Gauntlet — تحليل URL معقدة
# ══════════════════════════════════════════════════════════════════════════════
print("--- TEST 1: URL Parsing Gauntlet ---")

let u1 = new net.url("https://user:p%40ss@api.djazair.dz:8443/v3/users/42?role=admin&active=true&limit=100#profile")
test("URL protocol https:", u1.protocol == "https:")
test("URL hostname", u1.hostname == "api.djazair.dz")
test("URL port 8443", u1.port == 8443)
test("URL pathname", u1.pathname == "/v3/users/42")
test("URL hash #profile", u1.hash == "#profile")
test("URL search", u1.search.contains("role=admin"))
test("URL searchParams role", u1.searchParams.get("role") == "admin")
test("URL searchParams active", u1.searchParams.get("active") == "true")
test("URL searchParams limit", u1.searchParams.get("limit") == "100")
test("URL username", u1.username == "user")
test("URL origin", u1.origin() == "https://api.djazair.dz:8443")
test("URL href contains hostname", u1.href().contains("api.djazair.dz"))
test("URL toString contains pathname", u1.toString().contains("/v3/users/42"))

let u2 = new net.url("http://localhost/no-port")
test("URL default port empty or 80", u2.port == "" or u2.port == 80)

let u3 = new net.url("ftp://files.example.com/pub/data.zip")
test("URL ftp protocol", u3.protocol == "ftp:")
test("URL ftp hostname", u3.hostname == "files.example.com")

let parsedFromNet = net.parseURL("ws://realtime.djazair.dz:9000/socket?room=42")
test("parseURL ws protocol", parsedFromNet.protocol == "ws:")
test("parseURL room param", parsedFromNet.searchParams.get("room") == "42")


# ══════════════════════════════════════════════════════════════════════════════
# TEST 2: URLSearchParams — عمليات CRUD كاملة
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 2: URLSearchParams CRUD ---")

let sp = new net.urlSearchParams("q=djazair&lang=ar&page=1&limit=20&sort=asc")
test("SP get q", sp.get("q") == "djazair")
test("SP get lang", sp.get("lang") == "ar")
test("SP get page", sp.get("page") == "1")
test("SP has limit", sp.has("limit"))
test("SP keys count", sp.keys().length() == 5)
test("SP values count", sp.values().length() == 5)
test("SP entries count", sp.entries().length() == 5)
test("SP get missing", isNull(sp.get("nonexistent")))

sp.set("page", "99")
test("SP set replaces", sp.get("page") == "99")

sp.append("tag", "network")
test("SP append new key", sp.has("tag") and sp.get("tag") == "network")

sp.delete("sort")
test("SP delete removes key", !sp.has("sort"))

let sp2 = new net.urlSearchParams("?key=value&foo=bar")
test("SP strips leading ?", sp2.get("key") == "value")
test("SP strips ? foo", sp2.get("foo") == "bar")

let sp3 = new net.urlSearchParams("empty=")
test("SP empty string value", sp3.get("empty") == "")

let sp4 = new net.urlSearchParams("")
test("SP empty string — no keys", sp4.keys().length() == 0)
test("SP empty string — get returns Null", isNull(sp4.get("anything")))


# ══════════════════════════════════════════════════════════════════════════════
# TEST 3: URL Encoding/Decoding — دورة ترميز كاملة
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 3: URL Encoding Roundtrip ---")

test("urlEncode plain text", net.urlEncode("djazair") == "djazair")
test("urlEncode space → +", net.urlEncode("hello world") == "hello+world")
test("urlEncode & = special", net.urlEncode("a&b=c") == "a%26b%3Dc")
test("urlEncode empty", net.urlEncode("") == "")
test("urlEncode Arabic phrase", net.urlEncode("لغة جزائر").length() > 0)

test("urlDecode plain", net.urlDecode("djazair") == "djazair")
test("urlDecode + → space", net.urlDecode("hello+world") == "hello world")
test("urlDecode %26%3D", net.urlDecode("a%26b%3Dc") == "a&b=c")
test("urlDecode empty", net.urlDecode("") == "")

let complexStr = "Djazair Language v3.0 — شبكة & أمان!"
test("urlEncode/Decode roundtrip complex", net.urlDecode(net.urlEncode(complexStr)) == complexStr)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 4: TCP Echo تحت ضغط — 20 اتصال متتالي
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 4: TCP Echo Stress — 20 connections ---")

let tTcpFlood = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    let data = client.receive(4096)
    if !isNull(data)
        client.send('ECHO:' + data)
    end
    client.close()
end)
srv.listen(${P0})
")
process.sleep(0.5)

let tcpFloodOk = 0
for i in 0..20
    let cl = new net.tcpClient()
    if cl.connect("127.0.0.1", P0)
        cl.send("MSG_" + str(i))
        let r = cl.receive(4096)
        if r == "ECHO:MSG_" + str(i)
            tcpFloodOk += 1
        end
        cl.close()
    end
end
test("TCP flood — ≥15/20 connections correct", tcpFloodOk >= 15)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 5: TCP — نقل بيانات ضخمة (Large Stream Transfer)
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 5: TCP Large Data Transfer ---")

let tLargeData = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    let data = client.receiveAll()
    client.send('LEN:' + str(data.length()) + ':DONE')
    client.close()
end)
srv.listen(${P1})
")
process.sleep(0.5)

let bigData = ""
for i in 0..200
    bigData = bigData + "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"  # 36 chars × 200 = 7200 bytes
end

let clBig = new net.tcpClient()
clBig.connect("127.0.0.1", P1)
clBig.send(bigData)
clBig.shutdown(net.SD_SEND)
let rBig = clBig.receive(4096)
clBig.close()
test("TCP large transfer — response has LEN:", rBig.contains("LEN:"))
test("TCP large transfer — length > 6000", rBig.contains("LEN:") and num(rBig.split(":")[1]) > 6000)
test("TCP large transfer — ends with DONE", rBig.contains("DONE"))


# ══════════════════════════════════════════════════════════════════════════════
# TEST 6: TCP Binary Data — إرسال واستقبال بايتات خام
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 6: TCP Binary Roundtrip ---")

let tBin = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    let data = client.receiveBytes(4096)
    client.sendBytes(data)
    client.close()
end)
srv.listen(${P2})
")
process.sleep(0.5)

let rawBytes = [0, 1, 2, 3, 127, 128, 200, 255, 65, 90]  # مختلط: ASCII, control, high bytes
let clBin = new net.tcpClient()
clBin.connect("127.0.0.1", P2)
clBin.sendBytes(rawBytes)
let rBin = clBin.receiveBytes(4096)
clBin.close()

test("Binary roundtrip — byte[0] == 0", rBin[0] == 0)
test("Binary roundtrip — byte[4] == 127", rBin[4] == 127)
test("Binary roundtrip — byte[7] == 255", rBin[7] == 255)
test("Binary roundtrip — byte[8] == 65 (A)", rBin[8] == 65)
test("Binary roundtrip — byte[9] == 90 (Z)", rBin[9] == 90)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 7: TCP JSON Protocol — تبادل رسائل JSON عبر TCP
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 7: TCP JSON Protocol ---")

let tJsonTcp = thread.spawnCode("
use net
use json
let srv = new net.tcpServer(fn(client, ip, port)
    let raw = client.receive(8192)
    let msg = json.decode(raw)
    let op = msg['op']
    let a = msg['a']
    let b = msg['b']
    let result = 0
    if op == 'add' result = a + b end
    if op == 'mul' result = a * b end
    if op == 'sub' result = a - b end
    client.send(json.encode({'op': op, 'result': result, 'ok': True}))
    client.close()
end)
srv.listen(${P3})
")
process.sleep(0.5)

let ops = [
    {"op": "add", "a": 100, "b": 200},
    {"op": "mul", "a": 7, "b": 6},
    {"op": "sub", "a": 1000, "b": 58}
]
let expectedResults = [300, 42, 942]
let jsonTcpOk = 0

# عملية add
let clJ0 = new net.tcpClient()
if clJ0.connect("127.0.0.1", P3)
    clJ0.send(json.encode({"op": "add", "a": 100, "b": 200}))
    let rJ0 = clJ0.receive(4096)
    clJ0.close()
    if !isNull(rJ0)
        let rJ0Obj = json.decode(rJ0)
        if rJ0Obj["result"] == 300 and rJ0Obj["ok"] == True
            jsonTcpOk += 1
        end
    end
end

# عملية mul
let clJ1 = new net.tcpClient()
if clJ1.connect("127.0.0.1", P3)
    clJ1.send(json.encode({"op": "mul", "a": 7, "b": 6}))
    let rJ1 = clJ1.receive(4096)
    clJ1.close()
    if !isNull(rJ1)
        let rJ1Obj = json.decode(rJ1)
        if rJ1Obj["result"] == 42 and rJ1Obj["ok"] == True
            jsonTcpOk += 1
        end
    end
end

# عملية sub
let clJ2 = new net.tcpClient()
if clJ2.connect("127.0.0.1", P3)
    clJ2.send(json.encode({"op": "sub", "a": 1000, "b": 58}))
    let rJ2 = clJ2.receive(4096)
    clJ2.close()
    if !isNull(rJ2)
        let rJ2Obj = json.decode(rJ2)
        if rJ2Obj["result"] == 942 and rJ2Obj["ok"] == True
            jsonTcpOk += 1
        end
    end
end

test("TCP JSON Protocol — 3 ops correct", jsonTcpOk == 3)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 8: TCP Multi-message على نفس الاتصال
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 8: TCP Multi-message Same Connection ---")

let tMultiMsg = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    let i = 0
    while i < 5
        let msg = client.receive(1024)
        if isNull(msg) break end
        client.send('ACK:' + msg)
        i += 1
    end
    client.close()
end)
srv.listen(${P4})
")
process.sleep(0.5)

let clMulti = new net.tcpClient()
clMulti.connect("127.0.0.1", P4)
let multiOk = 0
for i in 0..5
    clMulti.send("MSG" + str(i))
    let ack = Null
    try
        ack = clMulti.receive(1024)
    catch e end
    if ack == "ACK:MSG" + str(i)
        multiOk += 1
    end
end
clMulti.close()
test("TCP multi-message — 5 ACKs correct", multiOk == 5)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 9: TCP Client Info — ip و port
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 9: TCP Client Info ---")

let tInfo = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    client.send('IP=' + ip + '|PORT=' + str(port))
    client.close()
end)
srv.listen(${P5})
")
process.sleep(0.5)

let clInfo = new net.tcpClient()
clInfo.connect("127.0.0.1", P5)
let rInfo = clInfo.receive(1024)
clInfo.close()
test("TCP client info — IP present", rInfo.contains("IP=127.0.0.1"))
test("TCP client info — PORT present", rInfo.contains("PORT="))


# ══════════════════════════════════════════════════════════════════════════════
# TEST 10: TCP Connection Failure — الاتصال بمنفذ مغلق
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 10: TCP Connection Failure ---")

let clFail = new net.tcpClient()
let failResult = clFail.connect("127.0.0.1", 19998)
test("TCP connect to closed port — returns False", failResult == False)
clFail.close()


# ══════════════════════════════════════════════════════════════════════════════
# TEST 11: TCP Shutdown Half-close
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 11: TCP Half-close (Shutdown) ---")

let tShutdown = thread.spawnCode("
use net
let srv = new net.tcpServer(fn(client, ip, port)
    client.send('part1')
    client.shutdown(net.SD_SEND)
    client.close()
end)
srv.listen(${P6})
")
process.sleep(0.5)

let clSD = new net.tcpClient()
clSD.connect("127.0.0.1", P6)
let rSD = clSD.receiveAll()
clSD.close()
test("TCP half-close — data received before shutdown", rSD == "part1")


# ══════════════════════════════════════════════════════════════════════════════
# TEST 12: UDP Echo Stress — 10 رسائل UDP
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 12: UDP Echo Stress ---")

let tUdp = thread.spawnCode("
use net
let srv = new net.udpServer(fn(data, ip, port)
    srv.reply('UDP_ECHO:' + data, ip, port)
end)
srv.listen(${P7})
srv.setTimeout(0.2)
")
process.sleep(0.5)

let udpOk = 0
for i in 0..10
    let ucl = new net.udpClient()
    ucl.send("DGRAM_" + str(i), "127.0.0.1", P7)
    ucl.setTimeout(2)
    let ur = ucl.receive()
    ucl.close()
    if ur == "UDP_ECHO:DGRAM_" + str(i)
        udpOk += 1
    end
end
test("UDP stress — ≥7/10 messages echoed", udpOk >= 7)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 13: UDP receiveFrom — التحقق من IP وPort المرسل
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 13: UDP receiveFrom with sender info ---")

let tUdpFrom = thread.spawnCode("
use net
let srv = new net.udpServer(fn(data, ip, port)
    srv.reply('FROM:' + ip + ':' + str(port) + ':' + data, ip, port)
end)
srv.listen(${P8})
srv.setTimeout(0.2)
")
process.sleep(0.5)

let ucl2 = new net.udpClient()
ucl2.send("hello-udp", "127.0.0.1", P8)
ucl2.setTimeout(2)
let ur2 = ucl2.receiveFrom()
ucl2.close()
test("UDP receiveFrom — has data key", ur2 != Null and !isNull(ur2["data"]))
test("UDP receiveFrom — has ip key", ur2 != Null and ur2["ip"] == "127.0.0.1")
test("UDP receiveFrom — data contains original msg", ur2 != Null and ur2["data"].contains("hello-udp"))
test("UDP receiveFrom — data contains FROM prefix", ur2 != Null and ur2["data"].contains("FROM:"))


# ══════════════════════════════════════════════════════════════════════════════
# TEST 14: UDP Binary Data
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 14: UDP Binary Data ---")

let tUdpBin = thread.spawnCode("
use net
let srv = new net.udpServer(fn(data, ip, port)
    srv.reply(data, ip, port)
end)
srv.listen(${P9})
srv.setTimeout(0.2)
")
process.sleep(0.5)

let ucl3 = new net.udpClient()
ucl3.sendBytesTo([68, 90, 65, 73, 82], "127.0.0.1", P9)  # DZAIR
ucl3.setTimeout(2)
let ur3 = ucl3.receiveFrom()
ucl3.close()
test("UDP binary — data received", ur3 != Null and ur3["data"].length() > 0)
test("UDP binary — data is DZAIR", ur3 != Null and ur3["data"] == "DZAIR")


# ══════════════════════════════════════════════════════════════════════════════
# TEST 15: Raw Socket — إنشاء وإغلاق مقابس خام
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 15: Raw Socket Lifecycle ---")

let sockTcp = new net.socket(net.AF_INET, net.SOCK_STREAM, net.IPPROTO_TCP)
test("Raw TCP socket — isOpen", sockTcp.isOpen())
sockTcp.close()
test("Raw TCP socket — closed", !sockTcp.isOpen())

let sockUdp = new net.socket(net.AF_INET, net.SOCK_DGRAM, net.IPPROTO_UDP)
test("Raw UDP socket — isOpen", sockUdp.isOpen())
sockUdp.close()
test("Raw UDP socket — closed", !sockUdp.isOpen())

# إنشاء واغلاق متعدد
let sockCount = 0
for i in 0..10
    let s = new net.socket(net.AF_INET, net.SOCK_STREAM, net.IPPROTO_TCP)
    if s.isOpen()
        sockCount += 1
        s.close()
    end
end
test("Raw socket — ≥8/10 create/close cycles", sockCount >= 8)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 16: TLS Client — الاتصال بخادم خارجي عبر TLS/HTTPS
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 16: TLS Client (HTTPS raw) ---")

let tls = new net.tlsClient()
let tlsOk = False
try
    let connected = tls.connect("example.com", 443)
    if connected
        tls.send("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
        let response = tls.receiveAll()
        if response.length() > 0 and response.contains("HTTP/")
            tlsOk = True
        end
        test("TLS connect example.com:443", True)
        test("TLS received HTTP response", response.contains("HTTP/"))
        test("TLS response length > 100", response.length() > 100)
        test("TLS response has Content-Type or Date", response.contains("Content-Type") or response.contains("Date"))
    else
        print("  SKIP: TLS connect failed (no internet?)")
    end
catch e
    print("  SKIP: TLS error → " + str(e))
finally
    tls.close()
end


