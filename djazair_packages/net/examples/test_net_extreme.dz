# ══════════════════════════════════════════════════════════════════════════════
# TEST 20: Global Config — setServerConfig / setClientConfig
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 20: Global Net Config ---")

net.setServerConfig({"defaultPort": 9999, "defaultTimeout": 42})
let srvWithConf = new net.tcpServer(fn(c, ip, p) end)
test("setServerConfig — timeout applied", srvWithConf.timeout == 42)

let srvWithOpts = new net.tcpServer(fn(c, ip, p) end, {"defaultTimeout": 99})
test("Server explicit opts override", srvWithOpts.timeout == 99)

let clientCfgOk = True
try
    net.setClientConfig({"timeout": 15.0})
catch e
    clientCfgOk = False
end
test("setClientConfig — no error", clientCfgOk)


# ══════════════════════════════════════════════════════════════════════════════
# TEST 21: TCP Concurrent Multi-Server Gauntlet — 5 خوادم TCP بالتوازي
# ══════════════════════════════════════════════════════════════════════════════
print("\n--- TEST 21: TCP 5 Concurrent Servers ---")

let tM0 = thread.spawnCode("use net\nlet s=new net.tcpServer(fn(c,ip,p) c.send('S0') c.close() end)\ns.listen(${P10})")
let tM1 = thread.spawnCode("use net\nlet s=new net.tcpServer(fn(c,ip,p) c.send('S1') c.close() end)\ns.listen(${P11})")
let tM2 = thread.spawnCode("use net\nlet s=new net.tcpServer(fn(c,ip,p) c.send('S2') c.close() end)\ns.listen(${P12})")
let tM3 = thread.spawnCode("use net\nlet s=new net.tcpServer(fn(c,ip,p) c.send('S3') c.close() end)\ns.listen(${P13})")
let tM4 = thread.spawnCode("use net\nlet s=new net.tcpServer(fn(c,ip,p) c.send('S4') c.close() end)\ns.listen(${P14})")
process.sleep(1)

let multiOk = 0
for i in 0..5
    let cl = new net.tcpClient()
    let port = P10 + i
    if cl.connect("127.0.0.1", port)
        let r = cl.receive(1024)
        if r == "S" + str(i)
            multiOk += 1
        end
        cl.close()
    end
end
test("TCP 5 concurrent servers — all responded", multiOk == 5)


