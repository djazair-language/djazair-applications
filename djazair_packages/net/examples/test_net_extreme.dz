test("AF_UNSPEC == 0", net.AF_UNSPEC == 0)
test("SOCK_STREAM == 1", net.SOCK_STREAM == 1)
test("SOCK_DGRAM == 2", net.SOCK_DGRAM == 2)
test("SD_RECEIVE == 0", net.SD_RECEIVE == 0)
test("SD_SEND == 1", net.SD_SEND == 1)
test("SD_BOTH == 2", net.SD_BOTH == 2)
test("MAX_SEND > 0", net.MAX_SEND > 0)
test("DEFAULT_HOST == 0.0.0.0", net.DEFAULT_HOST == "0.0.0.0")
test("DEFAULT_PORT == 3000", net.DEFAULT_PORT == 3000)


