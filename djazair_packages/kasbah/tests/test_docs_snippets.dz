# test_docs_snippets.dz — Automated Verification for All Documentation Code Snippets
# ═══════════════════════════════════════════════════════════════════════════════
# Validates every single code block, pattern, and snippet documented in README.md & docs/index.html

import "../init.dz" as kasbah
use file
use dir
use path
use datetime
use process

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed = passed + 1
    else
        print("  FAIL: ${name}")
        failed = failed + 1
    end
end

print("=== Testing All Documentation Snippets (README & Docs) ===")

# Mock Classes for Testing Snippets
class mockReq
    init(method = "GET", path = "/", headers = {}, body = "", query = {})
        self.method     = method
        self.path       = path
        self.pathname   = path
        self.rawHeaders = headers
        self.headers    = headers
        self.body       = body
        self.queryMap   = query
        self.params     = {}
        self.cookies    = new kasbah.cookieJar({"theme": "dark", "session_test": "abc"}, Null)
        self.session    = new kasbah.sessionManager({"visits": 5}, "test_session_id_32_chars_minimum__", False)
        self.ip         = "127.0.0.1"
        self.files      = {}
        self.stateMap   = {}
        self.remoteAddr = "127.0.0.1"
    end

    header(name)
        let k = name.lower()
        for hk, hv in self.headers
            if hk.lower() == k return hv end
        end
        return ""
    end

    isMethod(m)
        return self.method.lower() == m.lower()
    end

    get(k)
        if self.stateMap.has(k) return self.stateMap[k] end
        return Null
    end

    set(k, v)
        self.stateMap[k] = v
        return self
    end

    isSecure()
        return self.header("x-forwarded-proto") == "https"
    end

    secure() return self.isSecure() end

    protocol()
        return if self.isSecure() ? "https" else "http"
    end

    param(name, fallback = Null)
        if self.params.has(name) return self.params[name] end
        return fallback
    end

    queryParam(name = Null, fallback = Null)
        if isNull(name) return self.queryMap end
        if self.queryMap.has(name) return self.queryMap[name] end
        return fallback
    end

    query(name = Null, fallback = Null)
        return self.queryParam(name, fallback)
    end

    input(name, fallback = Null)
        if self.params.has(name) return self.params[name] end
        if self.queryMap.has(name) return self.queryMap[name] end
        if isMap(self.body) and self.body.has(name) return self.body[name] end
        return fallback
    end

    all()
        let result = {}
        for k, v in self.params result[k] = v end
        for k, v in self.queryMap result[k] = v end
        if isMap(self.body) for k, v in self.body result[k] = v end end
        return result
    end

    inputs()
        return self.all()
    end

    only(keys)
        let result = {}
        let a = self.all()
        for k in keys if a.has(k) result[k] = a[k] end end
        return result
    end

    except(keys)
        let result = {}
        let a = self.all()
        for k, v in a
            let skip = False
            for ek in keys if k == ek skip = True break end end
            if not skip result[k] = v end
        end
        return result
    end

    isJson()
        let ct = self.header("content-type")
        let acc = self.header("accept")
        return ct.contains("application/json") or acc.contains("application/json") or self.isAjax()
    end

    isAjax()
        return self.header("x-requested-with") == "XMLHttpRequest"
    end

    isType(type)
        let ct = self.header("content-type")
        if type == "json" return ct.contains("application/json") end
        if type == "form" return ct.contains("application/x-www-form-urlencoded") end
        if type == "multipart" return ct.contains("multipart/form-data") end
        return ct.contains(type)
    end

    contentIs(type) return self.isType(type) end

    token()
        let a = self.header("authorization")
        if a.startsWith("Bearer ") or a.startsWith("bearer ")
            return a.slice(7).strip()
        end
        return Null
    end

    bearerToken() return self.token() end

    userAgent() return self.header("user-agent") end
    referer() return self.header("referer") end
    host() return self.header("host") end

    cookie(name)
        return self.cookies.get(name)
    end

    hasFile(name)
        return self.files.has(name)
    end

    file(name)
        if self.files.has(name) return self.files[name] end
        return Null
    end

    uploader(options = {})
        return new kasbah.fileManager(self, options)
    end

    validate(data = Null)
        let d = data
        if isNull(d)
            d = if isMap(self.body) ? self.body else {}
        end
        return new kasbah.validator(d)
    end
end

class mockRes
    init()
        self.statusCode = 200
        self.headersMap = {}
        self.sentFlag   = False
        self.bodyData   = Null
        self.cookies    = []
    end

    status(c)
        self.statusCode = c
        return self
    end

    header(k, v = Null)
        if not isNull(v)
            self.headersMap[k.lower()] = str(v)
            return self
        end
        if self.headersMap.has(k.lower()) return self.headersMap[k.lower()] end
        return ""
    end

    removeHeader(k)
        if self.headersMap.has(k.lower()) self.headersMap.pop(k.lower()) end
        return self
    end

    type(t)
        self.header("Content-Type", t)
        return self
    end

    links(linkMap)
        let parts = []
        for rel, url in linkMap
            parts.append("<${url}>; rel=\"${rel}\"")
        end
        self.header("Link", parts.join(", "))
        return self
    end

    send(b)
        self.bodyData = b
        self.sentFlag = True
        return self
    end

    text(b)
        self.header("Content-Type", "text/plain; charset=utf-8")
        return self.send(b)
    end

    html(b)
        self.header("Content-Type", "text/html; charset=utf-8")
        return self.send(b)
    end

    json(d)
        self.header("Content-Type", "application/json; charset=utf-8")
        self.bodyData = d
        self.sentFlag = True
        return self
    end

    xml(b)
        self.header("Content-Type", "application/xml; charset=utf-8")
        return self.send(b)
    end

    cookie(name, val, opts = {})
        self.cookies.append({"name": name, "value": val, "options": opts})
        return self
    end

    clearCookie(name)
        return self.cookie(name, "", {"maxAge": 0})
    end

    deleteCookie(name)
        return self.clearCookie(name)
    end

    redirect(url, code = 302)
        self.status(code)
        self.header("Location", url)
        self.sentFlag = True
        return self
    end

    back(fallback = "/")
        return self.redirect(fallback)
    end

    ok(d = Null)
        self.status(200)
        return if isNull(d) ? self.send("") else self.json(d)
    end

    created(d = Null)
        self.status(201)
        return if isNull(d) ? self.send("") else self.json(d)
    end

    noContent()
        return self.status(204).send("")
    end

    badRequest(msg = "Bad Request")
        return self.status(400).json({"error": msg})
    end

    unauthorized(msg = "Unauthorized")
        return self.status(401).json({"error": msg})
    end

    forbidden(msg = "Forbidden")
        return self.status(403).json({"error": msg})
    end

    notFound(msg = "Not Found")
        return self.status(404).json({"error": msg})
    end

    validationError(errs)
        return self.status(422).json({"errors": errs})
    end

    serverError(msg = "Internal Server Error")
        return self.status(500).json({"error": msg})
    end
end

