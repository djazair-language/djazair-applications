# ─────────────────────────────────────────────────────────────────────────────
print("\n--- 10. Full REST App Snippet ---")

let appRest = new kasbah.app({
    "port":          8080,
    "static":        "public",
    "bodyParser":    True,
    "logger":        False,
    "session":       True,
    "sessionSecret": "kasbah-production-secret-key-32-chars-long!"
})

appRest.middleware(kasbah.helmet())
appRest.middleware(kasbah.cors({
    "origin":      "*",
    "credentials": True
}))

let itemsList = []

appRest.get("/api/items", fn(req, res)
    res.ok({"count": itemsList.length(), "items": itemsList})
end)

appRest.post("/api/items", fn(req, res)
    let v = req.validate()
    v.field("title").required().string().minLength(2)
    v.field("price").required().number().min(0)

    if v.fails()
        return res.validationError(v.errors())
    end

    let newItem = {
        "id":    itemsList.length() + 1,
        "title": req.input("title"),
        "price": req.input("price")
    }
    itemsList.append(newItem)

    res.created({"message": "Item created", "item": newItem})
end)

test("Full REST app matches GET /api/items", not isNull(appRest.matchRoute("GET", "/api/items")))
test("Full REST app matches POST /api/items", not isNull(appRest.matchRoute("POST", "/api/items")))

# ─────────────────────────────────────────────────────────────────────────────
# SUMMARY
# ─────────────────────────────────────────────────────────────────────────────
print("\n═══════════════════════════════════════════════════════════════════════════════")
print("=== Snippets Results: ${passed} passed, ${failed} failed / ${passed + failed} total ===")
print("═══════════════════════════════════════════════════════════════════════════════")

if failed > 0
    process.exit(1)
end
