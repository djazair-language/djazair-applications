# 1. Quick Start Snippet Verification
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- 1. Quick Start Snippet ---")

let appQuick = new kasbah.app({
    "port":   8080,
    "static": "public"
})

appQuick.get("/", fn(req, res)
    res.html("<h1>Welcome to Kasbah Web Framework!</h1>")
end)

appQuick.get("/hello/:name", fn(req, res)
    res.ok({
        "greeting": "Hello, ${req.param(\"name\")}!",
        "isAjax":   req.isAjax()
    })
end)

let matchQuickRoot = appQuick.matchRoute("GET", "/")
test("Quickstart root route registered", not isNull(matchQuickRoot))

let matchQuickHello = appQuick.matchRoute("GET", "/hello/Riyadh")
test("Quickstart param route registered", not isNull(matchQuickHello) and matchQuickHello["params"]["name"] == "Riyadh")

