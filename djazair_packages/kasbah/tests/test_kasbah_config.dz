# test_kasbah_config.dz
# Tests for Kasbah centralized configuration

import "../init.dz" as kasbah
use process
use file
use http
use datetime

let BASE_PORT = 19700
let passedCount = 0
let failedCount = 0

fn test(name, passed)
    if passed
        print("  PASS: ${name}")
        passedCount += 1
    else
        print("  FAIL: ${name}")
        failedCount += 1
    end
end

print("=== Kasbah Configuration Tests ===")

# ─────────────────────────────────────────────────────────────────────────────
# PART 1: setServerConfig modifies kasbahApp defaults
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 1: kasbah.setServerConfig() ---")

kasbah.setServerConfig({"port": BASE_PORT + 1, "maxBodySize": 50, "logger": False})

let app1 = new kasbah.kasbahApp()
let ok1 = app1.appConfig["port"] == BASE_PORT + 1 and app1.appConfig["maxBodySize"] == 50 and app1.appConfig["logger"] == False
test("kasbah.setServerConfig() changes default port and other options", ok1)

# Instance config should override global config
let app2 = new kasbah.kasbahApp({"port": BASE_PORT + 2, "maxBodySize": 100})
let ok2 = app2.appConfig["port"] == BASE_PORT + 2 and app2.appConfig["maxBodySize"] == 100 and app2.appConfig["logger"] == False
test("Instance config overrides kasbah.setServerConfig()", ok2)

# ─────────────────────────────────────────────────────────────────────────────
# PART 2: setClientConfig delegates to http
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 2: kasbah.setClientConfig() ---")

kasbah.setClientConfig({"connectTimeout": 12, "defaultBuffer": 16384})
# We verify by checking if HTTP requests use the new defaults implicitly.
# Since kasbah.setClientConfig is a direct reference to http.setClientConfig,
# we just ensure it executes successfully without error.
let ok3 = True
test("kasbah.setClientConfig() successfully wraps http.setClientConfig()", ok3)

# ─────────────────────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────────────────────
print("\n=== Results: ${passedCount} passed, ${failedCount} failed / ${passedCount + failedCount} total ===")
if failedCount > 0
    process.exit(1)
end
