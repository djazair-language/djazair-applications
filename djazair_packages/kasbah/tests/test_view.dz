# test_view.dz — Kasbah View Adapter Tests (powered by Qalam)

use kasbah
use os
use file
use dir

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed += 1
    else
        print("  FAIL: ${name}")
        failed += 1
    end
end

print("=== Kasbah View Adapter Tests ===")

let tmpDir = "${os.tmpDir()}/kasbah_view_adapter_tests"
if not file.exists(tmpDir)
    dir.createAll(tmpDir)
end

file.write("${tmpDir}/home.html", "<h1>Hello, {{ name }}!</h1>")
file.write("${tmpDir}/layout.html", "<html><body>{% block content %}{% endblock %}</body></html>")
file.write("${tmpDir}/page.html", "{% extends \"layout\" %}{% block content %}<p>Welcome</p>{% endblock %}")

# 1. Direct kasbah.view usage
let v = new kasbah.view({"views": tmpDir})
let html = v.render("home", {"name": "Djazair"})
test("kasbah.view renders simple template", html == "<h1>Hello, Djazair!</h1>")

let layoutHtml = v.render("page", {})
test("kasbah.view renders template inheritance", layoutHtml == "<html><body><p>Welcome</p></body></html>")

let strHtml = v.renderString("<b>{{ msg }}</b>", {"msg": "Bold"})
test("kasbah.view renderString works", strHtml == "<b>Bold</b>")

# 2. Integration with response.view()
class MockHttpRes
    init()
        self.raw = ""
        self.statusCode = 200
    end
    status(code)
        self.statusCode = code
    end
    sendRaw(data)
        self.raw = str(data)
    end
end

let mockHttp = new MockHttpRes()
let res = new kasbah.response(mockHttp, {"views": tmpDir})
res.view("home", {"name": "Kasbah"})
test("res.view() sets 200 status", res.statusCode == 200)
test("res.view() sets text/html Content-Type", res.header("Content-Type").contains("text/html"))
test("res.view() outputs rendered content in HTTP body", mockHttp.raw.contains("<h1>Hello, Kasbah!</h1>"))

let mockHttp404 = new MockHttpRes()
let res404 = new kasbah.response(mockHttp404, {"views": tmpDir})
res404.view("nonexistent_view_file", {})
test("res.view() sends 404 for missing template", res404.statusCode == 404)

print("\n=== Results: ${passed} passed, ${failed} failed / ${passed + failed} total ===")
