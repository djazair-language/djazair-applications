let getWorldToScreen2D      = rl.getWorldToScreen2D

# ── Window OOP Class ──────────────────────────────────────────────────────────
class Window
    init(width, height, title)
        assert.number(width, "width")
        assert.number(height, "height")
        assert.string(title, "title")

        self.width = int(width)
        self.height = int(height)
        initWindow(self.width, self.height, title)
    end

    isOpen()
        return !shouldClose()
    end

    begin()
        beginDrawing()
    end

    finish()
        endDrawing()
    end

    clear(color = [0, 0, 0, 255])
        clearBackground(color)
    end

    close()
        closeWindow()
    end

    setFPS(fps)
        assert.number(fps, "fps")
        setTargetFPS(int(fps))
    end

    setTitle(title)
        assert.string(title, "title")
        setWindowTitle(title)
    end

    setSize(width, height)
        assert.number(width, "width")
        assert.number(height, "height")
        self.width = int(width)
        self.height = int(height)
        setWindowSize(self.width, self.height)
    end

    getFPS()
        return getFPS()
    end
end