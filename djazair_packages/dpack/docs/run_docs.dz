use webview

let app = webview.createWindow({
    "title": "Djazair dpack - Official Documentation & Standalone Bundler Reference",
    "width": 1280,
    "height": 840,
    "minWidth": 880,
    "minHeight": 640,
    "center": True,
    "darkTitleBar": True,
    "debug": True,
    "singleInstance": True,
    "appId": "com.djazair.dpack.docs"
})

app.onReady(fn()
    app.window.navigate("index.html")
end)

app.run()
