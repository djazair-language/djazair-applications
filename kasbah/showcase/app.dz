# app.dz — Kasbah Showcase Application
# تطبيق ويب شامل يغطي كل خصائص إطار العمل Kasbah:
#   - Routes: GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS
#   - Dynamic params (:id), query strings, req.input/only/except
#   - Middleware: global, route-group (auth)
#   - BodyParser: JSON, URL-encoded, multipart file upload
#   - Sessions (file-based, cookie-signed)
#   - Cookies: set, read, delete
#   - Static file serving (public/)
#   - View/template rendering (views/)
#   - File download (res.download)
#   - Redirect (res.redirect)
#   - Custom error handler (onError)
#   - req.ip, req.isAjax(), req.accepts(), req.contentIs()

use kasbah
use datetime
use process
use path
use file

let PORT = 8080
let APP_DIR = process.scriptDir()

# ── In-memory data stores ─────────────────────────────────────────────────────

let tasks = []   # [{ id, title, author, priority, done, createdAt }]
let nextId = 0
let reqCount = 0
let startTime = datetime.timestamp()

# ── App configuration ─────────────────────────────────────────────────────────

let app = new kasbah.kasbahApp({
    "port":          PORT,
    "logger":        True,
    "bodyParser":    True,
    "maxBodySize":   2,
    "session":       True,
    "sessionSecret": "kasbah-showcase-session-secret-2026!",
    "static":        "${APP_DIR}/public",
    "views":         "${APP_DIR}/views"
})

# ── Global middleware ─────────────────────────────────────────────────────────

# Tracks request count and stamps each request with a timestamp
app.middleware(fn(req, res)
    reqCount = reqCount + 1
    req.set("startTime", datetime.ticks())
    req.set("reqNum", reqCount)
end)

# CORS headers — allow all origins for the showcase
app.middleware(fn(req, res)
    res.setHeader("Access-Control-Allow-Origin", "*")
    res.setHeader("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS")
    res.setHeader("Access-Control-Allow-Headers", "Content-Type, X-Admin-Key")
    if req.isMethod("OPTIONS")
        res.status(204).send("")
    end
end)

# ── Custom error handler ──────────────────────────────────────────────────────

app.onError(fn(err, req, res)
    res.status(500).json({
        "error":   "Internal Server Error",
        "message": str(err),
        "path":    req.path,
        "reqNum":  req.get("reqNum")
    })
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 1 — HTML Pages (View rendering)
# ══════════════════════════════════════════════════════════════════════════════

app.get("/", fn(req, res)
    # Track page visits in session
    let visits = req.session.get("visits", 0) + 1
    req.session.set("visits", visits)
    res.view("index")
end)

app.get("/tasks", fn(req, res)
    res.view("tasks")
end)

app.get("/session-page", fn(req, res)
    res.view("session")
end)

app.get("/cookies-page", fn(req, res)
    res.view("cookies")
end)

app.get("/upload-page", fn(req, res)
    res.view("upload")
end)

app.get("/inspector", fn(req, res)
    res.view("inspector")
end)

# ── Redirect demo ─────────────────────────────────────────────────────────────

app.get("/old-home", fn(req, res)
    res.redirect("/", 301)
end)

# ── Error demo ────────────────────────────────────────────────────────────────

app.get("/error-demo", fn(req, res)
    throw "This is a demo error thrown intentionally!"
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 2 — Tasks API (Full CRUD)
# ══════════════════════════════════════════════════════════════════════════════

# GET /api/tasks?status=open&priority=urgent
app.get("/api/tasks", fn(req, res)
    let status = req.query("status")
    let priority = req.query("priority")
    let author = req.query("author")

    let filtered = []
    for t in tasks
        if !isNull(status)
            if status == "done" and !t["done"]
                continue
            end
            if status == "open" and t["done"]
                continue
            end
        end
        if !isNull(priority) and priority != "" and t["priority"] != priority
            continue
        end
        if !isNull(author) and author != "" and t["author"] != author
            continue
        end
        filtered.append(t)
    end

    res.json({
        "total":   filtered.length(),
        "filters": { "status": status, "priority": priority, "author": author },
        "tasks":   filtered
    })
end)

# GET /api/tasks/:id
app.get("/api/tasks/:id", fn(req, res)
    let id = req.param("id")
    let found = Null
    for t in tasks
        if str(t["id"]) == id
            found = t
            break
        end
    end
    if isNull(found)
        res.status(404).json({ "error": "Task not found", "id": id })
        return
    end
    res.json(found)
end)

# POST /api/tasks  — JSON or URL-encoded body with validator
app.post("/api/tasks", fn(req, res)
    let v = req.validate(req.body)
    v.field("title").required().string().minLength(2)
    v.field("author").optional().string()
    v.field("priority").optional().string().oneOf(["normal", "urgent", "low"])

    if !v.passes()
        res.status(422).json({ "errors": v.errors(), "first": v.firstError() })
        return
    end

    let clean = v.validated()
    let task = {
        "id":        nextId,
        "title":     clean["title"],
        "author":    if clean.has("author") ? clean["author"] else "Anonymous",
        "priority":  if clean.has("priority") ? clean["priority"] else "normal",
        "done":      False,
        "createdAt": datetime.timestamp()
    }
    tasks.append(task)
    nextId = nextId + 1

    res.status(201).json({ "created": task })
end)

# PUT /api/tasks/:id  — full update
app.put("/api/tasks/:id", fn(req, res)
    let id = req.param("id")
    for i in 0 .. tasks.length() - 1
        if str(tasks[i]["id"]) == id
            if !isNull(req.input("title"))
                tasks[i]["title"] = req.input("title")
            end
            if !isNull(req.input("author"))
                tasks[i]["author"] = req.input("author")
            end
            if !isNull(req.input("priority"))
                tasks[i]["priority"] = req.input("priority")
            end
            if !isNull(req.input("done"))
                tasks[i]["done"] = req.input("done") == True or req.input("done") == "true"
            end
            res.json({ "updated": tasks[i] })
            return
        end
    end
    res.status(404).json({ "error": "Task not found" })
end)

# PATCH /api/tasks/:id/toggle  — toggle done status
app.patch("/api/tasks/:id/toggle", fn(req, res)
    let id = req.param("id")
    for i in 0 .. tasks.length() - 1
        if str(tasks[i]["id"]) == id
            tasks[i]["done"] = !tasks[i]["done"]
            res.json({ "updated": tasks[i] })
            return
        end
    end
    res.status(404).json({ "error": "Task not found" })
end)

# DELETE /api/tasks/:id
app.delete("/api/tasks/:id", fn(req, res)
    let id = req.param("id")
    let newTasks = []
    let deleted = False
    for t in tasks
        if str(t["id"]) == id
            deleted = True
        else
            newTasks.append(t)
        end
    end
    if !deleted
        res.status(404).json({ "error": "Task not found" })
        return
    end
    tasks = newTasks
    res.status(204).send("")
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 3 — Session API (using sessionManager via req.session & res.session)
# ══════════════════════════════════════════════════════════════════════════════

app.get("/api/session", fn(req, res)
    let visits = req.session.get("visits", 0) + 1
    req.session.set("visits", visits)
    res.json({
        "sessionId": req.session.id(),
        "isNew":     req.session.isNew(),
        "session":   req.session.all()
    })
end)

app.post("/api/session", fn(req, res)
    let key = req.input("key")
    let val = req.input("value", "")
    if isNull(key) or key == ""
        res.status(400).json({ "error": "key is required" })
        return
    end
    req.session.set(key, val)
    res.json({ "set": key, "value": val, "session": req.session.all() })
end)

app.delete("/api/session", fn(req, res)
    req.session.clear()
    res.json({ "cleared": True })
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 4 — Cookies API (using cookieJar via req.cookies & res.cookies)
# ══════════════════════════════════════════════════════════════════════════════

app.get("/api/cookies", fn(req, res)
    let allCookies = req.cookies.all()
    let result = {}
    for k, v in allCookies
        if k.startsWith("app_")
            result[k] = v
        end
    end
    res.json({ "cookies": result, "count": result.keys().length() })
end)

app.post("/api/cookies", fn(req, res)
    let name = req.input("name")
    let val = req.input("value", "")
    if isNull(name) or name == ""
        res.status(400).json({ "error": "name is required" })
        return
    end
    let cookieName = "app_${name}"
    req.cookies.set(cookieName, val, {
        "httpOnly": False,
        "path":     "/",
        "maxAge":   3600,
        "sameSite": "Lax"
    })
    res.json({ "set": cookieName, "value": val })
end)

app.delete("/api/cookies", fn(req, res)
    let allCookies = req.cookies.all()
    for k, v in allCookies
        if k.startsWith("app_")
            req.cookies.delete(k)
        end
    end
    res.json({ "cleared": True })
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 5 — File Upload & Download (using req.uploader / fileManager)
# ══════════════════════════════════════════════════════════════════════════════

app.post("/api/upload", fn(req, res)
    let upload = req.uploader({
        "dest":             "${APP_DIR}/uploads",
        "maxSize":          2,
        "allowedTypes":     ["image/*", "text/*", "application/pdf"],
        "keepOriginalName": False
    })

    let upResult = upload.single("file")
    if !upResult["ok"]
        res.status(400).json({ "error": upResult["error"] })
        return
    end

    let f = upResult["file"]
    res.status(200).json({
        "ok":           True,
        "originalName": f["originalname"],
        "savedName":    f["filename"],
        "mimeType":     f["mimetype"],
        "size":         f["size"],
        "savedPath":    f["path"]
    })
end)

# GET /download/:filename  — streams a file from public/ as a download
app.get("/download/:filename", fn(req, res)
    let fname = req.param("filename")
    let fpath = path.join(APP_DIR, "public", fname)
    if !file.exists(fpath)
        res.status(404).json({ "error": "File not found" })
        return
    end
    res.download(fpath, fname)
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 6 — Echo & Info endpoints
# ══════════════════════════════════════════════════════════════════════════════

# GET /api/echo?anything=you&want=here
app.get("/api/echo", fn(req, res)
    res.json({
        "method":  req.method,
        "path":    req.path,
        "query":   req.query(),
        "headers": req.rawHeaders,
        "ip":      req.ip,
        "isAjax":  req.isAjax()
    })
end)

# GET /api/info — server + request metadata
app.get("/api/info", fn(req, res)
    let uptime = datetime.timestamp() - startTime
    res.json({
        "server": {
            "framework": "Kasbah",
            "language":  "Djazair",
            "port":      PORT,
            "uptime":    uptime,
            "requests":  reqCount
        },
        "request": {
            "method":     req.method,
            "path":       req.path,
            "ip":         req.ip,
            "isAjax":     req.isAjax(),
            "accepts":    req.rawHeaders["accept"] || "*/*",
            "reqNum":     req.get("reqNum")
        }
    })
end)

# ══════════════════════════════════════════════════════════════════════════════
# SECTION 7 — Admin route group (auth middleware)
# ══════════════════════════════════════════════════════════════════════════════

# Auth middleware: checks X-Admin-Key header OR admin_bypass cookie (for browser demo)
let authMiddleware = fn(req, res)
    let key = req.header("x-admin-key")
    let bypass = req.cookies.get("admin_bypass")
    if key == "secret123" or bypass == "secret123"
        return
    end
    # For browser visits, set the bypass cookie and allow through
    if req.accepts("text/html") and !req.isAjax()
        req.cookies.set("admin_bypass", "secret123", {
            "httpOnly": True,
            "path":     "/admin",
            "maxAge":   3600
        })
        return
    end
    res.status(403).json({
        "error":  "Forbidden",
        "hint":   "Set header X-Admin-Key: secret123"
    })
end

app.group("/admin", [authMiddleware], fn(r)
    r.get("/", fn(req, res)
        res.view("admin")
    end)

    r.get("/stats", fn(req, res)
        let doneTasks = 0
        let urgentTasks = 0
        for t in tasks
            if t["done"]
                doneTasks = doneTasks + 1
            end
            if t["priority"] == "urgent"
                urgentTasks = urgentTasks + 1
            end
        end
        let uptime = datetime.timestamp() - startTime
        res.json({
            "tasks": {
                "total":  tasks.length(),
                "done":   doneTasks,
                "open":   tasks.length() - doneTasks,
                "urgent": urgentTasks
            },
            "server": {
                "uptime":   uptime,
                "requests": reqCount,
                "port":     PORT
            }
        })
    end)

    r.delete("/tasks", fn(req, res)
        tasks = []
        nextId = 0
        res.json({ "cleared": True })
    end)
end)

# ══════════════════════════════════════════════════════════════════════════════
# Seed a few demo tasks on startup
# ══════════════════════════════════════════════════════════════════════════════

fn addTask(title, author, priority)
    tasks.append({
        "id":        nextId,
        "title":     title,
        "author":    author,
        "priority":  priority,
        "done":      False,
        "createdAt": datetime.timestamp()
    })
    nextId = nextId + 1
end

addTask("Build Kasbah web framework", "Riad", "urgent")
addTask("Write comprehensive tests", "Riad", "normal")
addTask("Add Keep-Alive support to http lib", "Riad", "normal")
addTask("Fix cookie header injection bug", "Riad", "urgent")

tasks[0]["done"] = True
tasks[2]["done"] = True

# ══════════════════════════════════════════════════════════════════════════════
