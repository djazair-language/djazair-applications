use kasbah
use file
use dir
use path
use json
use crypto
use datetime
use bytes
use process

let APP_DIR = process.scriptDir()
let UPLOAD_DIR = APP_DIR + "/uploads"
let META_FILE = UPLOAD_DIR + "/metadata.json"
let MAX_SIZE = 10 * 1024 * 1024

if not file.exists(UPLOAD_DIR)
    dir.createAll(UPLOAD_DIR)
end

let loadMeta = fn()
    if not file.exists(META_FILE)
        return []
    end
    let content = file.read(META_FILE)
    if isNull(content) or content == ""
        return []
    end
    return json.parse(content)
end

let saveMeta = fn(files)
    file.write(META_FILE, json.stringify(files, Null, True))
end

let appendMeta = fn(info)
    let files = loadMeta()
    files.append(info)
    saveMeta(files)
end

let removeMeta = fn(safeName)
    let files = loadMeta()
    let remaining = []
    let i = 0
    while i < files.length()
        if files[i]["safeName"] != safeName
            remaining.append(files[i])
        end
        i = i + 1
    end
    saveMeta(remaining)
end

let findMeta = fn(safeName)
    let files = loadMeta()
    let i = 0
    while i < files.length()
        if files[i]["safeName"] == safeName
            return files[i]
        end
        i = i + 1
    end
    return Null
end

let sanitizeName = fn(name)
    let base = path.basename(name)
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_"
    let safe = ""
    let i = 0
    while i < base.length()
        let c = base[i]
        if allowed.contains(c)
            safe = safe + c
        else
            safe = safe + "_"
        end
        i = i + 1
    end
    if safe == "" or safe.length() == 0
        safe = "file"
    end
    return safe
end

let formatSize = fn(bytes)
    if bytes < 1024
        return bytes + " B"
    elif bytes < 1024 * 1024
        return int(bytes / 1024) + " KB"
    elif bytes < 1024 * 1024 * 1024
        return int(bytes / (1024 * 1024)) + " MB"
    else
        return int(bytes / (1024 * 1024 * 1024)) + " GB"
    end
end

let app = new kasbah.Kasbah({
    "port": 3000,
    "bodyParser": True,
    "maxBodySize": 20 * 1024 * 1024,
    "logger": True,
})

app.get("/", fn(req, res)
    res.file(APP_DIR + "/views/index.html")
end)

app.get("/api/files", fn(req, res)
    let files = loadMeta()
    let reversed = files.reversed()
    res.json(reversed)
end)

app.post("/api/upload", fn(req, res)
    let uploadedFile = req.files["file"]
    
    if isNull(uploadedFile)
        res.status(400).json({"error": "file is required in form-data"})
        return
    end

    let name = uploadedFile["filename"]
    let fileSize = uploadedFile["size"]
    let fileType = uploadedFile["type"]
    let tempPath = uploadedFile["tempPath"]

    if fileSize > MAX_SIZE
        file.delete(tempPath)
        res.status(413).json({"error": "الملف كبير جداً. الحد الأقصى 10 ميغابايت."})
        return
    end

    let safeName = str(datetime.timestamp()) + "_" + sanitizeName(name)
    let filePath = UPLOAD_DIR + "/" + safeName

    # Move from tempPath to filePath
    file.move(tempPath, filePath)

    let meta = {
        "name": name,
        "safeName": safeName,
        "type": fileType,
        "size": fileSize,
        "sizeFormatted": formatSize(fileSize),
        "uploadedAt": datetime.timestamp(),
    }
    appendMeta(meta)
    res.status(201).json(meta)
end)

app.delete("/api/files/:safeName", fn(req, res)
    let safeName = req.param("safeName")
    let filePath = UPLOAD_DIR + "/" + safeName

    if file.exists(filePath)
        file.delete(filePath)
        removeMeta(safeName)
        res.json({"deleted": safeName})
    else
        res.status(404).json({"error": "الملف غير موجود"})
    end
end)

app.get("/u/:safeName", fn(req, res)
    let safeName = req.param("safeName")
    let filePath = UPLOAD_DIR + "/" + safeName

    if file.exists(filePath)
        let meta = findMeta(safeName)
        if not isNull(meta)
            res.setHeader("Content-Disposition", "inline; filename=\"" + meta["name"] + "\"")
            res.setHeader("Content-Type", meta["type"])
        end
        res.file(filePath)
    else
        res.status(404).json({"error": "الملف غير موجود"})
    end
end)

app.get("/d/:safeName", fn(req, res)
    let safeName = req.param("safeName")
    let filePath = UPLOAD_DIR + "/" + safeName

    if file.exists(filePath)
        let meta = findMeta(safeName)
        let origName = safeName
        if not isNull(meta)
            origName = meta["name"]
        end
        res.download(filePath, origName)
    else
        res.status(404).json({"error": "الملف غير موجود"})
    end
end)

print("\n╔══════════════════════════════════════╗")
print("\n║   خادم رفع الملفات جاهز             ║")
print("\n║   http://localhost:3000              ║")
print("\n╚══════════════════════════════════════╝\n")
app.listen(3000)
