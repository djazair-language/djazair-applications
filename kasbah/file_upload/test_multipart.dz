use kasbah
use json
use dir
use file
use path

let APP_DIR = "."

let app = new kasbah.Kasbah({
    "port": 3001,
    "bodyParser": True,
    "maxBodySize": 50 * 1024 * 1024,
    "logger": True,
})

app.get("/", fn(req, res)
    res.html(`
        <form action="/upload" method="post" enctype="multipart/form-data">
            <input type="text" name="username" value="riad" />
            <input type="file" name="avatar" />
            <input type="file" name="doc" />
            <button type="submit">Upload</button>
        </form>
    `)
end)

app.post("/upload", fn(req, res)
    let files = req.files
    let body = req.body
    
    let result = {
        "fields": body,
        "files_received": []
    }
    
    if !isNull(files)
        for key in files.keys()
            let f = files[key]
            result["files_received"].append({
                "field": key,
                "name": f["filename"],
                "size": f["size"],
                "type": f["type"],
                "tempPath": f["tempPath"]
            })
        end
    end
    
    res.json(result)
end)

app.listen(3001)
