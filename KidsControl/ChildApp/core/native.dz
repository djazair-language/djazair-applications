use file
use process

let NATIVE_EXE = "KidsControlNative.exe"

# Compiles the high-performance C# helper on startup if missing.
fn setupNativeHelper()
    if file.isFile(NATIVE_EXE) return end
    let csCode = `using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using System.Windows.Forms;
using System.Threading;

class KidsControlNative {
    [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] static extern int GetWindowText(IntPtr hWnd, StringBuilder text, int count);
    [DllImport("avicap32.dll")] static extern IntPtr capCreateCaptureWindowA(string n, int s, int x, int y, int w, int h, IntPtr p, int id);
    [DllImport("avicap32.dll")] static extern bool capGetDriverDescriptionA(short idx, StringBuilder name, int cn, StringBuilder ver, int cv);
    [DllImport("user32", EntryPoint="SendMessage")] static extern int SendMessage(IntPtr h, uint m, int w, int l);

    [STAThread]
    static void Main(string[] args) {
        // DAEMON MODE: read commands line by line from stdin
        string line;
        while ((line = Console.ReadLine()) != null) {
            string cmd = line.Trim().ToLower();
            if (cmd == "exit") break;
            try {
                if (cmd == "window") {
                    IntPtr hwnd = GetForegroundWindow();
                    StringBuilder sb = new StringBuilder(256);
                    Console.WriteLine(GetWindowText(hwnd, sb, 256) > 0 ? sb.ToString() : "None/Desktop");
                } else if (cmd == "screenshot") {
                    Rectangle bounds = Screen.PrimaryScreen.Bounds;
                    using (Bitmap bmp = new Bitmap(bounds.Width, bounds.Height)) {
                        using (Graphics g = Graphics.FromImage(bmp)) {
                            g.CopyFromScreen(bounds.Location, Point.Empty, bounds.Size);
                        }
                        using (Image thumb = bmp.GetThumbnailImage(bounds.Width / 2, bounds.Height / 2, null, IntPtr.Zero))
                        using (MemoryStream ms = new MemoryStream()) {
                            thumb.Save(ms, ImageFormat.Jpeg);
                            byte[] bytes = ms.ToArray();
                            Console.WriteLine(bytes.Length > 0 ? Convert.ToBase64String(bytes) : "ERROR:EMPTY_IMAGE");
                        }
                    }
                } else if (cmd == "webcam") {
                    short realIdx = -1;
                    for (short i = 0; i < 10; i++) {
                        var name = new StringBuilder(128); var ver = new StringBuilder(128);
                        if (!capGetDriverDescriptionA(i, name, 128, ver, 128)) break;
                        string n = name.ToString().ToLower();
                        if (n.Contains("screen") || n.Contains("virtual") || n.Contains("obs") ||
                            n.Contains("split") || n.Contains("desktop") || n.Contains("game") || n.Contains("display")) continue;
                        realIdx = i; break;
                    }
                    if (realIdx < 0) { Console.WriteLine("NO_WEBCAM"); continue; }
                    IntPtr hw = capCreateCaptureWindowA("Webcam", 0, 0, 0, 640, 480, IntPtr.Zero, 0);
                    if (SendMessage(hw, 1034, realIdx, 0) == 0) { Console.WriteLine("NO_WEBCAM"); continue; }
                    Thread.Sleep(1000);
                    SendMessage(hw, 1084, 0, 0);
                    SendMessage(hw, 1054, 0, 0);
                    SendMessage(hw, 1035, 0, 0);
                    if (Clipboard.ContainsImage()) {
                        using (Image img = Clipboard.GetImage()) {
                            Rectangle sc = Screen.PrimaryScreen.Bounds;
                            if (img.Width >= sc.Width * 0.85 || img.Height >= sc.Height * 0.85) {
                                Clipboard.Clear(); Console.WriteLine("NO_WEBCAM"); continue;
                            }
                            using (MemoryStream ms = new MemoryStream()) {
                                img.Save(ms, ImageFormat.Jpeg);
                                byte[] bytes = ms.ToArray();
                                Console.WriteLine(bytes.Length > 0 ? Convert.ToBase64String(bytes) : "NO_WEBCAM");
                            }
                        }
                        Clipboard.Clear();
                    } else { Console.WriteLine("NO_WEBCAM"); }
                } else {
                    Console.WriteLine("ERROR:UNKNOWN_CMD");
                }
            } catch (Exception ex) {
                Console.WriteLine("ERROR:" + ex.Message.Replace("\n", " "));
            }
            Console.Out.Flush();
        }
    }
}
`
    let csFile = "NativeHelper.cs"
    file.write(csFile, csCode)
    let csc = "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe"
    process.exec(csc + " /out:" + NATIVE_EXE + " /r:System.Windows.Forms.dll /r:System.Drawing.dll " + csFile)
    try file.delete(csFile) catch e end
end

# Global daemon handle — started once, reused for all calls.
let _daemonProc = Null

# Ensures the native daemon process is alive, restarting it if needed.
fn ensureDaemon()
    # If we already have a live daemon handle, return it immediately.
    if !isNull(_daemonProc)
        return _daemonProc
    end

    # Build the binary if it doesn't exist yet.
    setupNativeHelper()

    # Spawn the daemon process. It will wait for stdin commands in a loop.
    _daemonProc = process.spawn(NATIVE_EXE)
    process.sleep(0.2)
    return _daemonProc
end

# Sends a single command to the persistent native daemon and reads one line back.
# @param {string} cmd - The command to send (window | screenshot | webcam).
# @return {string} The response line from the daemon, or an error string.
fn callDaemon(cmd)
    try
        let p = ensureDaemon()
        process.write(p["write"], cmd + "\n")
        process.sleep(0.1)
        let out = process.read(p["read"])
        if isNull(out)
            # Daemon may have died — reset and signal error
            _daemonProc = Null
            return "ERROR:DAEMON_DIED"
        end
        return out.strip()
    catch e
        _daemonProc = Null
        return "ERROR:" + str(e)
    end
end

# Captures a desktop screenshot using the persistent native daemon.
# @return {string} Base64 image data prefixed with SCREENSHOT: or ERR:
fn takeScreenshot()
    setupNativeHelper()
    let out = callDaemon("screenshot")
    if out == "" or out.startsWith("ERROR:")
        return "ERR:SCREENSHOT_FAILED"
    end
    return "SCREENSHOT:" + out
end

# Captures a webcam image using the persistent native daemon.
# @return {string} Base64 image data prefixed with WEBCAM: or ERR:
fn takeWebcamSnapshot()
    setupNativeHelper()
    let out = callDaemon("webcam")
    if out == "NO_WEBCAM"
        return "ERR:NO_WEBCAM"
    elif out == "" or out.startsWith("ERROR:")
        return "ERR:WEBCAM_FAILED"
    end
    return "WEBCAM:" + out
end

# Gets the title of the currently active window using the persistent native daemon.
# @return {string} Window title prefixed with ACTIVE_WINDOW:
fn getActiveWindow()
    setupNativeHelper()
    let out = callDaemon("window")
    return "ACTIVE_WINDOW:" + out
end
