use file
use datetime

let LOG_FILE = "agent.log"

# Logs an info message to the console and log file.
# @param {string} module - The component name (e.g., System, Network).
# @param {string} message - The message to log.
fn info(module, message)
    let ts = datetime.now().format("YYYY-MM-DD HH:mm:ss")
    let line = "[" + ts + "] [INFO] [" + module + "] " + message
    print(line)
    try file.append(LOG_FILE, line + "\n") catch e end
end

# Logs an error message to the console and log file.
# @param {string} module - The component name (e.g., System, Network).
# @param {string} message - The message to log.
fn error(module, message)
    let ts = datetime.now().format("YYYY-MM-DD HH:mm:ss")
    let line = "[" + ts + "] [ERROR] [" + module + "] " + message
    print(line)
    try file.append(LOG_FILE, line + "\n") catch e end
end
