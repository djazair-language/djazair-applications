use process
use file
use json

let HOSTS_FILE = "C:\\Windows\\System32\\drivers\\etc\\hosts"
let SCHEDULE_FILE = "C:\\Users\\Public\\kc_schedule.txt"

# Executes a PowerShell script and returns the stdout output.
# @param {string} script - The PowerShell script to run.
# @return {string} The trimmed output of the script.
fn runPowerShell(script)
    let tmpFile = "__kc_tmp.ps1"
    file.write(tmpFile, script)
    let result = process.exec("powershell -ExecutionPolicy Bypass -NoProfile -NonInteractive -File " + tmpFile)
    try 
        file.delete(tmpFile) 
    catch e 
        # Ignore cleanup error
    end
    return result["stdout"].strip()
end

# Retrieves a specific value from a WMIC query.
# @param {string} query - The WMIC query string.
# @return {string} The extracted value or an empty string if not found.
fn wmicValue(query)
    let r = process.exec(query)
    let lines = r["stdout"].split("\n")
    for line in lines
        let t = line.strip()
        if t.contains("=") and not t.startsWith("=")
            let idx = t.index("=")
            return t.slice(idx + 1, t.length()).strip()
        end
    end
    return ""
end

# Gathers system hardware and OS information.
# @return {string} JSON encoded system info string prefixed with SYSINFO:
fn getSysInfo()
    let hostname = ""
    let osCaption = ""
    let cpu = ""
    let ramTotal = ""
    let ramFree = ""
    let username = ""
    let bootTime = ""

    try hostname = process.exec("hostname")["stdout"].strip() catch e end
    try username = process.exec("whoami")["stdout"].strip()   catch e end
    try osCaption = wmicValue("wmic os get Caption /value")   catch e end
    try cpu = wmicValue("wmic cpu get Name /value")           catch e end
    try
        let bytes = num(wmicValue("wmic ComputerSystem get TotalPhysicalMemory /value"))
        ramTotal = str(int(bytes / 1073741824.0)) + " GB"
    catch e 
    end
    
    try
        let kb = num(wmicValue("wmic OS get FreePhysicalMemory /value"))
        ramFree = str(int(kb / 1048576.0)) + " GB"
    catch e 
    end
    
    try 
        bootTime = wmicValue("wmic os get LastBootUpTime /value").slice(0, 14) 
    catch e 
    end

    let info = {
        "hostname": hostname,
        "username": username,
        "os":       osCaption,
        "cpu":      cpu,
        "ram_total": ramTotal,
        "ram_free":  ramFree,
        "boot_time": bootTime
    }
    return "SYSINFO:" + json.encode(info)
end

# Captures the screen and returns a base64 encoded image.
let NATIVE_EXE = "KidsControlNative.exe"

# Compiles the high-performance C# helper on startup if missing.
fn setupNativeHelper()
    if file.isFile(NATIVE_EXE) return end
    let csCode = `using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using System.Windows.Forms;
using System.Threading;

class KidsControlNative {
    [DllImport("user32.dll")] static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")] static extern int GetWindowText(IntPtr hWnd, StringBuilder text, int count);
    [DllImport("avicap32.dll")] static extern IntPtr capCreateCaptureWindowA(string lpszWindowName, int dwStyle, int X, int Y, int nWidth, int nHeight, IntPtr hwndParent, int nID);
    [DllImport("user32", EntryPoint="SendMessage")] static extern int SendMessage(IntPtr hWnd, uint Msg, int wParam, int lParam);

    [STAThread]
    static void Main(string[] args) {
        if (args.Length == 0) return;
        string cmd = args[0].ToLower();
        if (cmd == "window") {
            IntPtr hwnd = GetForegroundWindow();
            StringBuilder sb = new StringBuilder(256);
            if (GetWindowText(hwnd, sb, 256) > 0) Console.WriteLine(sb.ToString());
            else Console.WriteLine("None/Desktop");
        } else if (cmd == "screenshot") {
            Rectangle bounds = Screen.PrimaryScreen.Bounds;
            using (Bitmap bmp = new Bitmap(bounds.Width, bounds.Height)) {
                using (Graphics g = Graphics.FromImage(bmp)) {
                    g.CopyFromScreen(bounds.Location, Point.Empty, bounds.Size);
                }
                using (Image thumb = bmp.GetThumbnailImage(bounds.Width / 2, bounds.Height / 2, null, IntPtr.Zero)) {
                    using (MemoryStream ms = new MemoryStream()) {
                        thumb.Save(ms, ImageFormat.Jpeg);
                        Console.WriteLine(Convert.ToBase64String(ms.ToArray()));
                    }
                }
            }
        } else if (cmd == "webcam") {
            IntPtr hwnd = capCreateCaptureWindowA("Webcam", 0, 0, 0, 640, 480, IntPtr.Zero, 0);
            SendMessage(hwnd, 1034, 0, 0); Thread.Sleep(800);
            SendMessage(hwnd, 1084, 0, 0); SendMessage(hwnd, 1054, 0, 0); SendMessage(hwnd, 1035, 0, 0);
            if (Clipboard.ContainsImage()) {
                using (Image img = Clipboard.GetImage()) {
                    using (MemoryStream ms = new MemoryStream()) {
                        img.Save(ms, ImageFormat.Jpeg);
                        Console.WriteLine(Convert.ToBase64String(ms.ToArray()));
                    }
                }
                Clipboard.Clear();
            } else Console.WriteLine("NO_WEBCAM");
        }
    }
}
`
    let csFile = "NativeHelper.cs"
    file.write(csFile, csCode)
    let csc = "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe"
    process.exec(csc + " /out:" + NATIVE_EXE + " /r:System.Windows.Forms.dll /r:System.Drawing.dll " + csFile)
    try file.delete(csFile) catch e end
end

# @return {string} Base64 image data prefixed with SCREENSHOT:
fn takeScreenshot()
    setupNativeHelper()
    let r = process.exec(NATIVE_EXE + " screenshot")
    return "SCREENSHOT:" + r["stdout"].strip()
end

# Captures a webcam image and returns it as a base64 string.
# @return {string} Base64 image data prefixed with WEBCAM:
fn takeWebcamSnapshot()
    setupNativeHelper()
    let r = process.exec(NATIVE_EXE + " webcam")
    return "WEBCAM:" + r["stdout"].strip()
end

# Gets the title of the currently active window on the machine.
# @return {string} Window title prefixed with ACTIVE_WINDOW:
fn getActiveWindow()
    setupNativeHelper()
    let r = process.exec(NATIVE_EXE + " window")
    return "ACTIVE_WINDOW:" + r["stdout"].strip()
end

# Retrieves a list of running tasks.
# @return {string} CSV formatted task list prefixed with TASKS:
fn getTasks()
    let r = process.exec("tasklist /FO CSV /NH")
    return "TASKS:" + r["stdout"]
end

# Kills a specific task by its image name.
# @param {string} name - The task name to kill.
# @return {string} Status of the command.
fn killTask(name)
    process.exec("taskkill /F /IM " + name)
    return "OK:KILL:" + name
end

# Displays a popup message box to the child user.
# @param {string} text - The message text.
# @return {string} Status of the command.
fn showMessage(text)
    let escaped = text.replace("\"", "'")
    let script = `
Add-Type -AssemblyName System.Windows.Forms
[System.Windows.Forms.MessageBox]::Show("${escaped}", "Message from Parent") | Out-Null
`
    runPowerShell(script)
    return "OK:MSG"
end

# Blocks a specific domain by adding it to the hosts file.
# @param {string} domain - The domain to block.
# @return {string} Status of the operation.
fn blockDomain(domain)
    try
        let hosts = file.read(HOSTS_FILE)
        let entry = "127.0.0.1 " + domain
        let entryWww = "127.0.0.1 www." + domain
        if not hosts.contains(entry)
            file.write(HOSTS_FILE, hosts + "\r\n" + entry + "\r\n" + entryWww)
            process.exec("ipconfig /flushdns")
        end
        return "OK:BLOCK:" + domain
    catch e
        return "ERR:ADMIN_REQUIRED"
    end
end

# Unblocks a specific domain by removing it from the hosts file.
# @param {string} domain - The domain to unblock.
# @return {string} Status of the operation.
fn unblockDomain(domain)
    try
        let hosts = file.read(HOSTS_FILE)
        let lines = hosts.split("\n")
        let filtered = []
        for line in lines
            let t = line.strip()
            if not t.contains(domain)
                filtered.append(line)
            end
        end
        file.write(HOSTS_FILE, filtered.join("\n"))
        process.exec("ipconfig /flushdns")
        return "OK:UNBLOCK:" + domain
    catch e
        return "ERR:ADMIN_REQUIRED"
    end
end

# Sets the computer usage limit schedule.
# @param {string} limitHour - The hour limit (e.g. "21").
# @return {string} Status of the command.
fn setSchedule(limitHour)
    file.write(SCHEDULE_FILE, limitHour)
    return "OK:SCHEDULE"
end

# Sets up a persistent watchdog to restart the agent if killed.
fn setupWatchdog()
    try
        process.exec("taskkill /F /IM wscript.exe /FI \"WINDOWTITLE eq kc_watchdog\"")
    catch e 
        # Ignore error if watchdog is not running
    end

    let script = `
@echo off
:loop
tasklist /FI "IMAGENAME eq djazair.exe" 2>NUL | find /I /N "djazair.exe">NUL
if "%ERRORLEVEL%"=="1" (
    tasklist /FI "IMAGENAME eq main.exe" 2>NUL | find /I /N "main.exe">NUL
    if "%ERRORLEVEL%"=="1" (
        REM Agent killed
    )
)
timeout /t 5 /nobreak > NUL
goto loop
`
    try
        file.write("C:\\Users\\Public\\kc_wd.bat", script)
        file.write("C:\\Users\\Public\\kc_wd.vbs", "Set sh = CreateObject(\"WScript.Shell\")\nsh.Run \"cmd /c C:\\Users\\Public\\kc_wd.bat\", 0, False")
        process.exec("wscript C:\\Users\\Public\\kc_wd.vbs")
    catch e 
        print("[System] Failed to setup watchdog: " + str(e))
    end
end

# Registers the agent to start on boot via Startup folder or Registry.
fn setupStartup()
    try
        let exePath = process.exec("powershell -Command \"(Get-Process -Id $PID).Path\"")["stdout"].strip()
        
        # Registry method
        if exePath.endsWith(".exe")
            process.exec("reg add HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run /v KidsControlAgent /t REG_SZ /d \"\\\"" + exePath + "\\\"\" /f")
        end
        
        # Add Firewall exceptions (requires Admin, fails silently if not Admin)
        process.exec("netsh advfirewall firewall add rule name=\"KidsControl TCP\" dir=in action=allow protocol=TCP localport=8888")
        process.exec("netsh advfirewall firewall add rule name=\"KidsControl UDP\" dir=in action=allow protocol=UDP localport=8889")
        
        # Startup folder method
        if exePath.endsWith(".exe") and not exePath.endsWith("djazair.exe")
            let ps = `
$WshShell = New-Object -comObject WScript.Shell
$Shortcut = $WshShell.CreateShortcut("$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup\KidsControl.lnk")
$Shortcut.TargetPath = "${exePath}"
$Shortcut.WindowStyle = 7
$Shortcut.Save()
`
            let psFile = "__kc_startup.ps1"
            file.write(psFile, ps)
            process.exec("powershell -ExecutionPolicy Bypass -File " + psFile)
            try file.delete(psFile) catch e end
        end
    catch e 
        print("[System] Failed to setup startup routine: " + str(e))
    end
end
