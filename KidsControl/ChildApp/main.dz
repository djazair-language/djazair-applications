# =============================================================================
# ChildApp/main.dz — Kids Control Agent (Child-Side Reverse Connection)
# Connects OUTBOUND to Parent Master Server
# =============================================================================

use net
use thread
use process
use file
use json
use datetime

import "core/identity.dz" as idModule
import "core/router.dz" as routerModule
import "core/constants.dz" as constants

# 1. Initialize Machine Identity & Router
let identity = new idModule.IdentityService()
let router = new routerModule.CommandRouter(identity)

let deviceId = identity.getDeviceId()
let hostname = identity.getHostname()

print("================================================")
print("  Kids Control Reverse Agent (Child-Side)")
print("  Device ID    : " + deviceId)
print("  Hostname     : " + hostname)
print("  Target Parent: " + constants.PARENT_HOST + ":" + str(constants.PARENT_PORT))
print("================================================")

# Function to detect local IP address
fn getLocalIp()
    try
        let out = process.exec("ipconfig")
        let text = if isMap(out) and out.has("stdout") ? out["stdout"] else str(out)
        let lines = text.split("\n")
        for line in lines
            if line.contains("IPv4") and line.contains(":")
                let parts = line.split(":")
                if parts.length() >= 2
                    let ip = parts[1].strip()
                    if ip.startsWith("192.168.") or ip.startsWith("10.") or ip.startsWith("172.")
                        return ip
                    end
                end
            end
        end
        return "127.0.0.1"
    catch e
        return "127.0.0.1"
    end
end

let localIp = getLocalIp()

# ─── Dynamic IP Cache ──────────────────────────────────────────────────────────
# Saves the last working Parent IP so we can try it first if PARENT_HOST changes.
let LAST_IP_FILE = ".last_parent_ip"
let parentHosts = [constants.PARENT_HOST]
try
    if file.isFile(LAST_IP_FILE)
        let saved = file.read(LAST_IP_FILE).strip()
        if saved != "" and saved != constants.PARENT_HOST
            parentHosts = [saved, constants.PARENT_HOST]
        end
    end
catch e end

# ─── Exponential Backoff State ─────────────────────────────────────────────────
let failCount     = 0
let BASE_INTERVAL = constants.CHECKIN_INTERVAL_SECONDS

fn getWaitTime()
    if failCount == 0  return 0.5 end
    if failCount <= 3  return 1.0 end
    if failCount <= 10 return 5.0 end
    return 30.0
end

# 2. Main Agent Connection & Command Execution Loop
let pendingResult = Null
let pendingResultCmdId = Null
let shouldExit = False

# Smart Sync State
let lastActiveWindow = ""
let lastProcCheck = 0.0
let lastWinCheck = 0.0

while True
    let connected = False
    let receivedExec = False

    try
        # Try each known parent host (last working first, then default)
        for parentHost in parentHosts
            let client = new net.tcpClient()
            let ok = client.connect(parentHost, constants.PARENT_PORT)
            if ok
                connected = True
                # Save this working IP for next time
                try file.write(LAST_IP_FILE, parentHost) catch e end
                # Keep it first in the list next iteration
                if parentHosts[0] != parentHost
                    parentHosts = [parentHost, parentHosts[0]]
                end

                let nowTs = datetime.now().timestamp()

                # --- Smart Sync Checks ---
                # Check active window every 2.5 seconds (running .exe is slow)
                if nowTs - lastWinCheck >= 2.5
                    lastWinCheck = nowTs
                    let currWin = router.dispatch("ACTIVE_WINDOW")
                    if currWin.startsWith("ACTIVE_WINDOW:")
                        currWin = currWin.slice(14).strip()
                    end
                    lastActiveWindow = currWin
                end

                # Check process count every 5.0 seconds
                let procsChanged = False
                if nowTs - lastProcCheck >= 5.0
                    lastProcCheck = nowTs
                    let pList = router.dispatch("PROCESSES")
                    let pCount = pList.split("\n").length()
                    if lastProcCount != -1 and pCount != lastProcCount
                        procsChanged = True
                    end
                    lastProcCount = pCount
                end

                let req = {
                    "secret":   constants.SECRET_KEY,
                    "id":       deviceId,
                    "hostname": hostname,
                    "ip":       localIp,
                    "active_window": lastActiveWindow
                }
                if procsChanged
                    req["processes_changed"] = True
                end

                let sentCmdId = Null
                if !isNull(pendingResult)
                    req["result_cmd_id"] = pendingResultCmdId
                    req["result"] = pendingResult
                    sentCmdId = pendingResultCmdId
                end

                print("[ChildApp] Sending check-in payload...")
                client.send(json.encode(req))
                client.shutdown(net.SD_SEND)
                print("[ChildApp] Sent. Waiting for response...")

                let respRaw = client.receiveAll()
                print("[ChildApp] Received response: " + str(respRaw))
                client.close()

                if !isNull(sentCmdId) and pendingResultCmdId == sentCmdId
                    pendingResult = Null
                    pendingResultCmdId = Null
                end

                if shouldExit
                    process.exit(0)
                end

                if !isNull(respRaw) and respRaw != ""
                    let resp = json.decode(respRaw)
                    if type(resp) == "Map" and resp.has("action") and resp["action"] == "EXEC"
                        let cmd = resp["command"]
                        let cmdId = resp["cmd_id"]
                        let output = router.dispatch(cmd)
                        pendingResult = output
                        pendingResultCmdId = cmdId
                        if cmd == "EXIT"
                            shouldExit = True
                        end
                        # Set flag to skip sleep and instantly deliver result
                        receivedExec = True
                    end
                end

                # Success — reset backoff
                failCount = 0
                break # Break out of the inner parentHosts loop!
            end
            try client.close() catch e end
        end
    catch e
        if shouldExit
            process.exit(0)
        end
    end

    if !connected
        failCount += 1
    end

    # If we received a command, skip sleeping so we can send the result immediately
    if receivedExec
        continue
    end

    process.sleep(getWaitTime())
end
