# =============================================================================
# main.dz — Kids Control Agent (Server-Side)
# Refactored for modularity and professional standards.
# =============================================================================

use net
use process
use thread
use file
use datetime

import "core/security.dz" as security
import "core/commands.dz" as commands
import "../Shared/constants.dz" as constants

# Initialize system dependencies
security.setupWatchdog()
security.setupStartup()

# Get the hostname to identify the machine
let systemHostname = "Unknown"
try
    systemHostname = process.exec("hostname")["stdout"].strip()
catch e
    print("[Agent] Failed to retrieve hostname: " + str(e))
end

# Starts the schedule monitoring thread.
# Checks the configured schedule and locks the workstation if limits are exceeded.
fn startScheduleMonitor()
    let monitorCode = `
use file
use datetime
use process
let SCHEDULE_FILE = "C:\\Users\\Public\\kc_schedule.txt"
while True
    try
        if file.isFile(SCHEDULE_FILE)
            let limitHour = num(file.read(SCHEDULE_FILE).strip())
            let h = datetime.now().hour()
            if (h >= limitHour or h < 6) and limitHour > 0
                process.exec("rundll32.exe user32.dll,LockWorkStation")
            end
        end
    catch e 
        # Ignore read errors
    end
    process.sleep(60.0)
end
`
    thread.spawnCode(monitorCode)
end

# Starts the UDP Discovery Server to respond to ParentApp broadcasts
fn startDiscoveryServer(hostname)
    let bcastCode = `
use net
use thread

let UDP_PORT = ` + str(constants.UDP_DISCOVERY_PORT) + `
let DISCOVER_PAYLOAD = "` + constants.DISCOVER_PAYLOAD + `"
let HERE_PREFIX = "` + constants.HERE_PREFIX + `"
let hname = "` + hostname + `"

let s = new net.udpServer(fn(data, ip, port)
    if data == DISCOVER_PAYLOAD
        s.reply(HERE_PREFIX + hname, ip, port)
    end
end)

try
    s.listen(UDP_PORT, "0.0.0.0")
catch e
    print("[Discovery] Error starting UDP server: " + str(e))
end
`
    thread.spawnCode(bcastCode)
end

# Start the background schedule monitor and discovery server
startScheduleMonitor()
startDiscoveryServer(systemHostname)

# Setup the main TCP Server for receiving commands from ParentApp
let server = new net.tcpServer(fn(client, ip, port)
    print("[Agent] Connection from " + ip + ":" + str(port))
    let raw = Null
    try
        raw = client.receive(131072)    # 128 KB buffer
    catch e
        print("[Agent] Error receiving data: " + str(e))
        raw = Null
    end

    if not isNull(raw) and raw != ""
        let response = commands.dispatch(raw, systemHostname)
        try
            client.send(response)
        catch e
            print("[Agent] Send error: " + str(e))
        end
    end

    print("[Agent] Connection closed with " + ip)
    client.close()
end, {"timeout": 10})

# Start Agent
print("================================================")
print("  Kids Control Agent — TCP port " + str(constants.TCP_PORT))
print("  Hostname: " + systemHostname)
print("================================================")
server.listen(constants.TCP_PORT)
