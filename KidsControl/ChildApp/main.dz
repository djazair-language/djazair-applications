# =============================================================================
# main.dz — Kids Control Agent (Child-Side)
# Professional Object-Oriented Architecture
# =============================================================================

use net
use thread
use process

import "core/identity.dz" as idModule
import "core/router.dz" as routerModule
import "services/system.dz" as sysModule
import "core/constants.dz" as constants

# 1. Initialize Machine Identity
let identity = new idModule.IdentityService()
let deviceId = identity.getDeviceId()
let hostname = identity.getHostname()

print("================================================")
print("  Kids Control Agent (Child-Side)")
print("  Device ID : " + deviceId)
print("  Hostname  : " + hostname)
print("  TCP Port  : " + str(constants.TCP_PORT))
print("  UDP Port  : " + str(constants.UDP_DISCOVERY_PORT))
print("================================================")

# 2. Start Background Schedule Monitor
let systemService = new sysModule.SystemService()
systemService.startScheduleMonitor()

# 3. Start UDP Discovery Responder
fn startDiscoveryServer(devId, host)
    let bcastCode = `
use net
use thread

let UDP_PORT = ` + str(constants.UDP_DISCOVERY_PORT) + `
let DISCOVER_PAYLOAD = "` + constants.DISCOVER_PAYLOAD + `"
let HERE_PREFIX = "` + constants.HERE_PREFIX + `"
let devId = "` + devId + `"
let host = "` + host + `"

let s = new net.udpServer(fn(data, ip, port)
    if data == DISCOVER_PAYLOAD
        s.reply(HERE_PREFIX + devId + ":" + host, ip, port)
    end
end)

try
    s.listen(UDP_PORT, "0.0.0.0")
catch e
    print("[Discovery] Error starting UDP server: " + str(e))
end
`
    thread.spawnCode(bcastCode)
end

startDiscoveryServer(deviceId, hostname)

# 4. Initialize Command Router
let router = new routerModule.CommandRouter(identity)

# 5. Start TCP Server
let server = new net.tcpServer(fn(client, ip, port)
    print("[Agent] Connection from " + ip + ":" + str(port))
    let raw = Null
    try
        raw = client.receive(131072)
    catch e
        print("[Agent] Receive error: " + str(e))
        raw = Null
    end

    if not isNull(raw) and raw != ""
        let response = router.dispatch(raw)
        try
            client.send(response)
        catch e
            print("[Agent] Send error: " + str(e))
        end
    end

    print("[Agent] Connection closed with " + ip)
    client.close()
end, {"timeout": 10})

server.listen(constants.TCP_PORT)
