# =============================================================================
# ParentApp/main.dz — Kids Control Dashboard (Parent-Side)
# Modular Architecture Refactoring
# =============================================================================

use webview
import "core/config.dz" as config
import "bridge/settings.dz" as settings
import "bridge/network.dz" as network
import "bridge/commands.dz" as commands
import "ui/builder.dz" as ui

# 1. Initialize Settings
config.loadSettingsData()

# 2. Create Webview App
let app = webview.createWindow({
    "title":  "Kids Control Center",
    "width":  1280.0,
    "height": 800.0,
    "debug":  True
})

# 4. On Ready Handler
app.onReady(fn()
    # Register IPC Handlers
    settings.register(app)
    network.register(app)
    commands.register(app)

    # Render UI
    app.window.setHtml(ui.getHtml())
end)

# 5. Start Application
app.run()
