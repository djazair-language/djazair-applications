use json
use file
use path

let BASE_DIR = "."
if file.exists("ParentApp/main.dz")
    BASE_DIR = "ParentApp"
end

let SETTINGS_FILE = path.join(BASE_DIR, "settings.json")
let DEVICES_FILE = path.join(BASE_DIR, "children.json")

let currentSettings = {
    "auto_start": True
}

fn loadSettingsData()
    try
        if file.isFile(SETTINGS_FILE)
            let s = file.read(SETTINGS_FILE)
            let d = json.decode(s)
            if type(d) == "Map"
                for k in d.keys()
                    currentSettings[k] = d[k]
                end
            end
        end
        
        return currentSettings
    catch e
        return currentSettings
    end
end

fn saveSettingsData(payload)
    try
        for k in payload.keys()
            currentSettings[k] = payload[k]
        end
        file.write(SETTINGS_FILE, json.encode(currentSettings))
        return True
    catch e
        return False
    end
end
