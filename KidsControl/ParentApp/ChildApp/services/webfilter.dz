use process
use file

# =============================================================================
# WebFilterService — Manages website blocking and unblocking via Hosts file.
# =============================================================================
class WebFilterService
    init()
        self.hostsFile = "C:\\Windows\\System32\\drivers\\etc\\hosts"
    end

    # Blocks a specific domain by redirecting it to 127.0.0.1.
    # @param {string} domain - Domain name to block (e.g. youtube.com).
    # @return {string} Status of the operation.
    blockDomain(domain)
        try
            let hosts = file.read(self.hostsFile)
            let entry = "127.0.0.1 " + domain
            let entryWww = "127.0.0.1 www." + domain
            if not hosts.contains(entry)
                file.write(self.hostsFile, hosts + "\r\n" + entry + "\r\n" + entryWww)
                process.exec("ipconfig /flushdns")
            end
            return "OK:BLOCK:" + domain
        catch e
            return "ERR:ADMIN_REQUIRED"
        end
    end

    # Unblocks a specific domain by removing it from the hosts file.
    # @param {string} domain - Domain name to unblock.
    # @return {string} Status of the operation.
    unblockDomain(domain)
        try
            let hosts = file.read(self.hostsFile)
            let lines = hosts.split("\n")
            let filtered = []
            for line in lines
                let t = line.strip()
                if not t.contains(domain)
                    filtered.append(line)
                end
            end
            file.write(self.hostsFile, filtered.join("\n"))
            process.exec("ipconfig /flushdns")
            return "OK:UNBLOCK:" + domain
        catch e
            return "ERR:ADMIN_REQUIRED"
        end
    end
end
