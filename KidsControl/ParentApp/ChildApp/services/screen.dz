import "../core/native.dz" as native

# =============================================================================
# ScreenService — Manages visual monitoring (Screen Capture & Webcam).
# =============================================================================
class ScreenService
    init()
    end

    # Captures a desktop screenshot as a base64 string.
    # @return {string} Base64 image prefixed with SCREENSHOT:
    captureScreen()
        return native.takeScreenshot()
    end

    # Captures a webcam frame as a base64 string.
    # @return {string} Base64 image prefixed with WEBCAM:
    captureWebcam()
        return native.takeWebcamSnapshot()
    end
end
