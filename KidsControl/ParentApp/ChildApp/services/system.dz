use process
use file
use json
use thread
use datetime
import "../core/native.dz" as native

# =============================================================================
# SystemService — Manages core system diagnostics, schedule limits, and controls.
# =============================================================================
class SystemService
    init()
        self.scheduleFile = "C:\\Users\\Public\\kc_schedule.txt"
    end

    # Executes a PowerShell script and returns the stdout output.
    _runPowerShell(script)
        let tmpFile = "__kc_tmp.ps1"
        file.write(tmpFile, script)
        let result = process.exec("powershell -ExecutionPolicy Bypass -NoProfile -NonInteractive -File " + tmpFile)
        try
            file.delete(tmpFile)
        catch e
        end
        return result["stdout"].strip()
    end

    # Retrieves a specific value from a WMIC query.
    _wmicValue(query)
        let r = process.exec(query)
        let lines = r["stdout"].split("\n")
        for line in lines
            let t = line.strip()
            if t.contains("=") and not t.startsWith("=")
                let idx = t.index("=")
                return t.slice(idx + 1, t.length()).strip()
            end
        end
        return ""
    end

    # Gathers system hardware and OS information.
    # @return {string} JSON encoded system info prefixed with SYSINFO:
    getSysInfo()
        let hostname = ""
        let osCaption = ""
        let cpu = ""
        let ramTotal = ""
        let ramFree = ""
        let username = ""
        let bootTime = ""

        try hostname = process.exec("hostname")["stdout"].strip() catch e end
        try username = process.exec("whoami")["stdout"].strip()   catch e end
        try osCaption = self._wmicValue("wmic os get Caption /value")   catch e end
        try cpu = self._wmicValue("wmic cpu get Name /value")           catch e end
        try
            let bytes = num(self._wmicValue("wmic ComputerSystem get TotalPhysicalMemory /value"))
            ramTotal = str(int(bytes / 1073741824.0)) + " GB"
        catch e
        end
        try
            let kb = num(self._wmicValue("wmic OS get FreePhysicalMemory /value"))
            ramFree = str(int(kb / 1048576.0)) + " GB"
        catch e
        end
        try
            bootTime = self._wmicValue("wmic os get LastBootUpTime /value").slice(0, 14)
        catch e
        end

        let info = {
            "hostname": hostname,
            "username": username,
            "os":       osCaption,
            "cpu":      cpu,
            "ram_total": ramTotal,
            "ram_free":  ramFree,
            "boot_time": bootTime
        }
        return "SYSINFO:" + json.encode(info)
    end

    # Returns the active window title.
    getActiveWindow()
        return native.getActiveWindow()
    end

    # Locks the workstation.
    lockWorkstation()
        process.exec("rundll32.exe user32.dll,LockWorkStation")
        return "OK:LOCK"
    end

    # Powers off the computer.
    shutdown()
        process.exec("shutdown /s /t 5")
        return "OK:SHUTDOWN"
    end

    # Reboots the computer.
    restart()
        process.exec("shutdown /r /t 5")
        return "OK:RESTART"
    end

    # Displays a popup alert message to the child.
    showMessage(text)
        let escaped = text.replace("\"", "'")
        let script = `
Add-Type -AssemblyName System.Windows.Forms
[System.Windows.Forms.MessageBox]::Show("${escaped}", "Message from Parent") | Out-Null
`
        self._runPowerShell(script)
        return "OK:MSG"
    end

    # Executes a raw command in the shell.
    execCommand(cmd)
        let result = process.exec(cmd)
        return "EXEC_RESULT:" + result["stdout"] + result["stderr"]
    end

    # Sets the bedtime usage limit hour.
    setSchedule(limitHour)
        try
            file.write(self.scheduleFile, str(limitHour))
            return "OK:SCHEDULE"
        catch e
            return "ERR:SCHEDULE_FAILED"
        end
    end

    # Starts the background schedule monitoring thread.
    startScheduleMonitor()
        let monitorCode = `
use file
use datetime
use process
let SCHEDULE_FILE = "C:\\Users\\Public\\kc_schedule.txt"
while True
    try
        if file.isFile(SCHEDULE_FILE)
            let limitHour = num(file.read(SCHEDULE_FILE).strip())
            let h = datetime.now().hour()
            if (h >= limitHour or h < 6) and limitHour > 0
                process.exec("rundll32.exe user32.dll,LockWorkStation")
            end
        end
    catch e
    end
    process.sleep(60.0)
end
`
        thread.spawnCode(monitorCode)
    end
end
