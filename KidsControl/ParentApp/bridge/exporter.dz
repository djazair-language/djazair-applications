use dpack
use webview
use file
use dir
use path
use process
use math
import "../core/config.dz" as config
import "../core/constants.dz" as constants

# Registers the Child Agent Exporter IPC handlers.
# @param {App} app - The WebView application instance.
fn register(app)
    # Event: selectExportFolder
    # Opens native Windows folder browser dialog.
    app.bridge.on("selectExportFolder", fn(payload)
        try
            let chosen = webview.showOpenFolderDialog({
                "title": "Select Export Destination Folder"
            })
            if isNull(chosen) or chosen == ""
                return ""
            end
            return chosen
        catch e
            return ""
        end
    end)

    # Event: exportChildAgent
    # Packages a customized, standalone ChildApp executable on demand.
    app.bridge.on("exportChildAgent", fn(payload)
        try
            let appName = "KidsControlAgent.exe"
            if payload.has("appName") and payload["appName"] != ""
                appName = payload["appName"]
            end
            if !appName.endsWith(".exe")
                appName = appName + ".exe"
            end

            let parentHost = "127.0.0.1"
            if payload.has("parentHost") and payload["parentHost"] != ""
                parentHost = payload["parentHost"]
            end

            let parentPort = constants.MASTER_PORT
            if payload.has("parentPort") and num(payload["parentPort"]) > 0
                parentPort = num(payload["parentPort"])
            end

            let secretKey = constants.SECRET_KEY
            if payload.has("secretKey") and payload["secretKey"] != ""
                secretKey = payload["secretKey"]
            end

            let consoleMode = False
            if payload.has("consoleMode")
                consoleMode = bool(payload["consoleMode"])
            end

            # Custom export destination folder
            let exportDir = "exports"
            if payload.has("exportFolder") and payload["exportFolder"] != ""
                exportDir = payload["exportFolder"]
            end

            # Locate ChildApp template directory
            let childDir = "../ChildApp"
            if !file.exists(childDir + "/main.dz")
                childDir = "ChildApp"
            end
            if !file.exists(childDir + "/main.dz")
                return {"ok": False, "error": "ChildApp source template not found on disk."}
            end

            # Ensure export output directory exists
            try dir.createAll(exportDir) catch e end
            let absExportDir = path.resolve(exportDir)
            let absChildDir  = path.resolve(childDir)
            let finalExePath = path.join(absExportDir, appName)

            # Update / customize constants.dz in ChildApp before packaging
            let constantsFile = path.join(childDir, "core", "constants.dz")
            let consoleModeStr = "False"
            if consoleMode
                consoleModeStr = "True"
            end
            let constantsCode = `# Custom generated ChildApp configuration (Reverse Connection)
let SECRET_KEY = "` + secretKey + `"
let PARENT_HOST = "` + parentHost + `"
let PARENT_PORT = ` + str(parentPort) + `
let CHECKIN_INTERVAL_SECONDS = 1.0
`
            file.write(constantsFile, constantsCode)

            # Write a temp build script INSIDE ChildApp dir so dpack paths are correct
            # (same as build.dz: entry=main.dz, assets=core/ services/ KidsControlNative.exe)
            let safeOut = finalExePath.replace("\\", "\\\\")
            let tempBuildCode = `use dpack
dpack.pack("main.dz", "` + safeOut + `", {
    "console": ` + consoleModeStr + `,
    "portable": True,
    "assets": ["core/", "services/", "KidsControlNative.exe"],
    "quiet": True
})
`
            let tempBuildFile = path.join(absChildDir, "_export_build_tmp.dz")
            file.write(tempBuildFile, tempBuildCode)

            # Execute from ChildApp directory so relative imports are resolved correctly
            process.exec("cmd /c cd /d \"" + absChildDir + "\" && djazair _export_build_tmp.dz")

            # Cleanup temp build script
            try file.delete(tempBuildFile) catch e end

            if !file.isFile(finalExePath)
                return {"ok": False, "error": "Build completed but output file not found: " + finalExePath}
            end

            let size = file.size(finalExePath)
            let sizeStr = str(math.floor(size / 1048576.0)) + " MB"
            if size < 1048576
                sizeStr = str(math.floor(size / 1024.0)) + " KB"
            end

            return {
                "ok": True,
                "path": finalExePath,
                "folder": absExportDir,
                "filename": appName,
                "size": sizeStr
            }
        catch e
            return {"ok": False, "error": "Build failed: " + str(e)}
        end
    end)

    # Event: openExportFolder
    # Opens the export folder in Windows File Explorer.
    app.bridge.on("openExportFolder", fn(payload)
        try
            let folder = "exports"
            if isString(payload) and payload != ""
                folder = payload
            end
            process.exec("explorer.exe \"" + folder + "\"")
            return True
        catch e
            return False
        end
    end)
end
