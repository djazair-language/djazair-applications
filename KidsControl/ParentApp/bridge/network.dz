use net
use process
use thread
use datetime
use file
use json
import "../core/config.dz" as config
import "../../Shared/constants.dz" as constants

let SCAN_RESULTS_FILE = "__kc_scan_results.json"
let knownOnline = {}

# Background thread code for Continuous Zero-Latency Scanner
let BG_SCANNER_CODE = `
use net
use process
use thread
use file
use json

let port = ` + str(constants.TCP_PORT) + `
let UDP_PORT = ` + str(constants.UDP_DISCOVERY_PORT) + `
let DISCOVER_PAYLOAD = "` + constants.DISCOVER_PAYLOAD + `"
let HERE_PREFIX = "` + constants.HERE_PREFIX + `"
let PING_PAYLOAD = "` + constants.PING_PAYLOAD + `"
let PONG_PREFIX = "` + constants.PONG_PREFIX + `"

# Deduplicates devices by unique device ID
fn deduplicate(results)
    let seen = {}
    let final = []
    for dev in results
        let did = dev["id"]
        let ip = dev["ip"]
        if not seen.has(did)
            seen[did] = True
            final.append(dev)
        else
            # Prefer LAN IP over loopback 127.0.0.1
            if ip != "127.0.0.1"
                for i in range(final.length())
                    if final[i]["id"] == did and final[i]["ip"] == "127.0.0.1"
                        final[i]["ip"] = ip
                    end
                end
            end
        end
    end
    return final
end

while True
    let candidates = []
    let found = []

    # 1. UDP Broadcast Discovery
    try
        let c = new net.udpClient()
        c.setTimeout(1.0)
        let broadcasts = []
        let r = process.exec("ipconfig")
        let lines = r["stdout"].split("\n")
        for line in lines
            if line.contains("IPv4")
                let parts = line.split(":")
                if parts.length() > 1
                    let ip = parts[1].strip()
                    let octets = ip.split(".")
                    if octets.length() == 4
                        let bcast = octets[0] + "." + octets[1] + "." + octets[2] + ".255"
                        if not broadcasts.contains(bcast)
                            broadcasts.append(bcast)
                        end
                    end
                end
            end
        end
        if broadcasts.length() == 0
            broadcasts.append("255.255.255.255")
        end
        for bcast in broadcasts
            try c.send(DISCOVER_PAYLOAD, bcast, UDP_PORT) catch e end
        end
        let receiving = True
        while receiving
            try
                let response = c.receiveFrom(1024)
                let d = response["data"]
                if type(d) == "String" and d.startsWith(HERE_PREFIX)
                    if not candidates.contains(response["ip"])
                        candidates.append(response["ip"])
                    end
                end
            catch e
                receiving = False
            end
        end
        c.close()
    catch e end

    # 2. ARP Cache Fallback
    try
        let r2 = process.exec("arp -a")
        let lines2 = r2["stdout"].split("\n")
        for line in lines2
            let t = line.strip()
            if t.length() > 10 and not t.contains("Interface")
                let parts = t.split(" ")
                let ips = []
                for p in parts
                    if p != "" ips.append(p) end
                end
                if ips.length() >= 1
                    let ip = ips[0]
                    if ip.contains(".") and ip != "127.0.0.1" and ip != "255.255.255.255"
                        if not candidates.contains(ip) candidates.append(ip) end
                    end
                end
            end
        end
    catch e end

    if not candidates.contains("127.0.0.1") candidates.append("127.0.0.1") end

    # 3. Parallel TCP Handshake with Thread Pool
    let workerCode = \`
use thread
use net
use json
let running = True
while running
    let msg = thread.receive()
    if isNull(msg) or msg == "SHUTDOWN"
        running = False
    else
        let req = json.decode(msg)
        let payload = req["data"]
        let ip = payload["ip"]
        let port = payload["port"]
        let rContent = ""
        try
            let c = new net.tcpClient()
            c.setTimeout(2.0)
            if c.connect(ip, port)
                c.send("` + constants.PING_PAYLOAD + `")
                let r = c.receive(256)
                c.close()
                if !isNull(r) and type(r) == "String" and r.startsWith("` + constants.PONG_PREFIX + `")
                    rContent = r
                end
            end
        catch e end
        thread.reply(json.encode({"id": req["id"], "data": rContent}))
    end
end
\`

    let poolSize = candidates.length()
    if poolSize > 30 poolSize = 30 end
    let p = thread.inlinePool(workerCode, poolSize)
    let payloads = []
    for ip in candidates payloads.append({"ip": ip, "port": port}) end

    let results = p.map(payloads, 3.0)
    p.close()

    if !isNull(results) and type(results) == "Array"
        for i in range(candidates.length())
            let ip = candidates[i]
            let rContent = results[i]
            if !isNull(rContent) and type(rContent) == "String" and rContent != ""
                let devId = "KC-" + ip
                let hname = ip
                if rContent.contains(":")
                    let parts = rContent.split(":")
                    # Format: PONG:<deviceId>:<hostname>
                    if parts.length() >= 3
                        devId = parts[1].strip()
                        hname = parts[2].strip()
                    elif parts.length() == 2
                        hname = parts[1].strip()
                    end
                end
                if hname == "" or hname == "Unknown"
                    hname = if ip == "127.0.0.1" ? "localhost" else ip
                end
                found.append({"id": devId, "ip": ip, "hostname": hname, "port": port})
            end
        end
    end

    let final = deduplicate(found)
    file.write("__kc_scan_results.json", json.encode(final))
    process.sleep(3.0)
end
`

fn notifyOnline(hostname)
    let code = `
use file
use process
let ps = \`
Add-Type -AssemblyName System.Windows.Forms
$balloon = New-Object System.Windows.Forms.NotifyIcon
$balloon.Icon = [System.Drawing.SystemIcons]::Information
$balloon.BalloonTipIcon = 'Info'
$balloon.BalloonTipTitle = 'Kids Control Center'
$balloon.BalloonTipText = 'Device [${hostname}] is now online!'
$balloon.Visible = $true
$balloon.ShowBalloonTip(3000)
Start-Sleep -Seconds 4
$balloon.Dispose()
\`
file.write("__kc_notify.ps1", ps)
process.exec("powershell -WindowStyle Hidden -ExecutionPolicy Bypass -File __kc_notify.ps1")
try file.delete("__kc_notify.ps1") catch e end
`
    thread.spawnCode(code)
end

# Registers the network IPC handlers for the UI.
fn register(app)
    # Start the continuous background scanner
    thread.spawnCode(BG_SCANNER_CODE)

    # Event: scanNetwork
    app.bridge.on("scanNetwork", fn(payload)
        let found = []
        try
            if file.isFile(SCAN_RESULTS_FILE)
                let data = file.read(SCAN_RESULTS_FILE)
                found = json.decode(data)
            end
        catch e end

        # Handle notifications for newly online devices
        let newOnline = {}
        if type(found) == "Array"
            for dev in found
                if type(dev) == "Map" and dev.has("id")
                    let did = dev["id"]
                    let h = if dev.has("hostname") ? dev["hostname"] else did
                    newOnline[did] = True
                    if not knownOnline.has(did)
                        notifyOnline(h)
                    end
                end
            end
        end

        let keys = knownOnline.keys()
        for k in keys knownOnline.pop(k) end
        for k in newOnline.keys() knownOnline[k] = True end

        return found
    end)

    # Event: refreshDevices
    app.bridge.on("refreshDevices", fn(payload)
        let found = []
        try
            if file.isFile(SCAN_RESULTS_FILE)
                let data = file.read(SCAN_RESULTS_FILE)
                found = json.decode(data)
            end
        catch e end
        return found
    end)

    app.bridge.on("loadDevices", fn(payload)
        try
            if file.isFile(config.DEVICES_FILE)
                let content = file.read(config.DEVICES_FILE)
                if content != ""
                    return json.decode(content)
                end
            end
        catch e end
        return []
    end)

    app.bridge.on("saveDevices", fn(payload)
        try
            if type(payload) == "String"
                file.write(config.DEVICES_FILE, payload)
                return True
            else
                file.write(config.DEVICES_FILE, json.encode(payload))
                return True
            end
        catch e
            return False
        end
    end)
end
