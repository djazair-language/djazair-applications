# =============================================================================
# ParentApp/bridge/commands.dz — Storage, History & Cache Handlers
# =============================================================================

use datetime
use file
use dir
use path
use json
import "../core/config.dz" as config
import "../core/constants.dz" as constants

# Helpers for storage directories
fn getScreenshotDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let baseDir = path.join(config.BASE_DIR, "storage", "screenshots", safeId)
    try dir.createAll(baseDir) catch e end
    return baseDir
end

fn getWebcamDir(deviceId)
    let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
    let baseDir = path.join(config.BASE_DIR, "storage", "webcam", safeId)
    try dir.createAll(baseDir) catch e end
    return baseDir
end

fn getCacheDir()
    let baseDir = path.join(config.BASE_DIR, "storage", "cache")
    try dir.createAll(baseDir) catch e end
    return baseDir
end

# Registers the storage, history, and cache IPC handlers for the UI.
# @param {App} app - The WebView application instance.
fn register(app)
    # Event: getScreenshotHistory
    app.bridge.on("getScreenshotHistory", fn(payload)
        let deviceId = str(payload)
        if isMap(payload) and payload.has("id")
            deviceId = payload["id"]
        end
        let dirPath = getScreenshotDir(deviceId)
        let result = []
        try
            let files = dir.list(dirPath)
            # Sort newest first (bubble sort, guarded against bidirectional range crash on 1 element)
            if files.length() > 1
                for i in 0..(files.length() - 2)
                    for j in (i+1)..(files.length() - 1)
                        if files[j] > files[i]
                            let tmp = files[i]
                            files[i] = files[j]
                            files[j] = tmp
                        end
                    end
                end
            end
            for f in files
                if f.endsWith(".b64")
                    let fPath = path.join(dirPath, f)
                    try
                        let b64 = file.read(fPath)
                        let timeLabel = f.replace(".b64", "").replace("_", " ").replace("-", ":")
                        result.append({
                            "filename": f,
                            "time": timeLabel,
                            "b64": b64
                        })
                    catch e
                        print("[Bridge] ERROR reading screenshot " + f + ": " + str(e))
                    end
                end
            end
            return result
        catch e
            print("[Bridge] ERROR in getScreenshotHistory: " + str(e))
            return []
        end
    end)

    # Event: deleteScreenshot
    app.bridge.on("deleteScreenshot", fn(payload)
        try
            let deviceId = payload["id"]
            let filename = payload["filename"]
            let fPath = path.join(getScreenshotDir(deviceId), filename)
            if file.exists(fPath)
                file.delete(fPath)
                return True
            end
            return False
        catch e
            return False
        end
    end)

    # Event: getWebcamHistory
    app.bridge.on("getWebcamHistory", fn(payload)
        let deviceId = str(payload)
        if isMap(payload) and payload.has("id")
            deviceId = payload["id"]
        end
        let dirPath = getWebcamDir(deviceId)
        let result = []
        try
            let files = dir.list(dirPath)
            # Sort newest first
            if files.length() > 1
                for i in 0..(files.length() - 2)
                    for j in (i+1)..(files.length() - 1)
                        if files[j] > files[i]
                            let tmp = files[i]
                            files[i] = files[j]
                            files[j] = tmp
                        end
                    end
                end
            end
            for f in files
                if f.endsWith(".b64")
                    let fPath = path.join(dirPath, f)
                    try
                        let b64 = file.read(fPath)
                        let timeLabel = f.replace(".b64", "").replace("_", " ").replace("-", ":")
                        result.append({
                            "filename": f,
                            "time": timeLabel,
                            "b64": b64
                        })
                    catch e
                        print("[Bridge] ERROR reading webcam " + f + ": " + str(e))
                    end
                end
            end
            return result
        catch e
            return []
        end
    end)

    # Event: deleteWebcam
    app.bridge.on("deleteWebcam", fn(payload)
        try
            let deviceId = payload["id"]
            let filename = payload["filename"]
            let fPath = path.join(getWebcamDir(deviceId), filename)
            if file.exists(fPath)
                file.delete(fPath)
                return True
            end
            return False
        catch e
            return False
        end
    end)

    # Event: saveDiskCache
    app.bridge.on("saveDiskCache", fn(payload)
        try
            if type(payload) == "Map" and payload.has("id") and payload.has("data")
                let deviceId = payload["id"].replace(":", "_").replace("/", "_").replace("\\", "_")
                let cPath = path.join(getCacheDir(), deviceId + ".json")
                file.write(cPath, json.encode(payload["data"]))
                return True
            end
            return False
        catch e
            return False
        end
    end)

    # Event: loadDiskCache
    app.bridge.on("loadDiskCache", fn(payload)
        try
            let deviceId = str(payload)
            if isMap(payload) and payload.has("id")
                deviceId = payload["id"]
            end
            let safeId = deviceId.replace(":", "_").replace("/", "_").replace("\\", "_")
            let cPath = path.join(getCacheDir(), safeId + ".json")
            if file.isFile(cPath)
                let strData = file.read(cPath)
                return json.decode(strData)
            end
            return Null
        catch e
            return Null
        end
    end)
end
