# =============================================================================
# ParentApp/bridge/server.dz — Master TCP Server & Real-time Session Bridge
# =============================================================================

use thread
use process
use file
use dir
use path
use json
use datetime
import "../core/config.dz" as config
import "../core/constants.dz" as constants

let BASE_DIR = "."
if file.exists("ParentApp/main.dz")
    BASE_DIR = "ParentApp"
end

let PENDING_CMDS_FILE = path.join(BASE_DIR, "storage", "pending_cmds.json")
let RESULTS_DIR = path.join(BASE_DIR, "storage", "results")
let OFFLINE_TIMEOUT_SECONDS = 3.5

fn ensureStorageDirs()
    try dir.createAll(path.join(BASE_DIR, "storage", "screenshots")) catch e end
    try dir.createAll(path.join(BASE_DIR, "storage", "webcam")) catch e end
    try dir.createAll(path.join(BASE_DIR, "storage", "cache")) catch e end
    try dir.createAll(RESULTS_DIR) catch e end
end

ensureStorageDirs()

# Auto-detect local IP of Parent PC
fn detectParentLocalIp()
    try
        let out = process.exec("ipconfig")
        let text = str(out)
        if isMap(out) and out.has("stdout")
            text = out["stdout"]
        end
        let lines = text.split("\n")

        # Virtual/software adapters to skip (matched against adapter name, case-insensitive)
        # Covers English and French Windows + common VPN/VM software
        let virtualKeywords = ["vmware", "virtualbox", "vbox", "hyper-v", "wsl", "loopback",
                               "bluetooth", "tunnel", "teredo", "isatap", "6to4", "pseudo",
                               "miniport", "cloudflare", "warp", "vpn", "tap"]

        let currentAdapter = ""
        let bestIp = ""      # 192.168.x.x or 10.x.x.x (real LAN)
        let fallbackIp = ""  # 172.x.x.x as last resort

        for line in lines
            let trimmed = line.strip()

            # Adapter header lines: don't start with whitespace, end with ":" or " :"
            let notIndented = !line.startsWith(" ") and !line.startsWith("\t")
            let endsWithColon = trimmed.endsWith(":") or trimmed.endsWith(" :")
            if notIndented and endsWithColon and trimmed.length() > 2
                currentAdapter = trimmed.lower()

            # IPv4 line — English: "IPv4 Address" / French: "Adresse IPv4"
            elif trimmed.contains("IPv4") and trimmed.contains(":")
                # Skip virtual adapters
                let isVirtual = False
                for kw in virtualKeywords
                    if currentAdapter.contains(kw)
                        isVirtual = True
                        break
                    end
                end
                if isVirtual continue end

                # IP is always the last token after the last ":"
                # split(":") then take the last element — no lastIndexOf needed
                let parts = trimmed.split(":")
                let ip = parts[parts.length() - 1].strip()
                if (ip.startsWith("192.168.") or ip.startsWith("10.")) and bestIp == ""
                    bestIp = ip
                elif ip.startsWith("172.") and fallbackIp == ""
                    fallbackIp = ip
                end
            end
        end

        if bestIp != "" return bestIp end
        if fallbackIp != "" return fallbackIp end
        return "127.0.0.1"
    catch e
        return "127.0.0.1"
    end
end

let commandSequence = 1000

# Registers all IPC handlers with ParentApp WebView
fn register(app)
    # Locate and launch Master TCP Server in background thread
    let serverScript = "core/bg_server.dz"
    if !file.exists(serverScript)
        serverScript = "ParentApp/core/bg_server.dz"
    end
    let absServerScript = path.resolve(serverScript)

    try
        thread.spawn(absServerScript)
        print("[Server Bridge] Spawned Master TCP server from: " + absServerScript)
    catch e
        print("[Server Bridge] Failed to spawn server: " + str(e))
    end

    # IPC: getLocalServerIp
    app.bridge.on("getLocalServerIp", fn(payload)
        return detectParentLocalIp()
    end)

    # IPC: loadDevices
    app.bridge.on("loadDevices", fn(payload)
        try
            if file.isFile(config.DEVICES_FILE)
                let data = file.read(config.DEVICES_FILE)
                let list = json.decode(data)
                if type(list) == "Array"
                    let now = datetime.now().timestamp()
                    for d in list
                        if type(d) == "Map"
                            let lastSeen = 0
                            if d.has("last_seen")
                                lastSeen = d["last_seen"]
                            end
                            d["is_online"] = (now - lastSeen) < OFFLINE_TIMEOUT_SECONDS
                        end
                    end
                    return list
                end
            end
            return []
        catch e
            return []
        end
    end)

    # IPC: saveDevices
    app.bridge.on("saveDevices", fn(payload)
        try
            let list = []
            if isArray(payload)
                list = payload
            else
                list = json.decode(str(payload))
            end
            if isArray(list)
                file.write(config.DEVICES_FILE, json.encode(list))
                return True
            end
            return False
        catch e
            return False
        end
    end)

    # IPC: scanNetwork (Instant Refresh from registry with real-time liveness evaluation)
    app.bridge.on("scanNetwork", fn(payload)
        try
            if file.isFile(config.DEVICES_FILE)
                let data = file.read(config.DEVICES_FILE)
                let list = json.decode(data)
                if type(list) == "Array"
                    let now = datetime.now().timestamp()
                    for d in list
                        if type(d) == "Map"
                            let lastSeen = 0
                            if d.has("last_seen")
                                lastSeen = d["last_seen"]
                            end
                            d["is_online"] = (now - lastSeen) < OFFLINE_TIMEOUT_SECONDS
                        end
                    end
                    let finalListJson = json.encode(list)
                    try
                        file.write(config.DEVICES_FILE + ".tmp", finalListJson)
                        try file.delete(config.DEVICES_FILE) catch e end
                        file.rename(config.DEVICES_FILE + ".tmp", config.DEVICES_FILE)
                    catch e
                        file.write(config.DEVICES_FILE, finalListJson)
                    end
                    return list
                end
            end
            return []
        catch e
            return []
        end
    end)

    # IPC: agentCommand
    # Enqueues command in pending_cmds.json and waits for result file from reverse agent.
    app.bridge.on("agentCommand", fn(payload)
        try
            if type(payload) != "Map" or !payload.has("id") or !payload.has("command")
                return {"ok": False, "data": "Invalid request payload"}
            end

            let devId = payload["id"]
            let cmd = payload["command"]
            let now = datetime.now().timestamp()
            commandSequence += 1
            let cmdId = "CMD_" + str(now).replace(".", "") + "_" + str(commandSequence)

            # Read current pending commands map
            let pMap = {}
            try
                if file.isFile(PENDING_CMDS_FILE)
                    let pStr = file.read(PENDING_CMDS_FILE)
                    if pStr != ""
                        pMap = json.decode(pStr)
                    end
                end
            catch e end

            if !pMap.has(devId)
                pMap[devId] = []
            end

            pMap[devId].append({
                "cmd_id": cmdId,
                "command": cmd,
                "timestamp": now
            })

            let pJson = json.encode(pMap)
            try
                file.write(PENDING_CMDS_FILE + ".tmp", pJson)
                try file.delete(PENDING_CMDS_FILE) catch e end
                file.rename(PENDING_CMDS_FILE + ".tmp", PENDING_CMDS_FILE)
            catch e
                file.write(PENDING_CMDS_FILE, pJson)
            end

            # Return immediately so we don't block the UI thread!
            return {"ok": True, "cmd_id": cmdId, "start_time": now}
        catch e
            return {"ok": False, "data": "Internal error: " + str(e)}
        end
    end)

    # IPC: checkCommandResult
    # Polled by Javascript to check if a command has finished without blocking Djazair
    app.bridge.on("checkCommandResult", fn(payload)
        try
            let cmdId = payload["cmd_id"]
            let startTime = payload["start_time"]
            let resFile = path.join(RESULTS_DIR, cmdId + ".json")

            if file.isFile(resFile)
                let rContent = file.read(resFile)
                try file.delete(resFile) catch e end
                let resObj = json.decode(rContent)
                let rData = ""
                if type(resObj) == "Map" and resObj.has("data")
                    rData = resObj["data"]
                end
                let latency = int((datetime.now().timestamp() - startTime) * 1000.0)
                return {"status": "done", "data": rData, "latency": latency}
            end

            return {"status": "pending"}
        catch e
            return {"status": "error", "data": str(e)}
        end
    end)
end
