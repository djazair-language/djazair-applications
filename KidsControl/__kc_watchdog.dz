
use process
use thread
let running = True
while running
    process.sleep(10.0)
    let p = process.exec("tasklist /FI "IMAGENAME eq djazair.exe"")
    let out = p["stdout"]
    
    let count = 0
    let lines = out.split("
")
    for line in lines
        if line.contains("djazair.exe")
            count += 1
        end
    end
    
    if count < 2
        process.exec("start /B djazair.exe ChildApp/main.dz")
    end
end
