# =============================================================================
# Project:      Djazair Prayer Times Desktop Application
# File:         services/storage.dz
# Description:  Persistent storage management for user preferences & prayer cache.
# =============================================================================

use file
use path
use json
use dir

let DEFAULT_SETTINGS = {
    "country": "DZ",
    "city": "Algiers",
    "cityAr": "الجزائر العاصمة",
    "method": 13,
    "adhanEnabled": True,
    "adhanVolume": 80,
    "notificationEnabled": True,
    "startWithWindows": False,
    "startupName": "Djazair Prayer Times",
    "customExeName": "",
    "minimizeToTray": True,
    "ramadanMode": False,
    "selectedVoice": "chime",
    "customAudioPath": "",
    "tasbeehCount": 0,
    "preAdhanEnabled": True,
    "preAdhanMinutes": 10,
    "perPrayerVoicesEnabled": False,
    "prayerVoices": {
        "Fajr": "algerian",
        "Dhuhr": "chime",
        "Asr": "chime",
        "Maghrib": "chime",
        "Isha": "chime"
    },
    "iqamaEnabled": True,
    "iqamaOffsets": {
        "Fajr": 20,
        "Dhuhr": 15,
        "Asr": 15,
        "Maghrib": 10,
        "Isha": 15
    },
    "athkarReminderEnabled": True,
    "isCompactMode": False
}

use process
use env

# Detects base name of the application executable or script
fn getAppBaseName()
    # 1. From dpack environment
    let envName = env.getOr("DPACK_EXE_NAME", "")
    if envName != ""
        if envName.endsWith(".exe")
            return envName.slice(0, envName.length() - 4)
        end
        return envName
    end

    let envExe = env.getOr("DPACK_EXE", "")
    if envExe != ""
        let b = path.basename(envExe)
        if b.endsWith(".exe")
            return b.slice(0, b.length() - 4)
        end
        return b
    end

    # 2. Check parent of .dpack_cache_
    let sDir = process.scriptDir()
    if path.basename(sDir).startsWith(".dpack_cache_")
        let parentDir = path.dirname(sDir)
        let files = dir.list(parentDir)
        for f in files
            if f.endsWith(".exe") and !f.startsWith("djazair")
                return f.slice(0, f.length() - 4)
            end
        end
    end

    # 3. Check current dir / script dir for exe
    let files = dir.list(sDir)
    for f in files
        if f.endsWith(".exe") and !f.startsWith("djazair")
            return f.slice(0, f.length() - 4)
        end
    end

    return "prayer_times"
end

# Gets persistent data directory outside of temporary dpack extraction cache
fn getDataDir()
    let appDir = ""
    let envDir = env.getOr("DPACK_APP_DIR", "")
    if envDir != "" and file.exists(envDir)
        appDir = envDir
    else
        let sDir = process.scriptDir()
        if path.basename(sDir).startsWith(".dpack_cache_")
            appDir = path.dirname(sDir)
        else
            appDir = sDir
        end
    end

    # Attempt local portable data directory first (next to exe)
    let d = path.join(appDir, "data")
    try
        if !file.exists(d)
            dir.createAll(d)
        end
        return d
    catch e
        # If write-protected, fallback to user AppData
        let appData = env.getOr("APPDATA", "")
        let baseName = getAppBaseName()
        if appData != ""
            let userDir = path.join(appData, "Djazair_" + baseName, "data")
            if !file.exists(userDir)
                dir.createAll(userDir)
            end
            return userDir
        end
        return d
    end
end

# Dynamically resolves settings path based on executable name and existing files
fn getSettingsPath()
    let dataDir = getDataDir()
    let baseName = getAppBaseName()

    # 1. First priority: specific settings file for this executable (e.g. salat_settings.json)
    let namedSettings = path.join(dataDir, "${baseName}_settings.json")
    if file.exists(namedSettings)
        return namedSettings
    end

    # 2. Second priority: standard settings.json (ensures existing settings are preserved upon rename)
    let defaultSettings = path.join(dataDir, "settings.json")
    if file.exists(defaultSettings)
        return defaultSettings
    end

    # 3. New file creation: if custom named, use namedSettings, else settings.json
    if baseName != "prayer_times" and baseName != "main" and baseName != "__main__"
        return namedSettings
    end
    return defaultSettings
end

# Dynamically resolves cache path
fn getCachePath()
    let dataDir = getDataDir()
    let baseName = getAppBaseName()

    let namedCache = path.join(dataDir, "${baseName}_cache.json")
    if file.exists(namedCache)
        return namedCache
    end

    let defaultCache = path.join(dataDir, "cache.json")
    if file.exists(defaultCache)
        return defaultCache
    end

    if baseName != "prayer_times" and baseName != "main" and baseName != "__main__"
        return namedCache
    end
    return defaultCache
end

# Loads user settings or initializes with defaults
fn loadSettings()
    let p = getSettingsPath()
    if file.exists(p)
        try
            let content = file.read(p)
            if content.length() > 0
                let s = json.decode(content)
                if isMap(s)
                    # Merge with default keys in case new settings were added
                    for k, v in DEFAULT_SETTINGS
                        if !s.has(k)
                            s[k] = v
                        end
                    end
                    return s
                end
            end
        catch err
            # If corrupted, fallback to defaults
        end
    end
    saveSettings(DEFAULT_SETTINGS)
    return DEFAULT_SETTINGS
end

# Saves settings to JSON
fn saveSettings(settings)
    let p = getSettingsPath()
    try
        let jsonStr = json.encode(settings, 2)
        file.write(p, jsonStr)
        return True
    catch err
        return False
    end
end

# Loads entire prayer cache
fn loadCache()
    let p = getCachePath()
    if file.exists(p)
        try
            let content = file.read(p)
            if content.length() > 0
                let c = json.decode(content)
                if isMap(c)
                    return c
                end
            end
        catch err
        end
    end
    return {}
end

# Retrieves a cached day's prayer timings
fn getCachedTimings(key)
    let cache = loadCache()
    if cache.has(key)
        return cache[key]
    end
    return Null
end

# Saves prayer timings to cache
fn setCachedTimings(key, data)
    let cache = loadCache()
    cache[key] = data
    let p = getCachePath()
    try
        let jsonStr = json.encode(cache, 2)
        file.write(p, jsonStr)
        return True
    catch err
        return False
    end
end
