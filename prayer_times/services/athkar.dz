fn getAllAthkarData()
    return {
        "morning": ATHKAR_MORNING,
        "evening": ATHKAR_EVENING,
        "afterPrayer": ATHKAR_AFTER_PRAYER,
        "ramadan": RAMADAN_DUAAS,
