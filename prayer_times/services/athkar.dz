let RAMADAN_DUAAS = [
    {
        "title": "دعاء الإفطار المأثور",
        "text": "ذَهَبَ الظَّمَأُ، وَابْتَلَّتِ الْعُرُوقُ، وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللَّهُ.",
        "trans": "Dhahaba adh-Dhama'u wabtallatil-'urooq wa thabata al-ajru in sha' Allah"
    },
    {
        "title": "دعاء الصائم المستجاب",
        "text": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِرَحْمَتِكَ الَّتِي وَسِعَتْ كُلَّ شَيْءٍ أَنْ تَغْفِرَ لِي.",
        "trans": "Allahumma inni as'aluka bi-rahmatika allati wasi'at kulla shay'in an taghfira li"
    },
    {
        "title": "دعاء ليلة القدر والشهر المبارك",
        "text": "اللَّهُمَّ إِنَّكَ عَفُوٌّ تُحِبُّ الْعَفْوَ فَاعْفُ عَنِّي.",
        "trans": "Allahumma innaka 'Afuwwun tuhibbul-'afwa fa'fu 'anni"
    }
]

