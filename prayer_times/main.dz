# =============================================================================
# Project:      Djazair Prayer Times Desktop Application
# File:         main.dz
# Description:  Application Bootstrap & Main Entry Point.
# =============================================================================

use webview
use file
use path
use dir

import "core/config.dz" as config
import "core/platform.dz" as platform
import "services/storage.dz" as storage
import "services/api.dz" as api
import "services/geo.dz" as geo
import "services/athkar.dz" as athkar
import "bridge/tray.dz" as trayModule
import "bridge/ipc.dz" as ipc

# Resolve dynamic application metadata
let iconPath = platform.getAppIconPath()
let appBaseName = platform.getAppBaseName()
let displayAppName = "Djazair Prayer Times"
if appBaseName != "prayer_times" and appBaseName != "djazair_prayer" and appBaseName != "main"
    displayAppName = appBaseName
end
let winTitle = "مواقيت الصلاة — " + displayAppName

# Initialize native application window
let app = webview.createWindow({
    "title": winTitle,
    "width": 1020,
    "height": 780,
    "minWidth": 820,
    "minHeight": 600,
    "frameless": True,
    "virtualHostDir": config.UI_DIR,
    "debug": False
})

# Initialize native System Tray
let tray = trayModule.createTray(app, iconPath, winTitle)

# Package services map for dependency injection
let services = {
    "storage": storage,
    "api": api,
    "geo": geo,
    "athkar": athkar,
    "platform": platform,
    "tray": trayModule
}

# Register all IPC channels
ipc.registerIpcHandlers(app, tray, services)

# Lifecycle onReady hook
app.onReady(fn()
    # Set window icon
    if file.exists(iconPath)
        try
            app.window.setIcon(iconPath)
        catch err
        end
    end

    # Handle launch mode (silent background or visible)
    if config.isBackgroundStart
        try
            app.window.hide()
            trayModule.performMinimizeToTray(app, tray)
        catch err
        end
    else
        try
            app.window.center()
            app.window.restore()
            app.window.show()
            app.window.focus()
        catch err
        end
    end

    # Synchronize startup path and audio files
    try
        let initSettings = storage.loadSettings()
        if initSettings.has("customAudioPath") and !isNull(initSettings["customAudioPath"]) and initSettings["customAudioPath"] != ""
            if file.exists(initSettings["customAudioPath"])
                let audioDir = path.join(config.UI_DIR, "audio")
                if !file.exists(audioDir)
                    dir.createAll(audioDir)
                end
                file.copy(initSettings["customAudioPath"], path.join(audioDir, "custom.mp3"))
            end
        end

        if initSettings.has("startWithWindows") and initSettings["startWithWindows"] == True
            platform.setWindowsStartup(True, initSettings.get("startupName", Null), initSettings.get("customExeName", Null))
        end
    catch err
    end

    # Navigate to frontend UI
    let indexHtmlPath = path.join(config.UI_DIR, "index.html")
    if file.exists(indexHtmlPath)
        try
            app.window.navigate("http://djazair.localhost/index.html")
        catch err
            let html = file.read(indexHtmlPath)
            app.window.setHtml(html)
        end
    end
end)

# Start desktop application event loop
app.run()
