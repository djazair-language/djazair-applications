# =============================================================================
# Project:      Djazair Prayer Times Desktop Application
# File:         main.dz
# Description:  Main Application Entry Point, WebView2 Controller & IPC Bridge.
# =============================================================================

use webview
use file
use path
use process
import "services/geo.dz" as geo
import "services/storage.dz" as storage
import "services/api.dz" as api
import "services/athkar.dz" as athkar

let SCRIPT_DIR = process.scriptDir()
let UI_DIR = path.join(SCRIPT_DIR, "ui")

# Helper to configure Windows startup registry
fn setWindowsStartup(enabled)
    let appTarget = path.join(SCRIPT_DIR, "run.bat")
    let exeFile = path.join(SCRIPT_DIR, "prayer_times.exe")
    if file.exists(exeFile)
        appTarget = exeFile
    end

    try
        if enabled
            let cmd = "powershell -WindowStyle Hidden -Command \"Set-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'DjazairPrayerTimes' -Value '\\\"${appTarget}\\\"'\""
            process.exec(cmd)
        else
            let cmd = "powershell -WindowStyle Hidden -Command \"Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'DjazairPrayerTimes' -ErrorAction SilentlyContinue\""
            process.exec(cmd)
        end
    catch err
    end
end

# Path to application icon
let iconPath = path.join(SCRIPT_DIR, "assets", "app.ico")
if !file.exists(iconPath)
    iconPath = path.join(SCRIPT_DIR, "app.ico")
end

# Create native application window
let app = webview.createWindow({
    "title": "مواقيت الصلاة — Djazair Prayer Times",
    "width": 1020,
    "height": 780,
    "minWidth": 820,
    "minHeight": 600,
    "virtualHostDir": UI_DIR,
    "debug": False
})

# Create native System Tray Menu
let trayMenu = new webview.Menu()
trayMenu.addItem("فتح مواقيت الصلاة (Open)", fn()
    app.window.show()
    app.window.restore()
    app.window.center()
    app.window.focus()
end)
trayMenu.addSeparator()
trayMenu.addItem("إغلاق التطبيق نهائياً (Exit)", fn()
    app.quit()
end)

# Create native System Tray Icon
let tray = new webview.Tray("مواقيت الصلاة — Djazair Prayer Times", iconPath)
tray.setMenu(trayMenu)

app.onQuit(fn()
    try
        tray.destroy()
    catch err
    end
end)

app.onReady(fn()
    # Set window icon for taskbar and titlebar
    if file.exists(iconPath)
        try
            app.window.setIcon(iconPath)
        catch err
        end
    end

    # Explicitly position and foreground window on launch
    try
        app.window.center()
        app.window.restore()
        app.window.show()
        app.window.focus()
    catch err
    end

    # Handle window close (Minimize to Tray on Close)
    app.window.onClose(fn()
        let settings = storage.loadSettings()
        let minToTray = settings.get("minimizeToTray", True)
        if minToTray
            app.window.hide()
            try
                tray.showBalloon(
                    "مواقيت الصلاة — شريط المهام",
                    "يعمل التطبيق الآن في الخلفية لتنبيهك بالآذان والأذكار.\nانقر على الأيقونة بجانب الساعة لفتح البرنامج مجدداً.",
                    4
                )
            catch err
            end
            return False
        end
        return True
    end)
    # ── IPC Bridge: Initial Data Channel ─────────────────────────────────────
    app.bridge.on("getInitialData", fn(payload)
        let settings = storage.loadSettings()
        let countries = geo.COUNTRIES
        let prayerData = api.getPrayerTimes(
            settings["country"],
            settings["city"],
            settings["method"]
        )
        let athkarData = athkar.getAllAthkarData()

        return {
            "countries": countries,
            "settings": settings,
            "prayerData": prayerData,
            "athkar": athkarData
        }
    end)

    # ── IPC Bridge: Change Location Channel ──────────────────────────────────
    app.bridge.on("changeLocation", fn(payload)
        let country = payload["country"]
        let city = payload["city"]
        let method = payload.get("method", 13)

        let settings = storage.loadSettings()
        settings["country"] = country
        settings["city"] = city
        storage.saveSettings(settings)

        let prayerData = api.getPrayerTimes(country, city, method)
        return prayerData
    end)

    # ── IPC Bridge: Auto-Detect Location via IP ──────────────────────────────
    app.bridge.on("autoDetectLocation", fn(payload)
        let detected = api.detectLocation()
        if !isNull(detected)
            let settings = storage.loadSettings()
            settings["country"] = detected["country"]
            settings["city"] = detected["city"]
            settings["cityAr"] = detected["cityAr"]
            storage.saveSettings(settings)

            let prayerData = api.getPrayerTimes(detected["country"], detected["city"], settings["method"])
            return {
                "success": True,
                "detected": detected,
                "prayerData": prayerData
            }
        end
        return {"success": False}
    end)

    # ── IPC Bridge: Refresh Prayer Times Channel ─────────────────────────────
    app.bridge.on("refreshPrayerTimes", fn(payload)
        let country = payload["country"]
        let city = payload["city"]
        let method = payload.get("method", 13)

        let prayerData = api.getPrayerTimes(country, city, method)
        return prayerData
    end)

    # ── IPC Bridge: Save Settings Channel ────────────────────────────────────
    app.bridge.on("saveSettings", fn(payload)
        let oldSettings = storage.loadSettings()
        storage.saveSettings(payload)

        # Handle Windows Startup Toggle if changed
        if payload.has("startWithWindows") and payload["startWithWindows"] != oldSettings.get("startWithWindows", False)
            setWindowsStartup(payload["startWithWindows"])
        end

        let prayerData = api.getPrayerTimes(
            payload["country"],
            payload["city"],
            payload["method"]
        )

        return {
            "success": True,
            "settings": payload,
            "prayerData": prayerData
        }
    end)

    # ── IPC Bridge: Select Custom Audio File ─────────────────────────────────
    app.bridge.on("selectCustomAudio", fn(payload)
        let filePath = webview.showOpenFileDialog({
            "title": "اختر ملف صوتي للأذان",
            "filters": [
                {"name": "ملفات الصوت (MP3, WAV, OGG)", "extensions": ["mp3", "wav", "ogg"]},
                {"name": "جميع الملفات", "extensions": ["*"]}
            ]
        })
        if !isNull(filePath) and filePath != ""
            let settings = storage.loadSettings()
            settings["customAudioPath"] = filePath
            settings["selectedVoice"] = "custom"
            storage.saveSettings(settings)
            return {"success": True, "path": filePath}
        end
        return {"success": False}
    end)

    # ── IPC Bridge: Save Tasbeeh Counter ─────────────────────────────────────
    app.bridge.on("saveTasbeeh", fn(payload)
        let count = payload.get("count", 0)
        let settings = storage.loadSettings()
        settings["tasbeehCount"] = count
        storage.saveSettings(settings)
        return True
    end)

    # ── IPC Bridge: Desktop Notification Channel ─────────────────────────────
    app.bridge.on("notifyPrayer", fn(payload)
        let prayer = payload["prayer"]
        let time = payload.get("time", "")

        webview.notificationShow(
            "مواقيت الصلاة",
            "حان الآن موعد أذان صلاة ${prayer} (${time})",
            "حي على الصلاة • حي على الفلاح",
            True,
            "",
            7
        )
        return True
    end)

    # ── IPC Bridge: General Notification Channel (Athkar / Reminders) ─────────
    app.bridge.on("notifyMessage", fn(payload)
        let title = payload.get("title", "تذكير إسلامي")
        let message = payload.get("message", "")
        let sub = payload.get("sub", "")

        webview.notificationShow(title, message, sub, True, "", 6)
        return True
    end)

    # ── IPC Bridge: Test Notification Channel ────────────────────────────────
    app.bridge.on("testNotification", fn(payload)
        webview.notificationShow(
            "مواقيت الصلاة",
            "هذا إشعار تجريبي لمواقيت الصلاة",
            "لغة جزائر - تطبيق سطح المكتب",
            True,
            "",
            5
        )
        return True
    end)

    # ── IPC Bridge: Minimize to System Tray ──────────────────────────────────
    app.bridge.on("minimizeToTray", fn(payload)
        app.window.hide()
        try
            tray.showBalloon(
                "مواقيت الصلاة — شريط المهام",
                "يعمل التطبيق الآن في الخلفية لتنبيهك بالآذان والأذكار.\nانقر على الأيقونة بجانب الساعة لفتح النافذة مجدداً.",
                4
            )
        catch err
        end
        return True
    end)

    # ── IPC Bridge: Restore from Tray ────────────────────────────────────────
    app.bridge.on("restoreWindow", fn(payload)
        try
            app.window.show()
            app.window.restore()
            app.window.center()
            app.window.focus()
        catch err
        end
        return True
    end)

    # ── Load User Interface ──────────────────────────────────────────────────
    let indexHtmlPath = path.join(UI_DIR, "index.html")
    if file.exists(indexHtmlPath)
        try
            app.window.navigate("http://djazair.localhost/index.html")
        catch err
            let html = file.read(indexHtmlPath)
            app.window.setHtml(html)
        end
    end
end)

# Start desktop application
app.run()
