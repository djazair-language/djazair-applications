# =============================================================================
# Project:      Djazair Prayer Times Desktop Application
# File:         bridge/ipc.dz
# Description:  Decoupled IPC bridge handler registration and event routing.
# =============================================================================

use webview
use file
use path
use dir
use process

import "../core/config.dz" as config

# Registers all IPC channels between the WebView frontend and Djazair backend
fn registerIpcHandlers(app, tray, services)
    let storage = services["storage"]
    let api = services["api"]
    let geo = services["geo"]
    let athkar = services["athkar"]
    let platform = services["platform"]
    let trayModule = services["tray"]

    # ── Window Lifecycle & Tray Callbacks ────────────────────────────────────
    app.window.onClose(fn()
        let settings = storage.loadSettings()
        let minToTray = settings.get("minimizeToTray", True)
        if minToTray
            trayModule.performMinimizeToTray(app, tray)
            return False
        end
        return True
    end)

    app.window.onResize(fn(w, h)
        try
            app.bridge.send("window_state_changed", {
                "isMaximized": app.window.isMaximized()
            })
        catch err
        end
    end)

    # ── IPC: Window Controls ─────────────────────────────────────────────────
    app.bridge.on("win_minimize", fn(payload)
        let settings = storage.loadSettings()
        let minToTray = settings.get("minimizeToTray", True)
        if minToTray
            trayModule.performMinimizeToTray(app, tray)
        else
            app.window.minimize()
        end
        return True
    end)

    app.bridge.on("win_close", fn(payload)
        let settings = storage.loadSettings()
        let minToTray = settings.get("minimizeToTray", True)
        if minToTray
            trayModule.performMinimizeToTray(app, tray)
        else
            app.quit()
        end
        return True
    end)

    app.bridge.on("win_toggleMaximize", fn(payload)
        return app.window.toggleMaximize()
    end)

    app.bridge.on("win_isMaximized", fn(payload)
        return app.window.isMaximized()
    end)

    app.bridge.on("minimizeToTray", fn(payload)
        trayModule.performMinimizeToTray(app, tray)
        return True
    end)

    app.bridge.on("restoreWindow", fn(payload)
        try
            app.window.show()
            app.window.restore()
            app.window.center()
            app.window.focus()
        catch err
        end
        return True
    end)

    # ── IPC: Initial Data Channel ────────────────────────────────────────────
    app.bridge.on("getInitialData", fn(payload)
        let settings = storage.loadSettings()
        let countries = geo.COUNTRIES
        let prayerData = api.getPrayerTimes(
            settings["country"],
            settings["city"],
            settings["method"]
        )
        let athkarData = athkar.getAllAthkarData()

        return {
            "countries": countries,
            "settings": settings,
            "settingsPath": storage.getSettingsPath(),
            "prayerData": prayerData,
            "athkar": athkarData
        }
    end)

    # ── IPC: Location & Prayer Times ─────────────────────────────────────────
    app.bridge.on("changeLocation", fn(payload)
        let country = payload["country"]
        let city = payload["city"]
        let method = payload.get("method", 13)

        let settings = storage.loadSettings()
        settings["country"] = country
        settings["city"] = city
        storage.saveSettings(settings)

        return api.getPrayerTimes(country, city, method)
    end)

    app.bridge.on("autoDetectLocation", fn(payload)
        let detected = api.detectLocation()
        if !isNull(detected)
            let settings = storage.loadSettings()
            settings["country"] = detected["country"]
            settings["city"] = detected["city"]
            settings["cityAr"] = detected["cityAr"]
            storage.saveSettings(settings)

            let prayerData = api.getPrayerTimes(detected["country"], detected["city"], settings["method"])
            return {
                "success": True,
                "detected": detected,
                "prayerData": prayerData
            }
        end
        return {"success": False}
    end)

    app.bridge.on("refreshPrayerTimes", fn(payload)
        let country = payload["country"]
        let city = payload["city"]
        let method = payload.get("method", 13)
        return api.getPrayerTimes(country, city, method)
    end)

    # ── IPC: Settings Management ─────────────────────────────────────────────
    app.bridge.on("saveSettings", fn(payload)
        let oldSettings = storage.loadSettings()
        storage.saveSettings(payload)

        # Handle Windows Startup Toggle if changed or if name/exe updated
        if payload.has("startWithWindows")
            let startupChanged = payload["startWithWindows"] != oldSettings.get("startWithWindows", False)
            let nameChanged = payload.get("startupName", "") != oldSettings.get("startupName", "")
            let exeChanged = payload.get("customExeName", "") != oldSettings.get("customExeName", "")
            if startupChanged or nameChanged or exeChanged
                let oldName = oldSettings.get("startupName", Null)
                platform.setWindowsStartup(payload["startWithWindows"], payload.get("startupName", Null), payload.get("customExeName", Null), oldName)
            end
        end

        let prayerData = api.getPrayerTimes(
            payload["country"],
            payload["city"],
            payload["method"]
        )

        return {
            "success": True,
            "settings": payload,
            "settingsPath": storage.getSettingsPath(),
            "prayerData": prayerData
        }
    end)

    app.bridge.on("openSettingsFolder", fn(payload)
        let p = storage.getSettingsPath()
        try
            process.exec("explorer.exe /select,\"" + p.replace("/", "\\") + "\"")
            return True
        catch err
            return False
        end
    end)

    app.bridge.on("selectCustomAudio", fn(payload)
        let filePath = webview.showOpenFileDialog({
            "title": "اختر ملف صوتي للأذان",
            "filters": [
                {"name": "ملفات الصوت (MP3, WAV, OGG)", "extensions": ["mp3", "wav", "ogg"]},
                {"name": "جميع الملفات", "extensions": ["*"]}
            ]
        })
        if !isNull(filePath) and filePath != ""
            try
                let audioDir = path.join(config.UI_DIR, "audio")
                if !file.exists(audioDir)
                    dir.createAll(audioDir)
                end
                file.copy(filePath, path.join(audioDir, "custom.mp3"))
            catch err
            end
            let settings = storage.loadSettings()
            settings["customAudioPath"] = filePath
            settings["selectedVoice"] = "custom"
            storage.saveSettings(settings)
            return {"success": True, "path": filePath}
        end
        return {"success": False}
    end)

    app.bridge.on("saveTasbeeh", fn(payload)
        let count = payload.get("count", 0)
        let settings = storage.loadSettings()
        settings["tasbeehCount"] = count
        storage.saveSettings(settings)
        return True
    end)

    # Helper to display clean notifications via the application's existing tray icon
    let showNotification = fn(title, message, sub = "", timeout = 6)
        if !isNull(tray)
            try
                let fullMsg = message
                if sub != ""
                    fullMsg = fullMsg + "\n" + sub
                end
                tray.showBalloon(title, fullMsg, timeout)
                return True
            catch err
            end
        end
        webview.notificationShow(title, message, sub, True, "", timeout)
        return True
    end

    # ── IPC: Desktop Notifications ───────────────────────────────────────────
    app.bridge.on("notifyPrayer", fn(payload)
        let prayer = payload["prayer"]
        let time = payload.get("time", "")
        let notifMsg = "حان الآن موعد أذان صلاة " + prayer
        if time != ""
            notifMsg = notifMsg + " (" + time + ")"
        end

        showNotification(
            "مواقيت الصلاة",
            notifMsg,
            "حي على الصلاة • حي على الفلاح",
            7
        )
        return True
    end)

    app.bridge.on("notifyMessage", fn(payload)
        let title = payload.get("title", "تذكير إسلامي")
        let message = payload.get("message", "")
        let sub = payload.get("sub", "")
        showNotification(title, message, sub, 6)
        return True
    end)

    app.bridge.on("testNotification", fn(payload)
        showNotification(
            "مواقيت الصلاة",
            "هذا إشعار تجريبي لمواقيت الصلاة",
            "لغة جزائر - تطبيق سطح المكتب",
            5
        )
        return True
    end)

    # ── IPC: Compact Mode & Window Pinning ───────────────────────────────────
    app.bridge.on("win_toggleCompactMode", fn(payload)
        let isCompact = payload.get("enable", False)
        if isCompact
            app.window.setMinimumSize(320, 150)
            app.window.setSize(340, 160)
            app.window.setAlwaysOnTop(True)
        else
            app.window.setAlwaysOnTop(False)
            app.window.setSize(1020, 630)
            app.window.setMinimumSize(820, 550)
            app.window.center()
        end
        return isCompact
    end)

    app.bridge.on("win_isCompactMode", fn(payload)
        let sz = app.window.getSize()
        return sz[0] < 500
    end)

    # ── IPC: System Tray Dynamic Tooltip ─────────────────────────────────────
    app.bridge.on("updateTrayTooltip", fn(payload)
        let tooltip = payload.get("tooltip", "")
        if tooltip != ""
            trayModule.updateTrayTooltip(tray, tooltip)
        end
        return True
    end)

    # ── IPC: Pre-Adhan, Iqama & Athkar Timed Notifications ────────────────────
    app.bridge.on("notifyPreAdhan", fn(payload)
        let prayer = payload.get("prayer", "")
        let minutes = payload.get("minutes", 10)
        let msg = "اقترب موعد صلاة " + prayer + " (باقي " + str(minutes) + " دقيقة)"
        showNotification(
            "تنبيه دخول الصلاة",
            msg,
            "حي على الصلاة • حان وقت الاستعداد والوضوء",
            6
        )
        return True
    end)

    app.bridge.on("notifyIqama", fn(payload)
        let prayer = payload.get("prayer", "")
        let msg = "حان الآن موعد إقامة صلاة " + prayer
        showNotification(
            "موعد إقامة الصلاة",
            msg,
            "أقيموا صفوفكم وتراصوا • تقبل الله منا ومنكم",
            6
        )
        return True
    end)

    app.bridge.on("notifyAthkarTime", fn(payload)
        let type = payload.get("type", "morning")
        let title = "أذكار الصباح"
        let msg = "أصبحنا وأصبح الملك لله — حان وقت قراءة أذكار الصباح المباركة"
        if type == "evening"
            title = "أذكار المساء"
            msg = "أمسينا وأمسى الملك لله — حان وقت قراءة أذكار المساء المباركة"
        end
        showNotification(
            title,
            msg,
            "ألا بذكر الله تطمئن القلوب",
            7
        )
        return True
    end)
end
