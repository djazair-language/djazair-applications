# main.dz - Advanced Todo App Backend

use webview
use sqlite
use json
use datetime as dt
use file

import "database.dz" as * 

class TodoApp
    init()
        self.db = new Database("./ms_todo.db")
        self.app = webview.createWindow({
            "title": "Microsoft To Do Clone Pro using Djazair Language", 
            "width": 1100, 
            "height": 750, 
            "resizable": True, 
            "debug": False
        })
        self.setupBridge()
    end

    setupBridge()
        # Tasks
        self.app.bridge.expose("getTasks", fn(args) return self.db.getTasks() end)
        self.app.bridge.expose("addTask", fn(args)
        if args.length() < 7 return False end
            let myDayDate = ""
            if args.length() >= 8 myDayDate = args[7] end
                return self.db.addTask(args[0], args[1], args[2], args[3], args[4], args[5], args[6], myDayDate)
            end)
            self.app.bridge.expose("updateTask", fn(args)
            if args.length() < 8 return False end
                return self.db.updateTask(int(args[0]), args[1], args[2], args[3], args[4], args[5], args[6], args[7])
            end)
            self.app.bridge.expose("updateTaskStatus", fn(args)
            if args.length() < 2 return False end
                return self.db.updateTaskStatus(int(args[0]), int(args[1]))
            end)
            self.app.bridge.expose("updateTaskCategory", fn(args)
            if args.length() < 2 return False end
                return self.db.updateTaskCategory(int(args[0]), args[1])
            end)
            self.app.bridge.expose("updateTaskMyDay", fn(args)
            if args.length() < 2 return False end
                return self.db.updateTaskMyDay(int(args[0]), args[1])
            end)
            self.app.bridge.expose("updateTaskFile", fn(args)
            if args.length() < 2 return False end
                return self.db.updateTaskFile(int(args[0]), args[1])
            end)
            self.app.bridge.expose("updateTaskOrder", fn(args)
            if args.length() < 2 return False end
                return self.db.updateTaskOrder(int(args[0]), int(args[1]))
            end)
            self.app.bridge.expose("deleteTask", fn(args)
            if args.length() < 1 return False end
                return self.db.deleteTask(int(args[0]))
            end)

            # Lists
            self.app.bridge.expose("getLists", fn(args) return self.db.getLists() end)
            self.app.bridge.expose("addList", fn(args) return self.db.addList(args[0], args[1], args[2]) end)
            self.app.bridge.expose("renameList", fn(args) return self.db.renameList(int(args[0]), args[1]) end)
            self.app.bridge.expose("updateListTheme", fn(args) return self.db.updateListTheme(int(args[0]), args[1], args[2]) end)
            self.app.bridge.expose("deleteList", fn(args) return self.db.deleteList(int(args[0]), args[1]) end)

            # Steps
            self.app.bridge.expose("getSteps", fn(args) return self.db.getSteps(int(args[0])) end)
            self.app.bridge.expose("addStep", fn(args) return self.db.addStep(int(args[0]), args[1]) end)
            self.app.bridge.expose("updateStepStatus", fn(args) return self.db.updateStepStatus(int(args[0]), int(args[1])) end)
            self.app.bridge.expose("deleteStep", fn(args) return self.db.deleteStep(int(args[0])) end)

            # System
            self.app.bridge.expose("notify", fn(args)
            webview.notificationShow(args[0], args[1], "", True, "", 5)
            return True
        end)

        self.app.bridge.expose("exportData", fn(args)
        let path = webview.showSaveFileDialog({
            "title": "Backup Data", 
            "filters": [{"name": "JSON Backup", "extensions": ["*.json"]}]
        })
        if path != ""
            let data = {
                "tasks": self.db.getTasks(), 
                "lists": self.db.getLists()
            }
            file.write(path, json.pretty(data))
            webview.showMessageBox({"title": "Success", "message": "Backup created successfully.", "type": "info"})
            return True
        end
        return False
    end)

    self.app.bridge.expose("importData", fn(args)
    let path = webview.showOpenFileDialog({
        "title": "Restore Backup", 
        "filters": [{"name": "JSON Backup", "extensions": ["*.json"]}]
    })
    if path != ""
        let text = file.read(path)
        let data = json.parse(text)
        if data != Null
            # Merge Lists
            if data["lists"] != Null
                for l in data["lists"]
                    let theme_color = if l["theme_color"] != Null ? l["theme_color"] else "#5C90D2"
                    let theme_bg = if l["theme_bg"] != Null ? l["theme_bg"] else ""
                    self.db.safeExecute("INSERT OR REPLACE INTO lists (id, name, theme_color, theme_bg, created_at) VALUES (?, ?, ?, ?, ?)", [l["id"], l["name"], theme_color, theme_bg, l["created_at"]])
                end
            end
            # Merge Tasks
            if data["tasks"] != Null
                for t in data["tasks"]
                    let r_type = if t["repeat_type"] != Null ? t["repeat_type"] else ""
                    let r_time = if t["reminder_time"] != Null ? t["reminder_time"] else ""
                    self.db.safeExecute("INSERT OR REPLACE INTO tasks (id, title, description, category, priority, due_date, status, order_index, repeat_type, reminder_time, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", 
                    [t["id"], t["title"], t["description"], t["category"], t["priority"], t["due_date"], t["status"], t["order_index"], r_type, r_time, t["created_at"]])
                end
            end
            webview.showMessageBox({"title": "Success", "message": "Data restored successfully.", "type": "info"})
            return True
        end
    end
    return False
end)
end

run()
self.app.window.navigate("ui.html")
self.app.onQuit(fn()
    self.db.close()
end)
self.app.run()
end
end

fn main()
    let app = new TodoApp()
    app.run()
end

main()
