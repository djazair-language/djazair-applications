use process
use path
use file

let rootDir = process.scriptDir()
let reqPath = "ui.html"
let fullPath = path.join(rootDir, reqPath)

print("rootDir: " + rootDir)
print("reqPath: " + reqPath)
print("fullPath: " + fullPath)
print("exists: " + str(file.exists(fullPath)))
print("stat: " + str(file.stat(fullPath)))
