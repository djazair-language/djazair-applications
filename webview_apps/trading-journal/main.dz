use webview
use process
use path
use file

import "core/database.dz" as db
import "core/journal.dz" as journal
import "core/media.dz" as media
import "core/analytics.dz" as analytics
import "core/settings.dz" as settings

fn main()
    print("Starting Trading Journal...")
    db.init()

    let app = webview.createWindow({
        "title": "Trading Journal - Professional Edition",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": True,
        "debug": True
    })

    let win = app.window
    win.navigate("ui/index.html")

    # ═══════════════════════════════════════════════════════════════
    # IPC BRIDGE CHANNELS
    # ═══════════════════════════════════════════════════════════════

    # --- Trades CRUD Channel ---
    app.bridge.on("get_trades", fn(filter)
        return journal.getTrades(filter)
    end)

    app.bridge.on("add_trade", fn(trade)
        return journal.addTrade(trade)
    end)

    app.bridge.on("update_trade", fn(trade)
        return journal.updateTrade(trade)
    end)

    app.bridge.on("delete_trade", fn(data)
        return journal.deleteTrade(data["id"])
    end)

    app.bridge.on("get_journal_stats", fn(payload)
        return journal.getJournalStats()
    end)

    app.bridge.on("get_tags", fn(payload)
        return journal.getTags()
    end)

    app.bridge.on("save_trade_note", fn(data)
        return journal.saveTradeNote(data["trade_id"], data["note"])
    end)

    # --- Media Channel ---
    app.bridge.on("upload_image", fn(data)
        return media.uploadImage(data["base64"])
    end)

    app.bridge.on("get_image_data", fn(data)
        return media.getImageData(data["path"])
    end)

    # --- Analytics Channel ---
    app.bridge.on("get_analytics", fn(params)
        return analytics.getAnalytics(params)
    end)

    app.bridge.on("get_daily_pnl", fn(params)
        return analytics.getDailyPnl(params)
    end)

    app.bridge.on("get_performance_by_symbol", fn(params)
        return analytics.getPerformanceBySymbol()
    end)

    app.bridge.on("get_performance_by_session", fn(params)
        return analytics.getPerformanceBySession()
    end)

    app.bridge.on("get_performance_by_day", fn(params)
        return analytics.getPerformanceByDay()
    end)

    # --- Settings & Data Export Channel ---
    app.bridge.on("get_settings", fn(payload)
        return settings.getSettings()
    end)

    app.bridge.on("save_settings", fn(data)
        return settings.saveSettings(data)
    end)

    app.bridge.on("export_data", fn(payload)
        return settings.exportData()
    end)

    # ═══════════════════════════════════════════════════════════════
    # APP EVENT LOOP
    # ═══════════════════════════════════════════════════════════════
    print("Trading Journal ready!")
    app.run()
    print("Shutting down Trading Journal...")
end

main()
