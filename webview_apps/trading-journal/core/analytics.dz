import "database.dz" as db
use json
use datetime

fn getAnalytics(params = {})
    let settings = db.getSettings()
    let balance = 10000
    if settings.has("account_balance")
        balance = num(settings["account_balance"])
    end

    let where = "WHERE status='closed'"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let total = _scalar("SELECT COUNT(*) FROM trades ${where}", filterParams)
    let pnl = _scalar("SELECT COALESCE(SUM(net_pnl), 0) FROM trades ${where}", filterParams)
    let wins = _scalar("SELECT COUNT(*) FROM trades ${where} AND net_pnl > 0", filterParams)
    let losses = _scalar("SELECT COUNT(*) FROM trades ${where} AND net_pnl <= 0", filterParams)
    let best = _scalar("SELECT COALESCE(MAX(net_pnl), 0) FROM trades ${where}", filterParams)
    let worst = _scalar("SELECT COALESCE(MIN(net_pnl), 0) FROM trades ${where}", filterParams)
    let avg = _scalar("SELECT COALESCE(AVG(net_pnl), 0) FROM trades ${where}", filterParams)
    let comm = _scalar("SELECT COALESCE(SUM(commission), 0) FROM trades ${where}", filterParams)
    let swap = _scalar("SELECT COALESCE(SUM(swap), 0) FROM trades ${where}", filterParams)
    let aWin = _scalar("SELECT COALESCE(AVG(net_pnl), 0) FROM trades ${where} AND net_pnl > 0", filterParams)
    let aLoss = _scalar("SELECT COALESCE(AVG(net_pnl), 0) FROM trades ${where} AND net_pnl <= 0", filterParams)
    let aPips = _scalar("SELECT COALESCE(AVG(pnl_pips), 0) FROM trades ${where}", filterParams)

    let winRate = 0
    if total > 0
        winRate = (wins * 100.0) / total
    end

    let profitFactor = 0
    if aLoss != 0
        profitFactor = abs(aWin / aLoss)
    end

    let expectancy = 0
    if total > 0
        expectancy = pnl / total
    end

    let maxConsecutiveWins = _getMaxConsecutive("win")
    let maxConsecutiveLosses = _getMaxConsecutive("loss")

    let longCount = _scalar("SELECT COUNT(*) FROM trades ${where} AND direction='buy'", filterParams)
    let shortCount = _scalar("SELECT COUNT(*) FROM trades ${where} AND direction='sell'", filterParams)

    let longWinRate = 0
    if longCount > 0
        let longWins = _scalar("SELECT COUNT(*) FROM trades ${where} AND direction='buy' AND net_pnl > 0", filterParams)
        longWinRate = (longWins * 100.0) / longCount
    end

    let shortWinRate = 0
    if shortCount > 0
        let shortWins = _scalar("SELECT COUNT(*) FROM trades ${where} AND direction='sell' AND net_pnl > 0", filterParams)
        shortWinRate = (shortWins * 100.0) / shortCount
    end

    return {
        "total_trades": total,
        "total_pnl": round(pnl, 2),
        "winning_trades": wins,
        "losing_trades": losses,
        "win_rate": round(winRate, 1),
        "profit_factor": round(profitFactor, 2),
        "expectancy": round(expectancy, 2),
        "best_trade": round(best, 2),
        "worst_trade": round(worst, 2),
        "avg_pnl": round(avg, 2),
        "avg_win": round(aWin, 2),
        "avg_loss": round(aLoss, 2),
        "avg_pips": round(aPips, 1),
        "total_commission": round(comm, 2),
        "total_swap": round(swap, 2),
        "max_consecutive_wins": maxConsecutiveWins,
        "max_consecutive_losses": maxConsecutiveLosses,
        "long_trades": longCount,
        "short_trades": shortCount,
        "long_win_rate": round(longWinRate, 1),
        "short_win_rate": round(shortWinRate, 1),
        "account_balance": balance,
        "equity": round(balance + pnl, 2)
    }
end

fn _scalar(sql, params = [])
    let row = db.queryRow(sql, params)
    if isNull(row) return 0 end
    if isNull(row[0]) return 0 end
    return row[0]
end

fn _getMaxConsecutive(type)
    let rows = db.queryAll(
        "SELECT net_pnl FROM trades WHERE status='closed' ORDER BY entry_time ASC", []
    )
    let maxCount = 0
    let currentCount = 0

    for row in rows
        let pnl = row[0]
        if type == "win" and pnl > 0
            currentCount = currentCount + 1
            if currentCount > maxCount
                maxCount = currentCount
            end
        elif type == "loss" and pnl <= 0
            currentCount = currentCount + 1
            if currentCount > maxCount
                maxCount = currentCount
            end
        else
            currentCount = 0
        end
    end
    return maxCount
end

fn getEquityCurve(params = {})
    let where = "WHERE status='closed'"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let settings = db.getSettings()
    let balance = 10000
    if settings.has("account_balance")
        balance = num(settings["account_balance"])
    end

    let rows = db.queryAll(
        "SELECT entry_time, net_pnl FROM trades ${where} ORDER BY entry_time ASC",
        filterParams
    )

    let curve = []
    let equity = balance
    curve.append({"date": "Start", "equity": balance})

    for row in rows
        equity = equity + row[1]
        curve.append({"date": row[0], "equity": round(equity, 2)})
    end
    return curve
end

fn getDailyPnl(params = {})
    let where = "WHERE status='closed'"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let rows = db.queryAll(
        "SELECT DATE(entry_time) as day, SUM(net_pnl), COUNT(*) FROM trades ${where} GROUP BY day ORDER BY day ASC",
        filterParams
    )

    let daily = []
    for row in rows
        daily.append({
            "date": row[0],
            "pnl": round(row[1], 2),
            "trades": row[2]
        })
    end
    return daily
end

fn getPerformanceBySymbol(params = {})
    let where = "WHERE status='closed'"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let rows = db.queryAll(
        "SELECT symbol, COUNT(*), SUM(net_pnl), AVG(net_pnl), " +
        "SUM(CASE WHEN net_pnl > 0 THEN 1 ELSE 0 END) as wins " +
        "FROM trades ${where} GROUP BY symbol ORDER BY SUM(net_pnl) DESC",
        filterParams
    )

    let symbols = []
    for row in rows
        let count = row[1]
        let wins = row[4]
        let winRate = 0
        if count > 0
            winRate = (wins * 100.0) / count
        end
        symbols.append({
            "symbol": row[0],
            "trades": count,
            "total_pnl": round(row[2], 2),
            "avg_pnl": round(row[3], 2),
            "win_rate": round(winRate, 1)
        })
    end
    return symbols
end

fn getPerformanceBySession(params = {})
    let where = "WHERE status='closed' AND session != ''"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let rows = db.queryAll(
        "SELECT session, COUNT(*), SUM(net_pnl), AVG(net_pnl), " +
        "SUM(CASE WHEN net_pnl > 0 THEN 1 ELSE 0 END) as wins " +
        "FROM trades ${where} GROUP BY session ORDER BY SUM(net_pnl) DESC",
        filterParams
    )

    let sessions = []
    for row in rows
        let count = row[1]
        let wins = row[4]
        let winRate = 0
        if count > 0
            winRate = (wins * 100.0) / count
        end
        sessions.append({
            "session": row[0],
            "trades": count,
            "total_pnl": round(row[2], 2),
            "avg_pnl": round(row[3], 2),
            "win_rate": round(winRate, 1)
        })
    end
    return sessions
end

fn getPerformanceByDay(params = {})
    let where = "WHERE status='closed'"
    let filterParams = []

    if params.has("date_from") and params["date_from"] != ""
        where = where + " AND entry_time >= ?"
        filterParams.append(params["date_from"])
    end

    if params.has("date_to") and params["date_to"] != ""
        where = where + " AND entry_time <= ?"
        filterParams.append(params["date_to"])
    end

    let rows = db.queryAll(
        "SELECT strftime('%w', entry_time) as day_num, COUNT(*), SUM(net_pnl), " +
        "SUM(CASE WHEN net_pnl > 0 THEN 1 ELSE 0 END) as wins " +
        "FROM trades ${where} GROUP BY day_num ORDER BY day_num ASC",
        filterParams
    )

    let dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let days = []
    for row in rows
        let dayIdx = int(row[0])
        let count = row[1]
        let wins = row[3]
        let winRate = 0
        if count > 0
            winRate = (wins * 100.0) / count
        end
        days.append({
            "day": dayNames[dayIdx],
            "trades": count,
            "total_pnl": round(row[2], 2),
            "win_rate": round(winRate, 1)
        })
    end
    return days
end
