use sqlite
use json
use datetime
use file
use dir
use path
use process

let _db = Null
let _dbPath = ""

fn init()
    let dataDir = path.join(process.scriptDir(), "data")
    try
        dir.createAll(dataDir)
    catch err
    end
    _dbPath = path.join(dataDir, "journal.db")
    _db = sqlite.connect(_dbPath)
    _db.execute("PRAGMA journal_mode=WAL")
    _db.execute("PRAGMA foreign_keys=ON")
    _createTables()
    print("Database initialized: ${_dbPath}")
end

fn _createTables()
    _db.execute("
        CREATE TABLE IF NOT EXISTS trades (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            symbol TEXT NOT NULL,
            direction TEXT NOT NULL,
            entry_price REAL NOT NULL,
            exit_price REAL,
            lot_size REAL NOT NULL DEFAULT 0.01,
            stop_loss REAL,
            take_profit REAL,
            entry_time TEXT NOT NULL,
            exit_time TEXT,
            pnl REAL DEFAULT 0,
            pnl_pips REAL DEFAULT 0,
            commission REAL DEFAULT 0,
            swap REAL DEFAULT 0,
            net_pnl REAL DEFAULT 0,
            status TEXT DEFAULT 'open',
            timeframe TEXT DEFAULT 'H1',
            strategy TEXT DEFAULT '',
            session TEXT DEFAULT '',
            tags TEXT DEFAULT '[]',
            notes TEXT DEFAULT '',
            screenshot TEXT DEFAULT '',
            emotions TEXT DEFAULT '',
            setup_quality TEXT DEFAULT '',
            market_condition TEXT DEFAULT '',
            confidence_level INTEGER DEFAULT 5,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
    ")

    _db.execute("
        CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
    ")

    _db.execute("
        CREATE TABLE IF NOT EXISTS tags (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT UNIQUE NOT NULL,
            color TEXT DEFAULT '#3B82F6'
        )
    ")

    _setDefaultSettings()
end

fn _setDefaultSettings()
    let defaults = {
        "account_balance": "10000",
        "risk_per_trade": "1",
        "currency": "USD",
        "timezone": "UTC",
        "default_lot_size": "0.01",
        "max_daily_loss": "3",
        "max_daily_trades": "5",
        "theme": "dark"
    }
    for key in defaults.keys()
        let row = queryRow("SELECT value FROM settings WHERE key = ?", [key])
        if isNull(row)
            _db.safeExecute("INSERT INTO settings (key, value) VALUES (?, ?)", [key, defaults[key]])
        end
    end
end

fn queryRow(sql, params = [])
    let rs = _db.safeQuery(sql, params)
    if isNull(rs) return Null end
    let row = rs.fetchRow()
    rs.close()
    return row
end

fn queryAll(sql, params = [])
    let rs = _db.safeQuery(sql, params)
    if isNull(rs) return [] end
    let results = []
    let row = rs.fetchRow()
    while !isNull(row)
        results.append(row)
        row = rs.fetchRow()
    end
    rs.close()
    return results
end

fn getSettings()
    let rows = queryAll("SELECT key, value FROM settings", [])
    let settings = {}
    for row in rows
        settings[row[0]] = row[1]
    end
    return settings
end

fn saveSettings(settings)
    for key in settings.keys()
        _db.safeExecute(
            "INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)",
            [key, settings[key]]
        )
    end
    return {"success": True}
end

fn getDB()
    return _db
end

fn close()
    if !isNull(_db)
        _db.close()
    end
end
