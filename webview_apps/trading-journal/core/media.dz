use file
use dir
use path
use process
use crypto
use datetime

fn _saveScreenshot(base64Data, prefix)
    try
        if base64Data == "" return "" end
        if base64Data.startsWith("data/images/") or base64Data.startsWith("data\\images\\")
            return base64Data
        end

        let b64 = base64Data
        if b64.contains("base64,")
            let parts = b64.split("base64,")
            if parts.length() > 1
                b64 = parts[1]
            end
        end

        b64 = b64.replace("\r", "").replace("\n", "").replace(" ", "")

        let timestamp = datetime.now().format("%Y%m%d_%H%M%S")
        let fileName = "img_" + str(prefix) + "_" + timestamp + ".jpg"

        let dataImagesDir = path.join(process.scriptDir(), "data", "images")
        try
            dir.createAll(dataImagesDir)
        catch e1
        end

        let fullImgPath = path.join(dataImagesDir, fileName)
        let relImgPath = path.join("data", "images", fileName)

        let decodedString = crypto.base64Decode(b64)
        if isNull(decodedString)
            let errPath = path.join(process.scriptDir(), "data", "error_log.txt")
            file.write(errPath, "base64Decode returned Null for " + fileName)
            return ""
        end

        let f = file.open(fullImgPath, "wb")
        if f.isOpen()
            f.write(decodedString)
            f.close()
        else
            let errPath = path.join(process.scriptDir(), "data", "error_log.txt")
            file.write(errPath, "Failed to open " + fullImgPath + " in wb mode")
            return ""
        end
        return relImgPath
    catch e
        let errPath = path.join(process.scriptDir(), "data", "error_log.txt")
        file.write(errPath, "Error in _saveScreenshot: " + str(e))
        return ""
    end
end

fn uploadImage(base64Data)
    try
        if base64Data == "" return {"success": False, "error": "No image data"} end
        let savedPath = _saveScreenshot(base64Data, "upload")
        if savedPath != ""
            return {"success": True, "path": savedPath}
        else
            return {"success": False, "error": "Failed to decode/save image"}
        end
    catch e
        file.write("data/error_log.txt", "Error in uploadImage: " + str(e))
        return {"success": False, "error": str(e)}
    end
end

fn getImageData(imgPath)
    try
        if isNull(imgPath) or imgPath == ""
            return {"success": False, "error": "Empty path"}
        end
        let fullPath = path.join(process.scriptDir(), imgPath)
        if !file.exists(fullPath)
            return {"success": False, "error": "File not found: " + fullPath}
        end
        let f = file.open(fullPath, "rb")
        if isNull(f) or !f.isOpen()
            return {"success": False, "error": "Failed to open file"}
        end
        let content = f.read()
        f.close()
        if isNull(content)
            return {"success": False, "error": "Failed to read content"}
        end
        let b64 = crypto.base64Encode(content)
        let mime = "image/jpeg"
        if imgPath.endsWith(".png")
            mime = "image/png"
        end
        return {"success": True, "dataUrl": "data:" + mime + ";base64," + b64}
    catch e
        return {"success": False, "error": str(e)}
    end
end
