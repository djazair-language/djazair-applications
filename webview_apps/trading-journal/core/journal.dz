import "database.dz" as db
import "media.dz" as media
use json
use datetime
use file
use path
use process

fn getTrades(filter = {})
    let where = "WHERE 1=1"
    let params = []

    if filter.has("symbol") and filter["symbol"] != ""
        where = where + " AND symbol = ?"
        params.append(filter["symbol"])
    end

    if filter.has("status") and filter["status"] != ""
        where = where + " AND status = ?"
        params.append(filter["status"])
    end

    if filter.has("direction") and filter["direction"] != ""
        where = where + " AND direction = ?"
        params.append(filter["direction"])
    end

    if filter.has("strategy") and filter["strategy"] != ""
        where = where + " AND strategy = ?"
        params.append(filter["strategy"])
    end

    if filter.has("date_from") and filter["date_from"] != ""
        where = where + " AND entry_time >= ?"
        params.append(filter["date_from"])
    end

    if filter.has("date_to") and filter["date_to"] != ""
        where = where + " AND entry_time <= ?"
        params.append(filter["date_to"] + " 23:59:59")
    end

    if filter.has("search") and filter["search"] != ""
        where = where + " AND (symbol LIKE ? OR notes LIKE ? OR tags LIKE ?)"
        let term = "%" + filter["search"] + "%"
        params.append(term)
        params.append(term)
        params.append(term)
    end

    let query = "SELECT * FROM trades ${where} ORDER BY entry_time DESC"
    return db.queryAll(query, params)
end

fn getTrade(id)
    let rows = db.queryAll("SELECT * FROM trades WHERE id = ?", [id])
    if rows.length() == 0
        return Null
    end
    return rows[0]
end

fn addTrade(trade)
    try
        let netPnl = trade["pnl"] - trade["commission"] + trade["swap"]

        db.getDB().safeExecute("
            INSERT INTO trades (
                symbol, direction, entry_price, exit_price, lot_size,
                stop_loss, take_profit, entry_time, exit_time,
                pnl, pnl_pips, commission, swap, net_pnl,
                status, timeframe, strategy, session, tags,
                notes, screenshot, emotions, setup_quality,
                market_condition, confidence_level
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ", [
            trade["symbol"], trade["direction"], trade["entry_price"],
            trade["exit_price"], trade["lot_size"], trade["stop_loss"],
            trade["take_profit"], trade["entry_time"], trade["exit_time"],
            trade["pnl"], trade["pnl_pips"], trade["commission"],
            trade["swap"], netPnl, trade["status"], trade["timeframe"],
            trade["strategy"], trade["session"], trade["tags"],
            trade["notes"], "", trade["emotions"],
            trade["setup_quality"], trade["market_condition"],
            trade["confidence_level"]
        ])

        let id = db.getDB().insertId()

        let screenshotPath = trade["screenshot"]
        if isString(screenshotPath) and screenshotPath != ""
            if screenshotPath.startsWith("data:image")
                screenshotPath = media._saveScreenshot(screenshotPath, id)
            end
            db.getDB().safeExecute("UPDATE trades SET screenshot=? WHERE id=?", [screenshotPath, id])
        end

        return {"success": True, "id": id}
    catch e
        file.write("data/error_log.txt", "Exception in addTrade: " + str(e))
        return {"success": False, "error": str(e)}
    end
end

fn updateTrade(trade)
    try
        let netPnl = trade["pnl"] - trade["commission"] + trade["swap"]
        let now = datetime.now().format("%Y-%m-%d %H:%M:%S")
        
        let savedPath = trade["screenshot"]
        if isString(savedPath) and savedPath != "" and savedPath.startsWith("data:image")
            savedPath = media._saveScreenshot(trade["screenshot"], trade["id"])
        end

        db.getDB().safeExecute("
            UPDATE trades SET
                symbol=?, direction=?, entry_price=?, exit_price=?,
                lot_size=?, stop_loss=?, take_profit=?, entry_time=?,
                exit_time=?, pnl=?, pnl_pips=?, commission=?, swap=?,
                net_pnl=?, status=?, timeframe=?, strategy=?, session=?,
                tags=?, notes=?, screenshot=?, emotions=?,
                setup_quality=?, market_condition=?, confidence_level=?,
                updated_at=?
            WHERE id=?
        ", [
            trade["symbol"], trade["direction"], trade["entry_price"],
            trade["exit_price"], trade["lot_size"], trade["stop_loss"],
            trade["take_profit"], trade["entry_time"], trade["exit_time"],
            trade["pnl"], trade["pnl_pips"], trade["commission"],
            trade["swap"], netPnl, trade["status"], trade["timeframe"],
            trade["strategy"], trade["session"], trade["tags"],
            trade["notes"], savedPath, trade["emotions"],
            trade["setup_quality"], trade["market_condition"],
            trade["confidence_level"], now, trade["id"]
        ])

        return {"success": True}
    catch e
        file.write("data/error_log.txt", "Exception in updateTrade: " + str(e))
        return {"success": False, "error": str(e)}
    end
end

fn deleteTrade(id)
    db.getDB().safeExecute("DELETE FROM trades WHERE id = ?", [id])
    return {"success": True}
end

fn getTags()
    let rows = db.queryAll("SELECT tags FROM trades WHERE tags IS NOT NULL AND tags != ''", [])
    let tagSet = {}
    for r in rows
        try
            let list = json.decode(r["tags"])
            for t in list
                tagSet[t] = True
            end
        catch e
        end
    end
    return tagSet.keys()
end

fn saveTradeNote(tradeId, note)
    db.getDB().safeExecute("UPDATE trades SET notes = ? WHERE id = ?", [note, tradeId])
    return {"success": True}
end

fn getJournalStats()
    let totalRow = db.queryRow("SELECT COUNT(*) as cnt FROM trades", [])
    let total = 0
    if !isNull(totalRow) and !isNull(totalRow["cnt"])
        total = totalRow["cnt"]
    end

    let winsRow = db.queryRow("SELECT COUNT(*) as cnt FROM trades WHERE net_pnl > 0", [])
    let wins = 0
    if !isNull(winsRow) and !isNull(winsRow["cnt"])
        wins = winsRow["cnt"]
    end

    let lossesRow = db.queryRow("SELECT COUNT(*) as cnt FROM trades WHERE net_pnl < 0", [])
    let losses = 0
    if !isNull(lossesRow) and !isNull(lossesRow["cnt"])
        losses = lossesRow["cnt"]
    end

    let openRow = db.queryRow("SELECT COUNT(*) as cnt FROM trades WHERE status = 'open'", [])
    let openCount = 0
    if !isNull(openRow) and !isNull(openRow["cnt"])
        openCount = openRow["cnt"]
    end

    let closedRow = db.queryRow("SELECT COUNT(*) as cnt FROM trades WHERE status = 'closed'", [])
    let closedCount = 0
    if !isNull(closedRow) and !isNull(closedRow["cnt"])
        closedCount = closedRow["cnt"]
    end

    let netPnlRow = db.queryRow("SELECT SUM(net_pnl) as total FROM trades", [])
    let netPnl = 0.0
    if !isNull(netPnlRow) and !isNull(netPnlRow["total"])
        netPnl = netPnlRow["total"]
    end

    let winRate = 0.0
    if closedCount > 0
        winRate = (wins * 100.0) / closedCount
    end

    return {
        "totalTrades": total,
        "winningTrades": wins,
        "losingTrades": losses,
        "openTrades": openCount,
        "closedTrades": closedCount,
        "netPnl": netPnl,
        "winRate": winRate
    }
end
