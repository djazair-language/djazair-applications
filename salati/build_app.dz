# =============================================================================
# Project:      Djazair Prayer Times Desktop Application
# File:         build_app.dz
# Description:  Standalone Executable Builder using dpack
# =============================================================================

use dpack
use file

print("====================================================")
print("  Bundling Salati (صلاتي) into Standalone EXE")
print("====================================================")

dpack.pack("main.dz", "salati.exe", {
    "extensions": ["webview", "net", "http"],
    "console": False,
    "assets": True,
    "portable": True
})

print("\n[SUCCESS] Standalone Executable created: salati.exe")
