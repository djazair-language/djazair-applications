# Calculation Methods
let CALCULATION_METHODS = [
    {"id": 19, "name": "وزارة الشؤون الدينية والأوقاف (الجزائر)", "fajrAngle": 18.0, "ishaAngle": 17.0},
    {"id": 4,  "name": "جامعة أم القرى - مكة المكرمة (Umm Al-Qura)", "fajrAngle": 18.5, "ishaInterval": 90},
    {"id": 3,  "name": "رابطة العالم الإسلامي (Muslim World League)", "fajrAngle": 18.0, "ishaAngle": 17.0},
    {"id": 5,  "name": "الهيئة المصرية العامة للمساحة (Egyptian General)", "fajrAngle": 19.5, "ishaAngle": 17.5},
    {"id": 13, "name": "رئاسة الشؤون الدينية التركية (Diyanet)", "fajrAngle": 18.0, "ishaAngle": 17.0},
    {"id": 1,  "name": "جامعة العلوم الإسلامية بكراتشي (Karachi)", "fajrAngle": 18.0, "ishaAngle": 18.0},
    {"id": 2,  "name": "الجمعية الإسلامية لأمريكا الشمالية (ISNA)", "fajrAngle": 15.0, "ishaAngle": 15.0}
]

fn getCountryTimezone(countryCode)
    for c in COUNTRIES
        if c["code"] == countryCode or c["name"] == countryCode
            if c.has("timezone")
                return c["timezone"]
            end
            return 1.0
        end
    end
    return 1.0
end

fn getCountryDefaultMethod(countryCode)
    for c in COUNTRIES
        if c["code"] == countryCode or c["name"] == countryCode
            if c.has("defaultMethod")
                return c["defaultMethod"]
            end
            return 19
        end
    end
    return 19
end

fn getCountriesList()
    let list = []
    for c in COUNTRIES
        list.append({
            "code": c["code"],
            "name": c["name"],
            "ar": c["ar"],
            "defaultMethod": c["defaultMethod"]
        })
    end
    return list
end

fn getCitiesForCountry(countryCode)
    for c in COUNTRIES
        if c["code"] == countryCode or c["name"] == countryCode
            return c["cities"]
        end
    end
    return []
end

fn findCity(countryCode, cityName)
    let cities = getCitiesForCountry(countryCode)
    for city in cities
        if city["name"] == cityName or city["ar"] == cityName
            return city
        end
    end
    return Null
end

# Finds best matching city by code or closest coordinates (lat, lng)
fn matchLocation(countryCode, cityName, lat = Null, lng = Null)
    let cities = getCitiesForCountry(countryCode)
    if cities.length() == 0
        return Null
    end

    # Try exact name match
    for city in cities
        if city["name"].lower() == cityName.lower() or city["ar"] == cityName
            return city
        end
    end

    # If lat and lng provided, find closest geographic city
    if !isNull(lat) and !isNull(lng)
        let bestCity = cities[0]
        let minDistanceSq = 999999.0

        for city in cities
            let dLat = city["lat"] - lat
            let dLng = city["lng"] - lng
            let distSq = (dLat * dLat) + (dLng * dLng)
            if distSq < minDistanceSq
                minDistanceSq = distSq
                bestCity = city
            end
        end
        return bestCity
    end

    return cities[0]
end

